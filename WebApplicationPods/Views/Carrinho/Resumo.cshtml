@model WebApplicationPods.Models.ResumoPedidoViewModel
@using WebApplicationPods.Models
@using System.Globalization
@using System.Text.RegularExpressions

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Resumo do Pedido";
    ViewData["HideStoreHeader"] = true;
    var loja = ViewBag.Loja as LojaConfig;

    string FormatarTelefone(string? telefone)
    {
        if (string.IsNullOrWhiteSpace(telefone)) return "";

        var d = Regex.Replace(telefone, @"\D+", "");

        if ((d.Length == 12 || d.Length == 13) && d.StartsWith("55"))
            d = d.Substring(2);

        if (d.Length == 11) return $"({d[..2]}) {d.Substring(2, 5)}-{d.Substring(7)}";
        if (d.Length == 10) return $"({d[..2]}) {d.Substring(2, 4)}-{d.Substring(6)}";
        if (d.Length == 9) return $"{d[..5]}-{d.Substring(5)}";
        if (d.Length == 8) return $"{d[..4]}-{d.Substring(4)}";

        return telefone;
    }

    int? TentarObterInt(object? obj, params string[] nomes)
    {
        if (obj == null) return null;

        var type = obj.GetType();
        foreach (var nome in nomes)
        {
            var prop = type.GetProperty(nome);
            if (prop == null) continue;

            var valor = prop.GetValue(obj);
            if (valor == null) continue;

            if (valor is int i) return i;
            if (int.TryParse(valor.ToString(), out var convertido)) return convertido;
        }

        return null;
    }

    decimal? TentarObterDecimal(object? obj, params string[] nomes)
    {
        if (obj == null) return null;

        var type = obj.GetType();
        foreach (var nome in nomes)
        {
            var prop = type.GetProperty(nome);
            if (prop == null) continue;

            var valor = prop.GetValue(obj);
            if (valor == null) continue;

            if (valor is decimal dec) return dec;
            if (valor is double dbl) return Convert.ToDecimal(dbl);
            if (valor is float flt) return Convert.ToDecimal(flt);

            if (decimal.TryParse(valor.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var convertidoInv))
                return convertidoInv;

            if (decimal.TryParse(valor.ToString(), out var convertido))
                return convertido;
        }

        return null;
    }

    string MontarDescricaoQuantidade(dynamic item)
    {
        var qtd = (int)(item?.Quantidade ?? 0);
        if (qtd <= 0) qtd = 1;

        var produto = item?.Produto;
        if (produto is ProdutoModel produtoModel && produtoModel.EhEmbalagemComposta)
        {
            var embalagem = qtd == 1
                ? produtoModel.EmbalagemVendaSingular
                : produtoModel.EmbalagemVendaPlural;

            return $"{qtd} {embalagem} com {produtoModel.UnidadesFisicasPorEmbalagem} unidades";
        }

        var unidadesPack = TentarObterInt(produto,
            "UnidadesFisicasPorEmbalagem",
            "UnidadesPorPack",
            "QuantidadePorPack",
            "QtdPorPack",
            "PodsPorPack",
            "Unidades",
            "QuantidadeUnidades");

        if (unidadesPack.HasValue && unidadesPack.Value > 1)
        {
            var packTxt = qtd == 1 ? "pack" : "packs";
            var unTxt = unidadesPack.Value == 1 ? "unidade" : "unidades";
            return $"{qtd} {packTxt} c/ {unidadesPack.Value} {unTxt}";
        }

        return qtd == 1 ? "1 un." : $"{qtd} un.";
    }

    decimal ObterPrecoUnitario(dynamic? item)
    {
        decimal? preco =
            TentarObterDecimal(item, "PrecoUnitario", "ValorUnitario", "Preco") ??
            TentarObterDecimal(item?.Produto, "PrecoPromocional", "PrecoPor", "PrecoVenda", "Preco");

        return preco ?? 0;
    }

    decimal ObterSubtotalItem(dynamic? item)
    {
        var qtd = (int)(item?.Quantidade ?? 0);
        if (qtd <= 0) qtd = 1;

        var subtotalDireto = TentarObterDecimal(item, "Subtotal", "ValorTotal", "Total");

        if (subtotalDireto.HasValue && subtotalDireto.Value > 0)
            return subtotalDireto.Value;

        return ObterPrecoUnitario(item) * qtd;
    }

    var telefoneFormatado = FormatarTelefone(Model?.Cliente?.Telefone);
    var subtotalPedido = Model?.Carrinho?.Total ?? 0;
    var taxaEntregaInicial = Model?.RetiradaNoLocal == true ? 0 : 5;
    var quantidadeProdutos = Model?.Carrinho?.Itens?.Count() ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/resumo-componente.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
}

<div class="checkout-summary-page">
    <header class="checkout-appbar">
        <a asp-action="Index" class="checkout-appbar-back" aria-label="Voltar para o carrinho">
            <i class="bi bi-arrow-left"></i>
        </a>

        <div class="checkout-appbar-title">
            <strong>Resumo do pedido</strong>
        </div>
    </header>

    <div class="checkout-summary-intro">
        <span>Finalização</span>
        <h1>Resumo do pedido</h1>
        <p>Confira seus dados e finalize com segurança.</p>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="checkout-alert is-success">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Sucesso"]</span>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="checkout-alert is-error">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["Erro"]</span>
        </div>
    }

    @if (Model?.Carrinho?.Itens?.Any() == true)
    {
        <form asp-action="Finalizar" method="post" id="formFinalizar">
            @Html.AntiForgeryToken()

            <div class="checkout-summary-layout">
                <main class="checkout-flow">
                    <section class="checkout-panel">
                        <div class="checkout-panel-head">
                            <div class="checkout-panel-icon">
                                <i class="bi bi-person-badge"></i>
                            </div>

                            <div>
                                <span>Cliente</span>
                                <h2>Dados do cliente</h2>
                            </div>
                        </div>

                        <div class="checkout-panel-body">
                            <div class="checkout-info-grid">
                                <div class="checkout-info-box">
                                    <span>Nome</span>
                                    <strong title="@(Model?.Cliente?.Nome ?? string.Empty)">
                                        @(Model?.Cliente?.Nome ?? string.Empty)
                                    </strong>
                                </div>

                                <div class="checkout-info-box">
                                    <span>Telefone</span>
                                    <strong id="telefoneClienteTopo">@telefoneFormatado</strong>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="checkout-panel">
                        <div class="checkout-panel-head">
                            <div class="checkout-panel-icon">
                                <i class="bi bi-truck"></i>
                            </div>

                            <div>
                                <span>Entrega</span>
                                <h2>Como deseja receber?</h2>
                            </div>

                            <button type="button" class="checkout-mini-btn" data-bs-toggle="modal" data-bs-target="#enderecoModal">
                                <i class="bi bi-plus-lg"></i>
                                Novo endereço
                            </button>
                        </div>

                        <div class="checkout-panel-body">
                            <label class="checkout-switch">
                                <input asp-for="RetiradaNoLocal" type="checkbox" id="retiradaLocal">
                                <span></span>

                                <div>
                                    <strong>Retirar no local</strong>
                                    <small>Você busca seu pedido na loja.</small>
                                </div>
                            </label>

                            <div id="pickupBox" class="checkout-pickup @((Model?.RetiradaNoLocal == true) ? "" : "d-none")">
                                <div>
                                    <strong><i class="bi bi-shop"></i> @(loja?.Nome ?? "Retirada na loja")</strong>
                                    <span>@(loja?.EnderecoTexto ?? "Endereço da loja não configurado.")</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(loja?.MapsUrl))
                                {
                                    <a href="@loja.MapsUrl" target="_blank" rel="noopener" class="checkout-mini-btn">
                                        <i class="bi bi-geo-alt"></i>
                                        Abrir mapa
                                    </a>
                                }
                            </div>

                            <div id="containerEntrega" class="@((Model?.RetiradaNoLocal == true) ? "d-none" : "")">
                                <div class="checkout-address-select">
                                    <div class="checkout-field">
                                        <label>Endereço de entrega</label>

                                        <select asp-for="EnderecoSelecionadoId" id="enderecoSelect">
                                            <option value="">Selecione...</option>

                                            @foreach (var e in Model?.EnderecosDisponiveis ?? Enumerable.Empty<WebApplicationPods.Models.EnderecoModel>())
                                            {
                                                <option value="@e.Id"
                                                        data-logradouro="@e.Logradouro"
                                                        data-numero="@e.Numero"
                                                        data-complemento="@e.Complemento"
                                                        data-bairro="@e.Bairro"
                                                        data-cidade="@e.Cidade"
                                                        data-estado="@e.Estado"
                                                        data-cep="@e.CEP"
                                                        data-principal="@(e.Principal ? "true" : "false")">
                                                    @e.Logradouro, @e.Numero - @e.Bairro
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <button type="button"
                                            class="checkout-icon-btn"
                                            id="btnEditarEndereco"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editarEnderecoModal"
                                            disabled
                                            aria-label="Editar endereço">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <button type="button"
                                            class="checkout-icon-btn is-danger"
                                            id="btnExcluirEndereco"
                                            data-bs-toggle="modal"
                                            data-bs-target="#excluirEnderecoModal"
                                            disabled
                                            aria-label="Excluir endereço">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <div id="enderecoDetalhes" class="checkout-address-card @(Model?.EnderecoEntrega == null ? "empty" : "")">
                                    @if (Model?.EnderecoEntrega != null)
                                    {
                                        <div class="checkout-address-top">
                                            <strong>
                                                <i class="bi bi-house-check"></i>
                                                Endereço selecionado

                                                @if (Model.EnderecoEntrega.Principal)
                                                {
                                                    <span>Principal</span>
                                                }
                                            </strong>

                                            <small>CEP: @Model.EnderecoEntrega.CEP</small>
                                        </div>

                                        <div class="checkout-address-lines">
                                            <div>@Model.EnderecoEntrega.Logradouro, @Model.EnderecoEntrega.Numero</div>

                                            @if (!string.IsNullOrEmpty(Model.EnderecoEntrega.Complemento))
                                            {
                                                <div>@Model.EnderecoEntrega.Complemento</div>
                                            }

                                            <div>@Model.EnderecoEntrega.Bairro - @Model.EnderecoEntrega.Cidade/@Model.EnderecoEntrega.Estado</div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="checkout-empty-inline">
                                            <i class="bi bi-house-x"></i>
                                            <span>Nenhum endereço selecionado</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="checkout-panel">
                        <div class="checkout-panel-head">
                            <div class="checkout-panel-icon">
                                <i class="bi bi-chat-square-text"></i>
                            </div>

                            <div>
                                <span>Observações</span>
                                <h2>Algum detalhe do pedido?</h2>
                            </div>
                        </div>

                        <div class="checkout-panel-body">
                            <textarea asp-for="Observacoes"
                                      class="checkout-textarea"
                                      rows="3"
                                      maxlength="200"
                                      placeholder="Ex.: trocar sabor, aviso, horário..."></textarea>

                            <div class="checkout-helper">Máx. 200 caracteres</div>
                        </div>
                    </section>

                    <section class="checkout-panel">
                        <div class="checkout-panel-head">
                            <div class="checkout-panel-icon">
                                <i class="bi bi-credit-card"></i>
                            </div>

                            <div>
                                <span>Pagamento</span>
                                <h2>Escolha como deseja pagar</h2>
                            </div>
                        </div>

                        <div class="checkout-panel-body">
                            <div class="checkout-payments-grid">
                                <div>
                                    <input type="radio" class="btn-check" id="pay-money" asp-for="MetodoPagamento" value="Dinheiro" />
                                    <label class="checkout-payment-option" for="pay-money">
                                        <i class="bi bi-cash-coin"></i>
                                        <span>Dinheiro</span>
                                    </label>
                                </div>

                                <div>
                                    <input type="radio" class="btn-check" id="pay-pix" asp-for="MetodoPagamento" value="Pix" />
                                    <label class="checkout-payment-option" for="pay-pix">
                                        <i class="bi bi-qr-code"></i>
                                        <span>Pix</span>
                                    </label>
                                </div>

                                <div>
                                    <input type="radio" class="btn-check" id="pay-card-credit" asp-for="MetodoPagamento" value="Cartão de Crédito" />
                                    <label class="checkout-payment-option" for="pay-card-credit">
                                        <i class="bi bi-credit-card"></i>
                                        <span>Cartão Crédito</span>
                                    </label>
                                </div>

                                <div>
                                    <input type="radio" class="btn-check" id="pay-card-debit" asp-for="MetodoPagamento" value="Cartão de Débito" />
                                    <label class="checkout-payment-option" for="pay-card-debit">
                                        <i class="bi bi-credit-card-2-front"></i>
                                        <span>Cartão Débito</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </section>
                </main>

                <aside class="checkout-order">
                    <section class="checkout-order-card checkout-order-card-refined">
                        <div class="checkout-order-head">
                            <div class="checkout-order-title-wrap">
                                <div class="checkout-order-title-icon">
                                    <i class="bi bi-bag-check"></i>
                                </div>

                                <div>
                                    <span>Resumo</span>
                                    <h2>Seu pedido</h2>
                                </div>
                            </div>

                            <strong>@quantidadeProdutos item(ns)</strong>
                        </div>

                        <div class="checkout-order-items">
                            @foreach (var item in Model.Carrinho.Itens)
                            {
                                var produto = item.Produto;
                                var nome = produto?.Nome ?? "Produto";
                                var img = !string.IsNullOrWhiteSpace(produto?.ImagemUrl)
                                ? Url.Content(produto.ImagemUrl)
                                : Url.Content("~/images/placeholder-80.png");

                                var subtotalItem = ObterSubtotalItem(item);
                                var descricaoQuantidade = MontarDescricaoQuantidade(item);

                                <article class="checkout-order-item">
                                    <div class="checkout-order-img">
                                        <img src="@img" alt="@nome" />
                                        <span>@item.Quantidade</span>
                                    </div>

                                    <div class="checkout-order-info">
                                        <strong>@nome</strong>

                                        <div>
                                            <span>@descricaoQuantidade</span>

                                            @if (!string.IsNullOrWhiteSpace(item.Sabor))
                                            {
                                                <span> • @item.Sabor</span>
                                            }
                                        </div>
                                    </div>

                                    <strong class="checkout-order-price">@subtotalItem.ToString("C")</strong>
                                </article>
                            }
                        </div>

                        <div class="checkout-total-lines">
                            <div>
                                <span>Subtotal</span>
                                <strong>@subtotalPedido.ToString("C")</strong>
                            </div>

                            <div>
                                <span>Entrega</span>
                                <strong id="taxaEntregaLabel">@((Model?.RetiradaNoLocal == true) ? "Grátis" : "R$ 5,00")</strong>
                            </div>
                        </div>

                        <div class="checkout-total-final">
                            <span>Total</span>
                            <strong id="totalGeralLabel">@((subtotalPedido + taxaEntregaInicial).ToString("C"))</strong>
                        </div>

                        <div class="checkout-delivery-chip">
                            <i class="bi bi-truck"></i>
                            <span id="tipoEntregaLabel">@((Model?.RetiradaNoLocal == true) ? "Retirada no local" : "Entrega no endereço")</span>
                        </div>

                        <button type="submit" class="checkout-finish-btn">
                            <i class="bi bi-lock"></i>
                            Finalizar pedido
                        </button>
                    </section>
                </aside>
            </div>
        </form>
    }
    else
    {
        <section class="checkout-empty">
            <div class="checkout-empty-icon">
                <i class="bi bi-cart-x"></i>
            </div>

            <h2>Seu carrinho está vazio</h2>
            <p>Adicione produtos ao carrinho para continuar.</p>

            <a asp-action="Index" class="checkout-finish-btn">
                Ver carrinho
            </a>
        </section>
    }
</div>

<div class="modal fade" id="enderecoModal" tabindex="-1" aria-hidden="true" aria-labelledby="enderecoTitle" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal">
            <div class="modal-header">
                <h5 id="enderecoTitle" class="modal-title"><i class="bi bi-geo-alt me-2"></i>Novo endereço</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <form asp-action="AdicionarEndereco" method="post" id="formEnderecoModal">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClienteId" value="@(Model?.Cliente?.Id ?? 0)" />

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">CEP</label>
                            <input class="form-control" name="EnderecoNovo.CEP" data-cep inputmode="numeric" autocomplete="postal-code" placeholder="00000-000" />
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <button type="button" id="buscarCepBtn" class="btn btn-outline-secondary w-100">Buscar</button>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Logradouro</label>
                            <input class="form-control" name="EnderecoNovo.Logradouro" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Número</label>
                            <input class="form-control" name="EnderecoNovo.Numero" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Complemento</label>
                            <input class="form-control" name="EnderecoNovo.Complemento" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Bairro</label>
                            <input class="form-control" name="EnderecoNovo.Bairro" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Cidade</label>
                            <input class="form-control" name="EnderecoNovo.Cidade" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">UF</label>
                            <input class="form-control text-uppercase" name="EnderecoNovo.Estado" maxlength="2" />
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="EnderecoNovo.Principal" id="novo_Principal" />
                                <label class="form-check-label" for="novo_Principal">Definir como principal</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar endereço</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editarEnderecoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Editar endereço</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <form id="formEditarEndereco" asp-action="AtualizarEndereco" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="edit_Id" name="Id" />
                <input type="hidden" name="ClienteId" value="@(Model?.Cliente?.Id ?? 0)" />

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">CEP</label>
                            <div class="input-group">
                                <input id="edit_CEP" name="CEP" class="form-control" data-cep placeholder="00000-000" inputmode="numeric" />
                                <button class="btn btn-outline-secondary" type="button" id="buscarCepBtnEditar">Buscar</button>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Número</label>
                            <input id="edit_Numero" name="Numero" class="form-control" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Logradouro</label>
                            <input id="edit_Logradouro" name="Logradouro" class="form-control" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Complemento</label>
                            <input id="edit_Complemento" name="Complemento" class="form-control" />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Bairro</label>
                            <input id="edit_Bairro" name="Bairro" class="form-control" />
                        </div>

                        <div class="col-md-5">
                            <label class="form-label">Cidade</label>
                            <input id="edit_Cidade" name="Cidade" class="form-control" />
                        </div>

                        <div class="col-md-2">
                            <label class="form-label">UF</label>
                            <input id="edit_Estado" name="Estado" class="form-control" maxlength="2" />
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="edit_Principal" name="Principal" />
                                <label for="edit_Principal" class="form-check-label">Definir como principal</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

@if (Model?.PrecisaConfirmar == true)
{
    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="confirmTitle" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content confirm-modal">
                <div class="modal-header">
                    <h5 id="confirmTitle" class="modal-title"><i class="bi bi-shield-check me-2"></i>Confirme seus dados</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>

                <div class="modal-body">
                    <div class="confirm-line mb-3">
                        <div class="confirm-ico"><i class="bi bi-person"></i></div>
                        <div>
                            <small class="text-muted d-block">Eu sou</small>
                            <div class="fw-semibold">@Model?.Cliente?.Nome</div>
                        </div>
                    </div>

                    <div class="confirm-line">
                        <div class="confirm-ico"><i class="bi bi-phone"></i></div>
                        <div>
                            <small class="text-muted d-block">Meu telefone é</small>
                            <div id="telefoneResumo" class="fw-semibold">@telefoneFormatado</div>
                        </div>
                    </div>

                    <div class="mt-3 d-grid gap-2">
                        <button type="button" id="btnConfirmaModal" class="btn btn-primary btn-confirm">Confirmar</button>

                        <a class="btn btn-outline-primary btn-confirm" href="@Url.Action("Editar", "Auth", new { returnUrl = Url.Action("Resumo", "Carrinho") })">
                            Editar informações
                        </a>

                        <form asp-controller="Auth" asp-action="TrocarUsuario" method="post" class="text-center">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-link small p-0">Não é você? Entrar com outro número</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="modal fade" id="excluirEnderecoModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content delete-address-modal">
            <div class="modal-header delete-modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2">
                    <i class="bi bi-trash"></i>
                    <span>Excluir endereço</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>

            <form asp-action="ExcluirEndereco" method="post" id="formExcluirEndereco" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ClienteId" value="@(Model?.Cliente?.Id ?? 0)" />
                <input type="hidden" id="del_Id" name="id" />

                <div class="modal-body delete-modal-body">
                    <p class="delete-modal-text">Tem certeza que deseja excluir este endereço?</p>
                    <div class="delete-address-preview" id="del_preview"></div>
                    <div class="delete-warning-note">Se este endereço for o principal, outro será definido automaticamente.</div>
                </div>

                <div class="modal-footer delete-modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-delete-cancel" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger btn-delete-confirm">Excluir</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function formatarTelefoneBR(valor) {
            let d = (valor || '').replace(/\D+/g, '');

            if ((d.length === 12 || d.length === 13) && d.startsWith('55')) {
                d = d.slice(2);
            }

            if (d.length === 11) return `(${d.slice(0, 2)}) ${d.slice(2, 7)}-${d.slice(7)}`;
            if (d.length === 10) return `(${d.slice(0, 2)}) ${d.slice(2, 6)}-${d.slice(6)}`;
            if (d.length === 9) return `${d.slice(0, 5)}-${d.slice(5)}`;
            if (d.length === 8) return `${d.slice(0, 4)}-${d.slice(4)}`;

            return valor || '';
        }

        (function () {
            const telTopo = document.getElementById('telefoneClienteTopo');
            const telResumo = document.getElementById('telefoneResumo');

            if (telTopo) telTopo.textContent = formatarTelefoneBR(telTopo.textContent);
            if (telResumo) telResumo.textContent = formatarTelefoneBR(telResumo.textContent);
        })();
    </script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function aplicarMascaraCEP(input) {
                input.addEventListener('input', function (e) {
                    let value = e.target.value.replace(/\D/g, '');

                    if (value.length > 5) {
                        value = value.substring(0, 5) + '-' + value.substring(5, 8);
                    } else if (value.length > 0) {
                        value = value.substring(0, 5);
                    }

                    e.target.value = value;

                    const cepRegex = /^\d{5}-\d{3}$/;

                    if (cepRegex.test(value)) {
                        e.target.classList.remove('is-invalid');
                        e.target.classList.add('is-valid');
                    } else {
                        e.target.classList.remove('is-valid');
                    }
                });
            }

            const onlyDigits = s => (s || '').replace(/\D+/g, '');
            const VIACEP = cep => `https://viacep.com.br/ws/${cep}/json/`;

            async function viaCEP(raw) {
                const d = onlyDigits(raw);

                if (d.length !== 8) {
                    alert('CEP deve ter 8 dígitos');
                    return null;
                }

                try {
                    const r = await fetch(VIACEP(d), { cache: 'no-store' });
                    if (!r.ok) return null;
                    const j = await r.json();
                    return j?.erro ? null : j;
                } catch {
                    alert('Erro ao buscar CEP');
                    return null;
                }
            }

            function clearValidation(form) {
                if (!form) return;
                form.querySelectorAll('.is-invalid, .is-valid').forEach(e => e.classList.remove('is-invalid', 'is-valid'));
            }

            function hardResetForm(form) {
                if (!form) return;
                form.reset();
                clearValidation(form);

                form.querySelectorAll('input[type=text],input[type=tel],input[type=email],input[type=number],textarea')
                    .forEach(i => { if (i.type !== 'checkbox' && i.type !== 'radio') i.value = ''; });

                form.querySelectorAll('input[type=checkbox]').forEach(c => c.checked = false);
            }

            function bindCepLookup(form, buscarBtnId) {
                if (!form) return;

                const cepInput = form.querySelector('[data-cep]');
                if (!cepInput) return;

                aplicarMascaraCEP(cepInput);

                async function doLookup() {
                    const cepValue = cepInput.value;
                    const cepRegex = /^\d{5}-\d{3}$/;

                    if (!cepRegex.test(cepValue)) {
                        alert('Por favor, digite um CEP válido no formato 00000-000');
                        cepInput.focus();
                        return;
                    }

                    const data = await viaCEP(cepValue);

                    if (!data) {
                        alert('CEP não encontrado ou inválido');
                        return;
                    }

                    const preencherCampo = (name, value) => {
                        const selector = `[name="EnderecoNovo.${name}"], [name="${name}"]`;
                        const campo = form.querySelector(selector);

                        if (campo && !campo.value) {
                            campo.value = value || '';
                            campo.classList.add('is-valid');
                        }
                    };

                    preencherCampo('Logradouro', data.logradouro);
                    preencherCampo('Bairro', data.bairro);
                    preencherCampo('Cidade', data.localidade);
                    preencherCampo('Estado', (data.uf || '').toUpperCase());

                    const numeroInput = form.querySelector('[name="EnderecoNovo.Numero"], [name="Numero"]');
                    if (numeroInput) numeroInput.focus();
                }

                cepInput.addEventListener('blur', doLookup);
                document.getElementById(buscarBtnId)?.addEventListener('click', doLookup);
            }

            const modalNovo = document.getElementById('enderecoModal');
            const formNovo = document.getElementById('formEnderecoModal');
            const modalEdit = document.getElementById('editarEnderecoModal');
            const formEdit = document.getElementById('formEditarEndereco');
            const selectEnd = document.getElementById('enderecoSelect');
            const btnEdit = document.getElementById('btnEditarEndereco');
            const btnExcluir = document.getElementById('btnExcluirEndereco');
            const detalhes = document.getElementById('enderecoDetalhes');

            bindCepLookup(formNovo, 'buscarCepBtn');
            bindCepLookup(formEdit, 'buscarCepBtnEditar');

            modalNovo?.addEventListener('show.bs.modal', () => hardResetForm(formNovo));
            modalNovo?.addEventListener('hidden.bs.modal', () => hardResetForm(formNovo));

            modalEdit?.addEventListener('show.bs.modal', () => {
                if (!selectEnd || !selectEnd.value) return;

                const opt = selectEnd.selectedOptions?.[0];
                if (!opt) return;

                document.getElementById('edit_Id').value = opt.value;
                document.getElementById('edit_Logradouro').value = opt.getAttribute('data-logradouro') || '';
                document.getElementById('edit_Numero').value = opt.getAttribute('data-numero') || '';
                document.getElementById('edit_Complemento').value = opt.getAttribute('data-complemento') || '';
                document.getElementById('edit_Bairro').value = opt.getAttribute('data-bairro') || '';
                document.getElementById('edit_Cidade').value = opt.getAttribute('data-cidade') || '';
                document.getElementById('edit_Estado').value = (opt.getAttribute('data-estado') || '').toUpperCase();
                document.getElementById('edit_CEP').value = opt.getAttribute('data-cep') || '';
                document.getElementById('edit_Principal').checked = opt.getAttribute('data-principal') === 'true';

                clearValidation(formEdit);
            });

            modalEdit?.addEventListener('hidden.bs.modal', () => clearValidation(formEdit));

            function toggleEditBtn() {
                if (btnEdit) btnEdit.disabled = !(selectEnd && selectEnd.value);
            }

            function toggleDeleteBtn() {
                if (btnExcluir) btnExcluir.disabled = !(selectEnd && selectEnd.value);
            }

            selectEnd?.addEventListener('change', function () {
                toggleEditBtn();
                toggleDeleteBtn();

                const opt = this.selectedOptions?.[0];
                if (!opt || !detalhes) return;

                const log = opt.getAttribute('data-logradouro') || '';
                const num = opt.getAttribute('data-numero') || '';
                const comp = opt.getAttribute('data-complemento') || '';
                const bai = opt.getAttribute('data-bairro') || '';
                const cid = opt.getAttribute('data-cidade') || '';
                const uf = opt.getAttribute('data-estado') || '';
                const cep = opt.getAttribute('data-cep') || '';
                const principal = opt.getAttribute('data-principal') === 'true';

                detalhes.innerHTML = `
                    <div class="checkout-address-top">
                        <strong>
                            <i class="bi bi-house-check"></i>
                            Endereço selecionado
                            ${principal ? '<span>Principal</span>' : ''}
                        </strong>
                        <small>CEP: ${cep}</small>
                    </div>
                    <div class="checkout-address-lines">
                        <div>${log}${log && num ? ', ' : ''}${num}</div>
                        ${comp ? `<div>${comp}</div>` : ''}
                        <div>${bai} - ${cid}/${uf}</div>
                    </div>`;

                detalhes.classList.remove('empty');
            });

            toggleEditBtn();
            toggleDeleteBtn();

            document.getElementById('excluirEnderecoModal')?.addEventListener('show.bs.modal', () => {
                const opt = selectEnd?.selectedOptions?.[0];
                if (!opt) return;

                const id = opt.value;
                const log = opt.getAttribute('data-logradouro') || '';
                const num = opt.getAttribute('data-numero') || '';
                const comp = opt.getAttribute('data-complemento') || '';
                const bai = opt.getAttribute('data-bairro') || '';
                const cid = opt.getAttribute('data-cidade') || '';
                const uf = (opt.getAttribute('data-estado') || '').toUpperCase();
                const cep = opt.getAttribute('data-cep') || '';
                const principal = opt.getAttribute('data-principal') === 'true';

                const delId = document.getElementById('del_Id');
                if (delId) delId.value = id;

                const prev = document.getElementById('del_preview');

                if (prev) {
                    prev.innerHTML = `
                        <div class="fw-semibold">${log}${log && num ? ', ' + num : ''}</div>
                        ${comp ? `<div>${comp}</div>` : ''}
                        <div>${bai} - ${cid}/${uf}</div>
                        <div>CEP: ${cep}</div>
                        ${principal ? `<span class="badge rounded-pill bg-danger-subtle text-danger border mt-2">Principal</span>` : ''}`;
                }
            });

            document.getElementById('formExcluirEndereco')?.addEventListener('submit', function () {
                const submitBtn = this.querySelector('button[type="submit"]');

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerText = 'Excluindo...';
                }
            });

            const validarFormEndereco = (form) => {
                let isValid = true;
                const cepField = form.querySelector('[data-cep]');
                const estadoField = form.querySelector('[name$="Estado"]');

                if (cepField) {
                    const cepRegex = /^\d{5}-\d{3}$/;

                    if (!cepRegex.test(cepField.value)) {
                        isValid = false;
                        cepField.classList.add('is-invalid');
                    }
                }

                if (estadoField) {
                    const estadoValue = (estadoField.value || '').trim().toUpperCase();

                    if (estadoValue.length !== 2) {
                        isValid = false;
                        estadoField.classList.add('is-invalid');
                    }
                }

                return isValid;
            };

            [formNovo, formEdit].forEach(form => {
                if (!form) return;

                form.addEventListener('submit', function (e) {
                    if (!validarFormEndereco(form)) {
                        e.preventDefault();
                        alert('Por favor, preencha os dados do endereço corretamente.');
                        return;
                    }

                    const btn = this.querySelector('button[type="submit"]');

                    if (btn) {
                        btn.disabled = true;
                        btn.innerText = 'Salvando...';
                    }
                });
            });

            const retiradaChk = document.getElementById('retiradaLocal');
            const containerEntrega = document.getElementById('containerEntrega');
            const taxaEntregaLabel = document.getElementById('taxaEntregaLabel');
            const totalGeralLabel = document.getElementById('totalGeralLabel');
            const tipoEntregaLabel = document.getElementById('tipoEntregaLabel');
            const pickupBox = document.getElementById('pickupBox');
            const subtotal = parseFloat('@((Model?.Carrinho?.Total ?? 0m).ToString(CultureInfo.InvariantCulture))');
            const taxaPadrao = 5;

            function atualizarTotais() {
                const retirada = !!retiradaChk?.checked;
                const taxa = retirada ? 0 : taxaPadrao;

                if (taxaEntregaLabel) {
                    taxaEntregaLabel.textContent = taxa === 0
                        ? 'Grátis'
                        : taxa.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                }

                if (tipoEntregaLabel) {
                    tipoEntregaLabel.textContent = retirada ? 'Retirada' : 'Entrega';
                }

                if (totalGeralLabel) {
                    totalGeralLabel.textContent = (subtotal + taxa).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
                }

                containerEntrega?.classList.toggle('d-none', retirada);
                pickupBox?.classList.toggle('d-none', !retirada);
            }

            retiradaChk?.addEventListener('change', atualizarTotais);
            atualizarTotais();

            const confirmModalEl = document.getElementById('confirmModal');

            if (confirmModalEl) {
                const confirmModal = new bootstrap.Modal(confirmModalEl, { backdrop: 'static', keyboard: false });
                confirmModal.show();

                document.getElementById('btnConfirmaModal')?.addEventListener('click', async () => {
                    try {
                        await fetch('@Url.Action("ConfirmarDados", "Carrinho")', {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                            }
                        });
                    } catch { }

                    confirmModal.hide();
                });
            }

            document.getElementById('formFinalizar')?.addEventListener('submit', function (e) {
                if (!retiradaChk?.checked && !selectEnd?.value) {
                    e.preventDefault();
                    alert('Por favor, selecione um endereço de entrega ou marque "Retirar no local".');
                }
            });
        });
    </script>
}