@model WebApplicationPods.Models.PedidoModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pedido confirmado";

    var pedidoId = Model?.Id;
    var token = Model?.RastreioToken ?? ViewBag.RastreioToken as string;
    var subtotal = Model?.PedidoItens?.Sum(i => i.PrecoUnitario * i.Quantidade) ?? Model?.ValorTotal ?? 0m;
    var taxaEntrega = Model?.TaxaEntrega ?? 0m;
    var total = Model?.ValorTotalComEntrega ?? (subtotal + taxaEntrega);
}

@section Styles {
    <link rel="stylesheet" href="~/css/pedido-confirmado.css" asp-append-version="true" />
}

<div class="container my-4">
    <div class="alert alert-success">
        <h4 class="mb-1">Pedido #@pedidoId confirmado!</h4>
        <div>Obrigado! Você pode acompanhar o andamento em tempo real.</div>
    </div>

    @if (Model != null)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                @if (Model.PedidoItens != null && Model.PedidoItens.Any())
                {
                    <div class="mb-3">
                        <h5 class="mb-3">Itens do pedido</h5>

                        @foreach (var item in Model.PedidoItens)
                        {
                            var nome = item.NomeExibicao;
                            var resumoQuantidade = item.ResumoQuantidadeExibicao;
                            var totalItem = item.PrecoUnitario * item.Quantidade;
                            var img = item.Produto?.ImagemUrl ?? "https://via.placeholder.com/80x80?text=Produto";

                            <div class="d-flex align-items-center gap-3 border-bottom py-2">
                                <img src="@img"
                                     alt="@nome"
                                     style="width:56px;height:56px;object-fit:cover;border-radius:12px;" />

                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@nome</div>
                                    <div class="text-muted small">@resumoQuantidade</div>

                                    @if (item.TotalUnidadesFisicas > item.Quantidade)
                                    {
                                        <div class="text-muted small">
                                            @item.TotalUnidadesFisicasExibicao
                                        </div>
                                    }
                                </div>

                                <div class="fw-semibold text-nowrap">
                                    @totalItem.ToString("C")
                                </div>
                            </div>
                        }
                    </div>

                    <hr />
                }

                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal</span>
                    <strong>@subtotal.ToString("C")</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Taxa de entrega</span>
                    <strong>@taxaEntrega.ToString("C")</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between fs-5">
                    <span>Total</span>
                    <strong>@total.ToString("C")</strong>
                </div>
            </div>
        </div>
    }

    <div class="d-none d-md-flex gap-2">
        <a class="btn btn-primary"
           href="@Url.Action("Acompanhar", "Pedido", new { id = pedidoId, t = token })">
            Acompanhar pedido
        </a>

        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">
            Voltar à loja
        </a>
    </div>
</div>

<div class="d-md-none mobile-cta fixed-cta bg-white border-top p-3 shadow-lg">
    <a class="btn btn-primary btn-lg w-100"
       href="@Url.Action("Acompanhar", "Pedido", new { id = pedidoId, t = token })">
        Acompanhar pedido
    </a>
</div>
