@model WebApplicationPods.Models.CarrinhoPageViewModel
@using System.Globalization
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Seu carrinho";
    ViewData["HideStoreHeader"] = true;

    var ptBR = CultureInfo.GetCultureInfo("pt-BR");
    var itens = Model?.Carrinho?.Itens ?? new List<WebApplicationPods.Models.CarrinhoItemViewModel>();
    var temItens = itens.Any();
    var total = Model?.Carrinho?.Total ?? 0m;
}

@section Styles {
    <link rel="stylesheet" href="~/css/carrinho.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="cart-page">
    <header class="cart-header">
        <div>
            <a asp-controller="Home" asp-action="Index" class="cart-back" aria-label="Voltar">
                <i class="fas fa-arrow-left"></i>
            </a>
        </div>

        <div class="cart-header-title">
            <h1>Seu carrinho</h1>
            <p>@(temItens ? $"{itens.Count} item(ns) selecionado(s)" : "Carrinho vazio")</p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="cart-icon-link" aria-label="Loja">
            <i class="fas fa-store"></i>
        </a>
    </header>

    <div id="carrinho-alerts" class="cart-alerts">
        @if (TempData["Sucesso"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle me-1"></i>@ok
            </div>
        }

        @if (TempData["Erro"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-1"></i>@err
            </div>
        }
    </div>

    @if (temItens)
    {
        <div class="cart-layout">
            <main class="cart-items">
                @foreach (var item in itens)
                {
                    item.Produto?.DeserializarSaboresQuantidades();

                    var produto = item.Produto;
                    var chaveSabor = item.Sabor ?? string.Empty;

                    int maxPermitido;
                    if (!string.IsNullOrWhiteSpace(chaveSabor) &&
                    produto?.SaboresQuantidadesList?.Any() == true)
                    {
                        var sq = produto.SaboresQuantidadesList
                        .FirstOrDefault(s => string.Equals(s.Sabor, chaveSabor, StringComparison.OrdinalIgnoreCase));

                        maxPermitido = sq?.Quantidade ?? produto.Estoque;
                    }
                    else
                    {
                        maxPermitido = produto?.Estoque ?? 1;
                    }

                    if (maxPermitido < 1)
                    {
                        maxPermitido = 1;
                    }

                    var temPromo = produto?.EstaEmPromocao() == true;
                    var precoNormal = produto?.Preco ?? 0m;
                    var precoFinal = temPromo ? (produto?.PrecoPromocional ?? precoNormal) : precoNormal;
                    var subtotal = item.Quantidade * precoFinal;

                    var partesDescricao = new List<string>();

                    if (!string.IsNullOrWhiteSpace(item.Sabor))
                    {
                        partesDescricao.Add(item.Sabor);
                    }

                    if (!string.IsNullOrWhiteSpace(produto?.UnidadeVendaDescricao))
                    {
                        partesDescricao.Add(produto.UnidadeVendaDescricao);
                    }

                    if (produto?.BebidaVolumeMl.HasValue == true && produto.BebidaVolumeMl.Value > 0)
                    {
                        partesDescricao.Add($"{produto.BebidaVolumeMl.Value} ml");
                    }

                    if (produto?.PodPuffs.HasValue == true && produto.PodPuffs.Value > 0)
                    {
                        partesDescricao.Add($"{produto.PodPuffs.Value} puffs");
                    }

                    var descricaoResumo = partesDescricao.Any()
                    ? string.Join(" • ", partesDescricao)
                    : (!string.IsNullOrWhiteSpace(produto?.Descricao) ? produto.Descricao : "Produto selecionado");

                    var quantidadeVendaResumo = produto?.EhEmbalagemComposta == true
                    ? $"{item.Quantidade} {(item.Quantidade == 1 ? produto.EmbalagemVendaSingular : produto.EmbalagemVendaPlural)} com {produto.UnidadesFisicasPorEmbalagem} unidades"
                    : (item.Quantidade == 1 ? "1 unidade" : $"{item.Quantidade} unidades");

                    <article class="cart-item-card">
                        <div class="cart-item-image">
                            @if (!string.IsNullOrWhiteSpace(produto?.ImagemUrl))
                            {
                                <img src="@Url.Content(produto.ImagemUrl)"
                                     alt="@(produto?.Nome ?? "Produto")"
                                     loading="lazy"
                                     decoding="async" />
                            }
                            else
                            {
                                <div class="cart-item-placeholder">
                                    <i class="fas fa-image"></i>
                                </div>
                            }
                        </div>

                        <div class="cart-item-content">
                            <div class="cart-item-top">
                                <div class="cart-item-main">
                                    <h2>@(produto?.Nome ?? "Produto")</h2>
                                    <p>@descricaoResumo</p>
                                    <span>@quantidadeVendaResumo</span>

                                    @if (!string.IsNullOrWhiteSpace(item.Observacoes))
                                    {
                                        <small><strong>Obs:</strong> @item.Observacoes</small>
                                    }
                                </div>

                                <form asp-action="RemoverItem" method="post" class="cart-remove-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="produtoId" value="@produto!.Id" />
                                    <input type="hidden" name="sabor" value="@item.Sabor" />

                                    <button type="submit" class="cart-remove-btn" aria-label="Remover item">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>

                            <div class="cart-item-bottom">
                                <div class="cart-price">
                                    @if (temPromo)
                                    {
                                        <span class="old">@precoNormal.ToString("C", ptBR)</span>
                                    }

                                    <strong>@precoFinal.ToString("C", ptBR)</strong>
                                    <small>Subtotal: @subtotal.ToString("C", ptBR)</small>
                                </div>

                                <form asp-action="AtualizarItem" method="post" class="cart-qty-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="produtoId" value="@produto!.Id" />
                                    <input type="hidden" name="sabor" value="@item.Sabor" />

                                    <div class="cart-qty-control">
                                        <button type="submit" name="op" value="dec" class="cart-qty-btn" aria-label="Diminuir">
                                            <i class="fas fa-minus"></i>
                                        </button>

                                        <input type="number"
                                               name="quantidade"
                                               value="@item.Quantidade"
                                               min="1"
                                               max="@maxPermitido"
                                               class="cart-qty-input"
                                               inputmode="numeric" />

                                        <button type="submit" name="op" value="inc" class="cart-qty-btn" aria-label="Aumentar">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </article>
                }
            </main>

            <aside class="cart-summary">
                <div id="resumo-card" class="cart-summary-card">
                    <div class="cart-summary-head">
                        <h2>Resumo do pedido</h2>
                        <span>@itens.Count item(ns)</span>
                    </div>

                    <div class="cart-summary-lines">
                        @* <div>
                            <span>Subtotal</span>
                            <strong>@total.ToString("C", ptBR)</strong>
                        </div> *@

                        <div>
                            <span>Entrega</span>
                            <strong>Calculada no pedido</strong>
                        </div>
                    </div>

                    <div class="cart-summary-total">
                        <span>Total</span>
                        <strong class="total-valor">@total.ToString("C", ptBR)</strong>
                    </div>

                    <div class="cart-actions">
                        <a asp-controller="Home" asp-action="Index" class="cart-btn cart-btn-light">
                            <i class="fas fa-arrow-left"></i>
                            Continuar comprando
                        </a>

                        <a asp-action="Resumo" class="cart-btn cart-btn-primary">
                            Finalizar pedido
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    }
    else
    {
        <section id="empty-state" class="cart-empty">
            <div class="cart-empty-icon">
                <i class="fas fa-cart-shopping"></i>
            </div>

            <h2>Seu carrinho está vazio</h2>
            <p>Adicione produtos ao seu carrinho para continuar.</p>

            <a asp-controller="Home" asp-action="Index" class="cart-btn cart-btn-primary">
                <i class="fas fa-store"></i>
                Ver produtos
            </a>
        </section>

        @if (Model?.Populares?.Any() == true)
        {
            <section id="populares-wrapper" class="cart-popular">
                <div class="cart-popular-head">
                    <h2>Mais populares</h2>
                    <a asp-controller="Home" asp-action="Index">Ver todos</a>
                </div>

                <div class="cart-popular-grid">
                    @foreach (var p in Model.Populares)
                    {
                        <article class="cart-pop-card">
                            <a asp-controller="Produto"
                               asp-action="Detalhes"
                               asp-route-id="@p.Id"
                               class="cart-pop-link"
                               aria-label="Ver detalhes de @p.Nome">

                                <div class="cart-pop-image">
                                    @if (!string.IsNullOrWhiteSpace(p.ImagemUrl))
                                    {
                                        <img src="@Url.Content(p.ImagemUrl)" alt="@p.Nome" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <div class="cart-item-placeholder">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </div>

                                <div class="cart-pop-body">
                                    <h3>@p.Nome</h3>

                                    <div class="cart-pop-price">
                                        @if (p.EmPromocao)
                                        {
                                            <span class="old">@p.Preco.ToString("C", ptBR)</span>
                                            <strong>@((p.PrecoPromocional ?? p.Preco).ToString("C", ptBR))</strong>
                                        }
                                        else
                                        {
                                            <strong>@p.Preco.ToString("C", ptBR)</strong>
                                        }
                                    </div>
                                </div>
                            </a>

                            <form asp-action="AdicionarItem" method="post" class="cart-pop-add-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="produtoId" value="@p.Id" />
                                <input type="hidden" name="quantidade" value="1" />

                                <button type="submit" class="cart-pop-add">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </form>
                        </article>
                    }
                </div>
            </section>
        }
    }
</div>

@section Scripts {
    <script src="~/js/Carrinho-form.js" asp-append-version="true"></script>
}r