@model WebApplicationPods.Models.ConfiguracoesViewModel

@{
    ViewData["Title"] = "Perfil";
}

@section Styles {
    <link rel="stylesheet" href="~/css/configuracoes.css" asp-append-version="true" />
}

<div class="settings-page profile-page">
    <header class="settings-header">
        <div class="settings-title">
            <span>Conta</span>
            <h1>Perfil</h1>
            <p>Atualize seus dados de acesso e identificação no painel.</p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="settings-btn settings-btn-light">
            <i class="fas fa-arrow-left"></i>
            Voltar
        </a>
    </header>

    <div class="settings-alerts">
        @if (TempData["MensagemSucesso"] != null)
        {
            <div class="settings-alert is-success">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["MensagemSucesso"]</span>
            </div>
        }

        @if (TempData["MensagemErro"] != null)
        {
            <div class="settings-alert is-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@TempData["MensagemErro"]</span>
            </div>
        }

        <div asp-validation-summary="ModelOnly" class="settings-validation"></div>
    </div>

    <div class="settings-grid profile-grid">
        <section class="settings-card profile-card-main">
            <div class="settings-card-head">
                <div class="settings-card-title">
                    <div class="settings-card-icon">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <span>Dados</span>
                        <h2>Dados do lojista</h2>
                        <p>Essas informações aparecem no topo do painel e na conta do usuário.</p>
                    </div>
                </div>
            </div>

            <form asp-action="AtualizarPerfil" method="post" class="settings-form">
                @Html.AntiForgeryToken()

                <div class="settings-field">
                    <label asp-for="NomeUsuario">Nome do lojista</label>
                    <div class="settings-input-wrap">
                        <i class="fas fa-user"></i>
                        <input asp-for="NomeUsuario" placeholder="Nome do lojista" autocomplete="name" />
                    </div>
                    <span asp-validation-for="NomeUsuario" class="settings-validation"></span>
                </div>

                <div class="settings-field">
                    <label asp-for="Telefone"></label>
                    <div class="settings-input-wrap">
                        <i class="fas fa-phone"></i>
                        <input asp-for="Telefone" placeholder="(00) 00000-0000" inputmode="numeric" autocomplete="tel" />
                    </div>
                    <span asp-validation-for="Telefone" class="settings-validation"></span>
                </div>

                <div class="settings-field">
                    <label asp-for="Email">E-mail</label>
                    <div class="settings-input-wrap">
                        <i class="fas fa-envelope"></i>
                        <input asp-for="Email" placeholder="email@exemplo.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="settings-validation"></span>
                </div>

                <div class="settings-field">
                    <label>CPF de acesso</label>
                    <div class="settings-input-wrap is-disabled">
                        <i class="fas fa-id-card"></i>
                        <input value="@Model.Cpf" disabled />
                    </div>
                </div>

                <button type="submit" class="settings-btn settings-btn-primary">
                    <i class="fas fa-save"></i>
                    Salvar alterações
                </button>
            </form>
        </section>

        <section class="settings-card">
            <div class="settings-card-head">
                <div class="settings-card-title">
                    <div class="settings-card-icon">
                        <i class="fas fa-lock"></i>
                    </div>
                    <div>
                        <span>Segurança</span>
                        <h2>Senha</h2>
                        <p>Altere a senha usada para entrar no painel.</p>
                    </div>
                </div>
            </div>

            <form asp-action="AlterarSenhaPerfil" method="post" class="settings-form">
                @Html.AntiForgeryToken()

                <div class="settings-field">
                    <label asp-for="SenhaAtual">Senha atual</label>
                    <div class="settings-input-wrap">
                        <i class="fas fa-lock"></i>
                        <input asp-for="SenhaAtual" autocomplete="current-password" />
                    </div>
                </div>

                <div class="settings-field">
                    <label asp-for="NovaSenha">Nova senha</label>
                    <div class="settings-input-wrap">
                        <i class="fas fa-key"></i>
                        <input asp-for="NovaSenha" autocomplete="new-password" />
                    </div>
                </div>

                <div class="settings-field">
                    <label asp-for="ConfirmarSenha">Confirmar nova senha</label>
                    <div class="settings-input-wrap">
                        <i class="fas fa-check"></i>
                        <input asp-for="ConfirmarSenha" autocomplete="new-password" />
                    </div>
                </div>

                <button type="submit" class="settings-btn settings-btn-primary">
                    <i class="fas fa-key"></i>
                    Alterar senha
                </button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
