@model WebApplicationPods.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Login";
    ViewData["HideChrome"] = true;
    ViewData["BodyClass"] = "auth-page";

    var scheme = Context.Request.Scheme;
    var port = Context.Request.Host.Port;
    var portPart = port.HasValue ? $":{port.Value}" : "";
    var adminUrl = $"{scheme}://admin.lvh.me{portPart}/Conta/Login";
    var painelUrl = $"{scheme}://painel.lvh.me{portPart}/Conta/Login";
    var lojaUrl = $"{scheme}://loja-1.lvh.me{portPart}/";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <main class="auth-panel">
        <section class="auth-hero" aria-label="Apresentação">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="auth-brand-icon">
                    <i class="fa-solid fa-store"></i>
                </span>
                @*<span>Pods</span>*@
            </a>

            <div class="auth-copy">
                <span class="auth-eyebrow">Plataforma multi-loja</span>
                <h1>Acesse seu painel</h1>
                <p>
                    Entre com CPF, telefone ou e-mail. O sistema identifica seu perfil e direciona você para o ambiente correto.
                </p>
            </div>

            <div class="auth-role-grid">
                <div class="auth-role-card">
                    <span><i class="fa-solid fa-user-shield"></i></span>
                    <strong>Admin central</strong>
                    <small>Controle lojas, lojistas e a operação da plataforma.</small>
                </div>

                <div class="auth-role-card">
                    <span><i class="fa-solid fa-shop"></i></span>
                    <strong>Painel do lojista</strong>
                    <small>Gerencie produtos, estoque, pedidos e configurações.</small>
                </div>

                <div class="auth-role-card">
                    <span><i class="fa-solid fa-truck-fast"></i></span>
                    <strong>Entregas</strong>
                    <small>Acompanhe rotas e pedidos disponíveis para entrega.</small>
                </div>
            </div>

            <div class="auth-dev-links">
                <a href="@adminUrl">
                    <i class="fa-solid fa-user-shield"></i>
                    Admin
                </a>
                <a href="@painelUrl">
                    <i class="fa-solid fa-store"></i>
                    Lojista
                </a>
                <a href="@lojaUrl" target="_blank" rel="noopener">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Loja
                </a>
            </div>
        </section>

        <section class="auth-card" aria-label="Entrar">
            <div class="auth-card-head">
                <span class="auth-card-icon">
                    <i class="fa-solid fa-right-to-bracket"></i>
                </span>
                <div>
                    <span>Login</span>
                    <h2>Entrar</h2>
                </div>
            </div>

            <form asp-action="Login" method="post" asp-antiforgery="true" class="auth-form" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                <div class="auth-field">
                    <label asp-for="TelefoneOuCpf">Telefone, CPF ou e-mail</label>
                    <div class="auth-input">
                        <i class="fa-solid fa-id-card"></i>
                        <input asp-for="TelefoneOuCpf"
                               placeholder="Ex.: 11999999999 ou 123.456.789-00"
                               autocomplete="username"
                               id="login-credential" />
                    </div>
                    <span asp-validation-for="TelefoneOuCpf" class="auth-field-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Senha">Senha</label>
                    <div class="auth-input">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Senha"
                               type="password"
                               placeholder="Digite sua senha"
                               autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Senha" class="auth-field-validation"></span>
                </div>

                <div class="auth-options">
                    <label class="auth-check" for="lembrar">
                        <input class="form-check-input" asp-for="LembrarMe" id="lembrar" />
                        <span>Lembrar-me</span>
                    </label>

                    <a id="forgot-link"
                       class="auth-muted-link"
                       asp-controller="Conta"
                       asp-action="ForgotPassword"
                       title="Recuperar acesso">
                        Esqueci minha senha
                    </a>
                </div>

                <button type="submit" class="auth-submit">
                    <i class="fa-solid fa-lock"></i>
                    Entrar
                </button>

                <p class="auth-note">
                    Se você for lojista, o acesso será liberado apenas para a loja vinculada ao seu usuário.
                </p>
            </form>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const input = document.getElementById('login-credential');
            const forgot = document.getElementById('forgot-link');
            const baseUrl = '@Url.Action("ForgotPassword", "Conta")';
            const checkUrl = '@Url.Action("CheckAccount", "Conta")';
            let timer;

            function setForgot(email) {
                if (!forgot) return;

                if (email) {
                    forgot.href = baseUrl + '?email=' + encodeURIComponent(email);
                    return;
                }

                forgot.href = baseUrl;
            }

            async function check() {
                if (!input) return;

                const val = (input.value || '').trim();

                if (!val) {
                    setForgot(null);
                    return;
                }

                try {
                    const response = await fetch(checkUrl + '?input=' + encodeURIComponent(val), { cache: 'no-store' });

                    if (!response.ok) {
                        setForgot(null);
                        return;
                    }

                    const data = await response.json();
                    setForgot(data.email || null);
                } catch {
                    setForgot(null);
                }
            }

            if (input) {
                input.addEventListener('input', function () {
                    clearTimeout(timer);
                    timer = setTimeout(check, 250);
                });

                input.addEventListener('blur', check);
            }

            setForgot(null);
        })();
    </script>
}