@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Acesso Negado";
    ViewData["HideChrome"] = true;
    ViewData["BodyClass"] = "auth-page";

    var isAuth = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <main class="auth-result-panel">
        <section class="auth-result-card">
            <a class="auth-brand auth-result-brand" asp-controller="Home" asp-action="Index">
                <span class="auth-brand-icon">
                    <i class="fa-solid fa-store"></i>
                </span>
                @*<span>Pods</span>*@
            </a>

            <div class="auth-result-icon auth-result-icon-danger">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <span class="auth-eyebrow auth-eyebrow-danger">Permissão</span>
            <h1>Acesso negado</h1>

            <p>
                Você não tem permissão para acessar este recurso. Se acredita que isso é um engano, fale com o administrador.
            </p>

            <div class="auth-alert-danger">
                <i class="fa-solid fa-circle-xmark"></i>
                <div>
                    <strong>Área restrita</strong>
                    <span>Seu usuário atual não possui acesso para esta página.</span>
                </div>
            </div>

            <div class="auth-result-actions">
                <a asp-controller="Home" asp-action="Index" class="auth-secondary-action">
                    <i class="fa-solid fa-house"></i>
                    Voltar ao início
                </a>

                @if (!isAuth)
                {
                    <a asp-controller="Conta" asp-action="Login" class="auth-submit auth-link-button">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Entrar
                    </a>
                }
                else
                {
                    <form asp-controller="Conta" asp-action="Logout" method="post" class="auth-inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="auth-danger-action">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                            Sair da conta
                        </button>
                    </form>
                }
            </div>
        </section>
    </main>
</div>