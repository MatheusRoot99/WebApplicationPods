@model WebApplicationPods.ViewModels.ResetPasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Redefinir senha";
    ViewData["HideChrome"] = true;
    ViewData["BodyClass"] = "auth-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <main class="auth-simple-panel">
        <section class="auth-simple-hero">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="auth-brand-icon">
                    <i class="fa-solid fa-store"></i>
                </span>
                @*<span>Pods</span>*@
            </a>

            <div class="auth-copy">
                <span class="auth-eyebrow">Nova senha</span>
                <h1>Redefina seu acesso</h1>
                <p>Escolha uma nova senha para continuar usando o painel com segurança.</p>
            </div>

            <div class="auth-simple-note">
                <i class="fa-solid fa-lock"></i>
                <span>Use uma senha que você não utilize em outros serviços.</span>
            </div>
        </section>

        <section class="auth-card auth-simple-card">
            <div class="auth-card-head">
                <span class="auth-card-icon">
                    <i class="fa-solid fa-key"></i>
                </span>
                <div>
                    <span>Segurança</span>
                    <h2>Redefinir senha</h2>
                </div>
            </div>

            <form asp-action="ResetPassword" method="post" asp-antiforgery="true" class="auth-form" novalidate id="rp-form">
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                <div class="auth-field">
                    <label asp-for="Email">E-mail</label>
                    <div class="auth-input auth-input-readonly">
                        <i class="fa-solid fa-at"></i>
                        <input asp-for="Email" type="email" readonly />
                    </div>
                    <span asp-validation-for="Email" class="auth-field-validation"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password">Nova senha</label>
                    <div class="auth-input auth-input-with-action">
                        <i class="fa-solid fa-lock"></i>
                        <input asp-for="Password"
                               type="password"
                               id="rp-pass"
                               autocomplete="new-password"
                               placeholder="Digite sua nova senha" />
                        <button type="button" class="auth-input-action" id="toggle-pass" tabindex="-1" aria-label="Mostrar ou ocultar senha">
                            <i class="fa-solid fa-eye-slash"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="auth-field-validation"></span>
                    <small class="auth-helper">Use ao menos 8 caracteres e misture letras, números e símbolos.</small>
                </div>

                <button type="submit" class="auth-submit" id="rp-submit">
                    <i class="fa-solid fa-check"></i>
                    Salvar nova senha
                </button>

                <a asp-controller="Conta" asp-action="Login" class="auth-secondary-action">
                    <i class="fa-solid fa-arrow-left-long"></i>
                    Voltar ao login
                </a>
            </form>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('rp-form')?.addEventListener('submit', function () {
            const btn = document.getElementById('rp-submit');

            if (!btn) return;

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Salvando...';
        });

        (function () {
            const btn = document.getElementById('toggle-pass');
            const input = document.getElementById('rp-pass');

            if (!btn || !input) return;

            btn.addEventListener('click', function () {
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.innerHTML = isPassword
                    ? '<i class="fa-solid fa-eye"></i>'
                    : '<i class="fa-solid fa-eye-slash"></i>';
            });
        })();
    </script>
}