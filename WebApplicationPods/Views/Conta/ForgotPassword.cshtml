@model WebApplicationPods.ViewModels.ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Esqueci minha senha";
    ViewData["HideChrome"] = true;
    ViewData["BodyClass"] = "auth-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <main class="auth-simple-panel">
        <section class="auth-simple-hero">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="auth-brand-icon">
                    <i class="fa-solid fa-store"></i>
                </span>
                @*<span>Pods</span>*@
            </a>

            <div class="auth-copy">
                <span class="auth-eyebrow">Recuperação</span>
                <h1>Recupere seu acesso</h1>
                <p>Informe o e-mail cadastrado. Se encontrarmos sua conta, enviaremos um link seguro para redefinir sua senha.</p>
            </div>

            <div class="auth-simple-note">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Por segurança, o sistema não informa se o e-mail existe ou não na base.</span>
            </div>
        </section>

        <section class="auth-card auth-simple-card">
            <div class="auth-card-head">
                <span class="auth-card-icon">
                    <i class="fa-solid fa-envelope-circle-check"></i>
                </span>
                <div>
                    <span>Acesso</span>
                    <h2>Esqueci minha senha</h2>
                </div>
            </div>

            <form asp-action="ForgotPassword" method="post" asp-antiforgery="true" class="auth-form" novalidate id="fp-form">
                <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

                <div class="auth-field">
                    <label asp-for="Email">E-mail</label>
                    <div class="auth-input">
                        <i class="fa-solid fa-at"></i>
                        <input asp-for="Email"
                               type="email"
                               autocomplete="email"
                               placeholder="seu@email.com"
                               required />
                    </div>
                    <span asp-validation-for="Email" class="auth-field-validation"></span>
                    <small class="auth-helper">Enviaremos um link de redefinição se encontrarmos sua conta.</small>
                </div>

                <button type="submit" class="auth-submit" id="fp-submit">
                    <i class="fa-solid fa-paper-plane"></i>
                    Enviar e-mail de redefinição
                </button>

                <a asp-controller="Conta" asp-action="Login" class="auth-secondary-action">
                    <i class="fa-solid fa-arrow-left-long"></i>
                    Voltar ao login
                </a>
            </form>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('fp-form')?.addEventListener('submit', function () {
            const btn = document.getElementById('fp-submit');

            if (!btn) return;

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Enviando...';
        });
    </script>
}