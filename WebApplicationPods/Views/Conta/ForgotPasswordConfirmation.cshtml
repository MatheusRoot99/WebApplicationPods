@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "E-mail enviado";
    ViewData["HideChrome"] = true;
    ViewData["BodyClass"] = "auth-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-shell">
    <main class="auth-result-panel">
        <section class="auth-result-card">
            <a class="auth-brand auth-result-brand" asp-controller="Home" asp-action="Index">
                <span class="auth-brand-icon">
                    <i class="fa-solid fa-store"></i>
                </span>
                @*<span>Pods</span>*@
            </a>

            <div class="auth-result-icon auth-result-icon-success">
                <i class="fa-solid fa-paper-plane"></i>
            </div>

            <span class="auth-eyebrow">Verifique seu e-mail</span>
            <h1>E-mail enviado</h1>

            <p>
                Se o e-mail informado existir no sistema, enviamos as instruções para redefinir sua senha.
            </p>

            <div class="auth-info-list">
                <div>
                    <i class="fa-solid fa-inbox"></i>
                    <span>Verifique a caixa de entrada e também a pasta de spam.</span>
                </div>
                <div>
                    <i class="fa-solid fa-clock"></i>
                    <span>O link expira após algum tempo por segurança.</span>
                </div>
            </div>

            <div class="auth-result-actions">
                <a asp-controller="Conta" asp-action="Login" class="auth-submit auth-link-button">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Voltar ao login
                </a>

                <a asp-controller="Conta" asp-action="ForgotPassword" class="auth-secondary-action">
                    <i class="fa-solid fa-pen"></i>
                    Informei o e-mail errado
                </a>
            </div>
        </section>
    </main>
</div>