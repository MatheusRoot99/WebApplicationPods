@using WebApplicationPods.Models
@model CategoriaModel

@{
    ViewData["Title"] = "Nova categoria";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="category-form-page">
    <header class="category-form-header">
        <a asp-action="Index" class="category-form-back" aria-label="Voltar">
            <i class="fas fa-arrow-left"></i>
        </a>

        <div class="category-form-title">
            <span>Categorias</span>
            <h1>Nova categoria</h1>
            <p>Crie uma categoria para organizar os produtos da loja.</p>
        </div>
    </header>

    <section class="category-form-card">
        <div class="category-form-card-head">
            <div class="category-form-icon">
                <i class="fas fa-tag"></i>
            </div>

            <div>
                <span>Cadastro</span>
                <h2>Dados da categoria</h2>
            </div>
        </div>

        <div class="category-form-card-body">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="categories-alert is-error">
                    <i class="fas fa-exclamation-triangle"></i>
                    <div>
                        <strong>Erros no formulário</strong>
                        <ul>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <form asp-action="Criar" class="category-form needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="category-field">
                    <label asp-for="Nome"></label>
                    <div class="category-input-wrap">
                        <i class="fas fa-tag"></i>
                        <input asp-for="Nome" placeholder="Digite o nome da categoria" />
                    </div>
                    <span asp-validation-for="Nome" class="category-validation"></span>
                </div>

                <div class="category-field">
                    <label asp-for="Descricao"></label>
                    <div class="category-input-wrap is-textarea">
                        <i class="fas fa-align-left"></i>
                        <textarea asp-for="Descricao" rows="4" placeholder="Digite uma descrição opcional"></textarea>
                    </div>
                    <span asp-validation-for="Descricao" class="category-validation"></span>
                </div>

                <div class="category-form-actions">
                    <a asp-action="Index" class="categories-btn categories-btn-light">
                        <i class="fas fa-arrow-left"></i>
                        Cancelar
                    </a>

                    <button type="submit" class="categories-btn categories-btn-primary">
                        <i class="fas fa-save"></i>
                        Salvar categoria
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.querySelectorAll('form.needs-validation').forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }

                form.classList.add('was-validated');
            }, false);
        });
    </script>
}