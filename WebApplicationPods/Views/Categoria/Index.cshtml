@using WebApplicationPods.Models
@model IEnumerable<CategoriaModel>

@{
    ViewData["Title"] = "Categorias";

    var categorias = Model?.ToList() ?? new List<CategoriaModel>();
    var totalCategorias = categorias.Count;
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="categories-page">
    <header class="categories-header">
        <div class="categories-title">
            <span>Administração</span>
            <h1>Categorias</h1>
            <p>Organize os produtos da loja por grupos.</p>
        </div>

        <a asp-action="Criar" class="categories-btn categories-btn-primary">
            <i class="fas fa-plus"></i>
            Nova categoria
        </a>
    </header>

    <div class="categories-alerts">
        @if (TempData["MensagemSucesso"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="categories-alert is-success">
                <i class="fas fa-check-circle"></i>
                <span>@ok</span>
            </div>
        }

        @if (TempData["MensagemErro"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="categories-alert is-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@err</span>
            </div>
        }
    </div>

    <section class="categories-kpis">
        <article class="categories-kpi">
            <div class="categories-kpi-icon">
                <i class="fas fa-tags"></i>
            </div>

            <div>
                <span>Total de categorias</span>
                <strong>@totalCategorias</strong>
            </div>
        </article>

        <article class="categories-kpi">
            <div class="categories-kpi-icon is-green">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <span>Categorias ativas</span>
                <strong>@totalCategorias</strong>
            </div>
        </article>
    </section>

    <section class="categories-toolbar">
        <div class="categories-section-title">
            <span>Busca</span>
            <h2>Pesquisar categoria</h2>
        </div>

        <div class="categories-search">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Pesquisar por nome ou descrição..." />
        </div>
    </section>

    <section class="categories-table-card">
        <div class="categories-table-head">
            <div>
                <span>Lista</span>
                <h2>Lista de categorias</h2>
            </div>

            <strong>@totalCategorias categoria(s)</strong>
        </div>

        @if (categorias.Any())
        {
            <div class="categories-table-wrap">
                <table class="categories-table" id="categoriasTable">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Descrição</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody id="tbodyCategorias">
                        @foreach (var item in categorias)
                        {
                            <tr>
                                <td data-label="Nome">
                                    <div class="category-name-cell">
                                        <span class="category-icon">
                                            <i class="fas fa-tag"></i>
                                        </span>

                                        <strong>@item.Nome</strong>
                                    </div>
                                </td>

                                <td data-label="Descrição">
                                    @if (!string.IsNullOrWhiteSpace(item.Descricao))
                                    {
                                        <span class="category-description">@item.Descricao</span>
                                    }
                                    else
                                    {
                                        <span class="category-description is-empty">Sem descrição</span>
                                    }
                                </td>

                                <td data-label="Ações" class="text-end">
                                    <div class="category-actions">
                                        <a asp-action="Editar"
                                           asp-route-id="@item.Id"
                                           class="category-icon-btn is-edit"
                                           title="Editar"
                                           aria-label="Editar @item.Nome">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <a asp-action="Excluir"
                                           asp-route-id="@item.Id"
                                           class="category-icon-btn is-delete"
                                           title="Excluir"
                                           aria-label="Excluir @item.Nome">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="categories-mobile-list" id="categoriasMobileList">
                @foreach (var item in categorias)
                {
                    <article class="category-mobile-card">
                        <header>
                            <span class="category-icon">
                                <i class="fas fa-tag"></i>
                            </span>

                            <div>
                                <h3>@item.Nome</h3>

                                @if (!string.IsNullOrWhiteSpace(item.Descricao))
                                {
                                    <p>@item.Descricao</p>
                                }
                                else
                                {
                                    <p class="is-empty">Sem descrição</p>
                                }
                            </div>
                        </header>

                        <footer>
                            <a asp-action="Editar"
                               asp-route-id="@item.Id"
                               class="categories-btn categories-btn-light">
                                <i class="fas fa-edit"></i>
                                Editar
                            </a>

                            <a asp-action="Excluir"
                               asp-route-id="@item.Id"
                               class="categories-btn categories-btn-danger">
                                <i class="fas fa-trash-alt"></i>
                                Excluir
                            </a>
                        </footer>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="categories-empty">
                <div class="categories-empty-icon">
                    <i class="fas fa-tags"></i>
                </div>

                <h2>Nenhuma categoria cadastrada</h2>
                <p>Crie sua primeira categoria para organizar os produtos.</p>

                <a asp-action="Criar" class="categories-btn categories-btn-primary">
                    <i class="fas fa-plus"></i>
                    Nova categoria
                </a>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(() => {
                document.querySelectorAll('.categories-alert').forEach(a => a.remove());
            }, 5000);

            const searchInput = document.getElementById('searchInput');
            const tableRows = Array.from(document.querySelectorAll('#categoriasTable tbody tr'));
            const mobileCards = Array.from(document.querySelectorAll('.category-mobile-card'));

            function normalize(value) {
                return (value || '').toString().toLowerCase().trim();
            }

            function filterCategories() {
                const term = normalize(searchInput?.value);

                tableRows.forEach(row => {
                    row.style.display = normalize(row.textContent).includes(term) ? '' : 'none';
                });

                mobileCards.forEach(card => {
                    card.style.display = normalize(card.textContent).includes(term) ? '' : 'none';
                });
            }

            searchInput?.addEventListener('input', filterCategories);
        });
    </script>
}