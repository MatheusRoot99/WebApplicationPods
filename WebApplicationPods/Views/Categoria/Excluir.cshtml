@using WebApplicationPods.Models
@model CategoriaModel

@{
    ViewData["Title"] = "Excluir categoria";
}

@section Styles {
    <link rel="stylesheet" href="~/css/categories-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="category-form-page">
    <header class="category-form-header">
        <a asp-action="Index" class="category-form-back" aria-label="Voltar">
            <i class="fas fa-arrow-left"></i>
        </a>

        <div class="category-form-title">
            <span>Categorias</span>
            <h1>Excluir categoria</h1>
            <p>Confirme a remoção antes de continuar.</p>
        </div>
    </header>

    <section class="category-form-card is-danger">
        <div class="category-form-card-head">
            <div class="category-form-icon is-danger">
                <i class="fas fa-trash-alt"></i>
            </div>

            <div>
                <span>Exclusão</span>
                <h2>Deseja excluir esta categoria?</h2>
            </div>
        </div>

        <div class="category-form-card-body">
            <div class="category-delete-preview">
                <div class="category-icon">
                    <i class="fas fa-tag"></i>
                </div>

                <div>
                    <span>Categoria</span>
                    <strong>@Model.Nome</strong>

                    @if (!string.IsNullOrWhiteSpace(Model.Descricao))
                    {
                        <p>@Model.Descricao</p>
                    }
                    else
                    {
                        <p class="is-empty">Sem descrição</p>
                    }
                </div>
            </div>

            <div class="category-delete-warning">
                <i class="fas fa-triangle-exclamation"></i>
                <span>Essa ação não pode ser desfeita.</span>
            </div>

            <form asp-action="Excluir" method="post" class="category-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="category-form-actions">
                    <a asp-action="Index" class="categories-btn categories-btn-light">
                        <i class="fas fa-arrow-left"></i>
                        Cancelar
                    </a>

                    <button type="submit" class="categories-btn categories-btn-danger">
                        <i class="fas fa-trash-alt"></i>
                        Confirmar exclusão
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>