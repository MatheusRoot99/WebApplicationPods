@model WebApplicationPods.Models.EditarInfoViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Editar informações";
    ViewData["HideStoreHeader"] = true;
    ViewData["BodyClass"] = "client-login-page client-edit-page";

    var voltarUrl = !string.IsNullOrWhiteSpace(Model?.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Resumo", "Carrinho");
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="client-login-shell">
    <div class="client-login-phone">
        <header class="client-login-appbar">
            <a href="@voltarUrl" class="client-login-back" aria-label="Voltar">
                <i class="fa-solid fa-arrow-left"></i>
            </a>

            <strong>Editar informações</strong>

            <span></span>
        </header>

        <main class="client-edit-content">
            <section class="client-login-card client-edit-card">
                <div class="client-login-icon">
                    <i class="fa-regular fa-id-card"></i>
                </div>

                <div class="client-login-title">
                    <span>Seus dados</span>
                    <h1>Atualize suas informações</h1>
                    <p>Confira nome, telefone e e-mail antes de continuar com o pedido.</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="client-login-validation"></div>

                <form asp-action="Editar" method="post" class="client-login-form" asp-antiforgery="true" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="client-login-field">
                        <label asp-for="Nome"></label>
                        <div class="client-login-input">
                            <i class="fa-regular fa-user"></i>
                            <input asp-for="Nome"
                                   autocomplete="name"
                                   placeholder="Seu nome completo" />
                        </div>
                        <span asp-validation-for="Nome" class="client-login-field-validation"></span>
                    </div>

                    <div class="client-login-field">
                        <label asp-for="Telefone"></label>
                        <div class="client-login-input">
                            <i class="fa-solid fa-phone"></i>
                            <input asp-for="Telefone"
                                   inputmode="numeric"
                                   autocomplete="tel-national"
                                   placeholder="(11) 98765-4321" />
                        </div>
                        <small>WhatsApp com DDD para acompanhar o pedido.</small>
                        <span asp-validation-for="Telefone" class="client-login-field-validation"></span>
                    </div>

                    <div class="client-login-field">
                        <label asp-for="Email"></label>
                        <div class="client-login-input">
                            <i class="fa-regular fa-envelope"></i>
                            <input asp-for="Email"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="voce@email.com" />
                        </div>
                        <span asp-validation-for="Email" class="client-login-field-validation"></span>
                    </div>

                    <div class="client-edit-actions">
                        <button type="submit" class="client-login-submit">
                            <i class="fa-solid fa-check"></i>
                            Salvar alterações
                        </button>

                        <a href="@voltarUrl" class="client-login-secondary">
                            <i class="fa-solid fa-arrow-left"></i>
                            Voltar
                        </a>
                    </div>
                </form>
            </section>
        </main>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.6/jquery.inputmask.min.js"></script>
    <script>
        (function () {
            function setVh() {
                document.documentElement.style.setProperty('--client-login-vh', window.innerHeight + 'px');
            }

            setVh();
            window.addEventListener('resize', setVh);

            const $tel = window.jQuery && jQuery('[name="Telefone"]');

            if ($tel && $tel.inputmask) {
                $tel.inputmask({ mask: '(99) 99999-9999' });
            }
        })();
    </script>
}