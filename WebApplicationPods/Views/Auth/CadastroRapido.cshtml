@model WebApplicationPods.Models.CadastroRapidoViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Cadastro Rápido";
    ViewData["HideStoreHeader"] = true;
    ViewData["BodyClass"] = "customer-register-page";

    var returnUrl = ViewBag.ReturnUrl as string;
    var cancelUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : Url.Action("Index", "Carrinho");
}

@section Styles {
    <link rel="stylesheet" href="~/css/cadastro.css" asp-append-version="true" />
}

<div class="customer-register-shell">
    <main class="customer-register-phone">
        <header class="customer-register-appbar">
            <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl" aria-label="Voltar">
                <i class="fa-solid fa-arrow-left"></i>
            </a>

            <strong>Cadastro rápido</strong>

            <span></span>
        </header>

        <form asp-action="CadastroRapido" method="post" class="customer-register-form" novalidate>
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Telefone" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <section class="customer-register-hero">
                <div class="customer-register-phone-chip">
                    <span>
                        <i class="fa-solid fa-mobile-screen"></i>
                    </span>
                    <div>
                        <small>Telefone confirmado</small>
                        <strong>@Model.Telefone</strong>
                    </div>
                </div>

                <div class="customer-register-title">
                    <span>Cliente</span>
                    <h1>Complete seu cadastro</h1>
                    <p>Preencha seus dados para continuar com o pedido.</p>
                </div>

                <div class="customer-register-steps" aria-label="Etapas do cadastro">
                    <div class="active">
                        <span>1</span>
                        <strong>Dados</strong>
                    </div>

                    <i class="fa-solid fa-chevron-right"></i>

                    <div>
                        <span>2</span>
                        <strong>Endereço</strong>
                    </div>
                </div>
            </section>

            <section class="customer-register-card">
                <header class="customer-register-card-head">
                    <span>
                        <i class="fa-regular fa-id-card"></i>
                    </span>
                    <div>
                        <small>Dados</small>
                        <h2>Dados pessoais</h2>
                    </div>
                </header>

                <div class="customer-register-fields">
                    <div class="customer-register-field">
                        <label asp-for="Nome">Nome completo</label>
                        <input asp-for="Nome"
                               autocomplete="name"
                               required
                               placeholder="Digite seu nome completo" />
                        <span asp-validation-for="Nome" class="validation-message"></span>
                    </div>

                    <div class="customer-register-field">
                        <label asp-for="CPF">CPF</label>
                        <input asp-for="CPF"
                               id="cpf"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="000.000.000-00" />
                        <span asp-validation-for="CPF" class="validation-message"></span>
                    </div>

                    <div class="customer-register-field">
                        <label asp-for="DataNascimento">Data de nascimento</label>

                        <div class="customer-date-field">
                            <input asp-for="DataNascimento"
                                   id="dob"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="bday"
                                   placeholder="00/00/0000" />

                            <input type="date" id="dobCalendar" aria-label="Selecionar data de nascimento" />

                            <button type="button" id="dobCalendarButton" aria-label="Abrir calendário">
                                <i class="fa-regular fa-calendar"></i>
                            </button>
                        </div>

                        <span asp-validation-for="DataNascimento" class="validation-message"></span>
                    </div>

                    <div class="customer-register-field">
                        <label asp-for="Email">E-mail</label>
                        <input asp-for="Email"
                               type="email"
                               autocomplete="email"
                               required
                               placeholder="exemplo@email.com" />
                        <span asp-validation-for="Email" class="validation-message"></span>
                    </div>
                </div>
            </section>

            <section class="customer-register-card">
                <header class="customer-register-card-head">
                    <span>
                        <i class="fa-solid fa-location-dot"></i>
                    </span>
                    <div>
                        <small>Entrega</small>
                        <h2>Endereço principal</h2>
                    </div>
                </header>

                <div class="customer-register-fields">
                    <div class="customer-register-field">
                        <label asp-for="CEP">CEP</label>

                        <div class="customer-cep-field input-with-feedback">
                            <input asp-for="CEP"
                                   id="cep"
                                   inputmode="numeric"
                                   autocomplete="postal-code"
                                   placeholder="00000-000" />

                            <button type="button" id="buscarCepCadastro">
                                Buscar
                            </button>

                            <div class="loading-spinner"></div>
                        </div>

                        <span asp-validation-for="CEP" class="validation-message"></span>
                    </div>

                    <div class="customer-register-field">
                        <label asp-for="Logradouro">Rua</label>
                        <input asp-for="Logradouro"
                               id="logradouro"
                               autocomplete="street-address"
                               placeholder="Rua, avenida, travessa..." />
                        <span asp-validation-for="Logradouro" class="validation-message"></span>
                    </div>

                    <div class="customer-register-field">
                        <label asp-for="Numero">Número</label>
                        <input asp-for="Numero"
                               id="numero"
                               autocomplete="address-line2"
                               placeholder="Nº" />
                        <span asp-validation-for="Numero" class="validation-message"></span>
                    </div>

                    <div class="customer-register-field">
                        <label asp-for="Complemento">Complemento</label>
                        <input asp-for="Complemento"
                               id="complemento"
                               placeholder="Apartamento, bloco, referência..." />
                        <span asp-validation-for="Complemento" class="validation-message"></span>
                    </div>

                    <div class="customer-register-field">
                        <label asp-for="Bairro">Bairro</label>
                        <input asp-for="Bairro"
                               id="bairro"
                               placeholder="Seu bairro" />
                        <span asp-validation-for="Bairro" class="validation-message"></span>
                    </div>

                    <div class="customer-register-row">
                        <div class="customer-register-field">
                            <label asp-for="Cidade">Cidade</label>
                            <input asp-for="Cidade"
                                   id="cidade"
                                   placeholder="Sua cidade" />
                            <span asp-validation-for="Cidade" class="validation-message"></span>
                        </div>

                        <div class="customer-register-field is-uf">
                            <label asp-for="Estado">UF</label>
                            <input asp-for="Estado"
                                   id="estado"
                                   placeholder="UF"
                                   maxlength="2" />
                            <span asp-validation-for="Estado" class="validation-message"></span>
                        </div>
                    </div>

                    <div class="customer-register-main-address">
                        <span>
                            <i class="fa-solid fa-check"></i>
                        </span>

                        <div>
                            <strong>Endereço principal</strong>
                            <small>Usaremos esse endereço como padrão nos próximos pedidos.</small>
                        </div>

                        <input type="checkbox" id="mainAddress" checked disabled />
                    </div>
                </div>
            </section>

            <div class="customer-register-actions">
                <button id="btnSubmit"
                        type="submit"
                        class="customer-register-submit"
                        aria-live="polite"
                        aria-busy="false"
                        data-text-default="Finalizar cadastro"
                        data-text-loading="Enviando..."
                        data-text-success="Pronto!">
                    <i class="fa-solid fa-check btn-icon" aria-hidden="true"></i>
                    <span class="btn-text">Finalizar cadastro</span>
                    <span class="btn-spinner" aria-hidden="true"></span>
                </button>

                <a href="@cancelUrl"
                   class="customer-register-cancel"
                   onclick="if (history.length > 1) { history.back(); return false; }">
                    Cancelar
                </a>
            </div>
        </form>
    </main>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/inputmask@5.0.8/dist/inputmask.min.js"></script>
    <script src="~/js/cep.js" asp-append-version="true"></script>

    <div id="formLock" class="form-lock" aria-hidden="true"></div>

    <script>
        (function () {
            function setVh() {
                var h = window.visualViewport ? window.visualViewport.height : window.innerHeight;
                document.documentElement.style.setProperty('--customer-register-vh', h + 'px');
            }

            setVh();
            window.addEventListener('resize', setVh);

            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', setVh);
                window.visualViewport.addEventListener('scroll', setVh);
            }
        })();

        (function () {
            const cpf = document.getElementById('cpf');
            const dob = document.getElementById('dob');
            const dobCalendar = document.getElementById('dobCalendar');
            const dobCalendarButton = document.getElementById('dobCalendarButton');
            const uf = document.getElementById('estado');

            try {
                if (window.Inputmask && cpf) {
                    Inputmask('999.999.999-99', {
                        showMaskOnHover: false,
                        clearIncomplete: true
                    }).mask(cpf);
                }

                if (window.Inputmask && dob) {
                    Inputmask('99/99/9999', {
                        placeholder: '00/00/0000',
                        showMaskOnHover: false,
                        clearIncomplete: true
                    }).mask(dob);
                }

                if (window.Inputmask && uf) {
                    Inputmask('AA', {
                        casing: 'upper',
                        placeholder: 'UF'
                    }).mask(uf);
                }
            } catch { }

            function brToIso(value) {
                const parts = (value || '').split('/');

                if (parts.length !== 3) return '';

                const dia = parts[0];
                const mes = parts[1];
                const ano = parts[2];

                if (dia.length !== 2 || mes.length !== 2 || ano.length !== 4) return '';

                return `${ano}-${mes}-${dia}`;
            }

            function isoToBr(value) {
                const parts = (value || '').split('-');

                if (parts.length !== 3) return '';

                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }

            dob?.addEventListener('change', function () {
                if (dobCalendar) {
                    dobCalendar.value = brToIso(dob.value);
                }
            });

            dobCalendar?.addEventListener('change', function () {
                if (dob) {
                    dob.value = isoToBr(dobCalendar.value);
                    dob.dispatchEvent(new Event('change', { bubbles: true }));
                }
            });

            dobCalendarButton?.addEventListener('click', function () {
                if (!dobCalendar) return;

                dobCalendar.value = brToIso(dob?.value || '');

                if (typeof dobCalendar.showPicker === 'function') {
                    dobCalendar.showPicker();
                } else {
                    dobCalendar.click();
                }
            });
        })();

        (function () {
            const form = document.querySelector('form.customer-register-form');
            const btn = document.getElementById('btnSubmit');
            const lock = document.getElementById('formLock');

            if (!form || !btn || !lock) return;

            const all = function (selector, root) {
                return Array.from((root || document).querySelectorAll(selector));
            };

            function clearClientErrors() {
                all('input, select, textarea', form).forEach(function (el) {
                    el.classList.remove('is-invalid');
                });
            }

            function applyClientErrors(invalidEls) {
                invalidEls.forEach(function (el) {
                    el.classList.add('is-invalid');

                    const name = el.getAttribute('name');
                    const span = form.querySelector(`span[data-valmsg-for="${name}"]`);

                    if (span) {
                        span.textContent = el.validationMessage || 'Campo inválido';
                    }
                });
            }

            function setBtnState(state) {
                btn.classList.toggle('is-loading', state === 'loading');
                btn.classList.toggle('is-success', state === 'success');
                btn.setAttribute('aria-busy', state === 'loading' ? 'true' : 'false');

                const txt = btn.querySelector('.btn-text');

                if (!txt) return;

                if (state === 'loading') {
                    txt.textContent = btn.dataset.textLoading || 'Enviando...';
                } else if (state === 'success') {
                    txt.textContent = btn.dataset.textSuccess || 'Pronto!';
                } else {
                    txt.textContent = btn.dataset.textDefault || 'Finalizar cadastro';
                }
            }

            let submitted = false;

            form.addEventListener('submit', function (event) {
                if (submitted) {
                    event.preventDefault();
                    return false;
                }

                if (!form.checkValidity()) {
                    event.preventDefault();
                    clearClientErrors();

                    const invalidEls = all('input, select, textarea', form).filter(function (el) {
                        return el.willValidate && !el.checkValidity();
                    });

                    applyClientErrors(invalidEls);
                    invalidEls[0]?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    invalidEls[0]?.focus({ preventScroll: true });

                    return false;
                }

                submitted = true;
                setBtnState('loading');
                btn.disabled = true;
                lock.classList.add('show');

                setTimeout(function () {
                    if (document.visibilityState === 'visible') {
                        submitted = false;
                        btn.disabled = false;
                        setBtnState('default');
                        lock.classList.remove('show');
                    }
                }, 8000);
            });

            window.addEventListener('beforeunload', function () {
                setBtnState('success');
            });
        })();

        (function () {
            const buscarCepButton = document.getElementById('buscarCepCadastro');
            const cep = document.getElementById('cep');

            buscarCepButton?.addEventListener('click', function () {
                cep?.dispatchEvent(new Event('blur', { bubbles: true }));
                cep?.focus();
            });
        })();

        (function () {
            const isTouch = matchMedia('(pointer: coarse)').matches;

            if (!isTouch) return;

            document.addEventListener('focusin', function (event) {
                if (!event.target.closest('.customer-register-form')) return;
                if (!event.target.matches('input, textarea, select')) return;

                setTimeout(function () {
                    try {
                        event.target.scrollIntoView({ block: 'center', inline: 'nearest' });
                    } catch { }
                }, 120);
            });
        })();
    </script>

    <partial name="_ValidationScriptsPartial" />
}