@model WebApplicationPods.Models.AuthLoginViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Acesse sua conta";
    ViewData["HideStoreHeader"] = true;
    ViewData["BodyClass"] = "client-login-page";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="client-login-shell">
    <main class="client-login-phone">
        <header class="client-login-appbar">
            <a asp-controller="Home" asp-action="Index" class="client-login-back" aria-label="Voltar para a loja">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <strong>Acesse sua conta</strong>
        </header>

        <section class="client-login-card">
            <div class="client-login-icon">
                <i class="fa-solid fa-mobile-screen"></i>
            </div>

            <div class="client-login-title">
                <span>Identificação</span>
                <h1>Entre pelo telefone</h1>
                <p>Informe seu número com DDD para continuar seu pedido.</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="client-login-validation"></div>

            <form asp-action="Login" method="post" class="client-login-form" asp-antiforgery="true" novalidate>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="client-login-field">
                    <label asp-for="Telefone">Telefone</label>
                    <div class="client-login-input">
                        <i class="fa-solid fa-phone"></i>
                        <input asp-for="Telefone"
                               id="telefone"
                               placeholder="(11) 98765-4321"
                               inputmode="numeric"
                               autocomplete="tel-national"
                               pattern="[\d\s\(\)\-]+"
                               required />
                    </div>
                    <small>Informe seu telefone com DDD</small>
                    <span asp-validation-for="Telefone" class="client-login-field-validation"></span>
                </div>

                <button type="submit" class="client-login-submit">
                    Continuar
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

                <a href="@Url.Action("Index", "Home")" class="client-login-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    Voltar para a loja
                </a>
            </form>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.6/jquery.inputmask.min.js"></script>

    <script>
        (function () {
            const el = document.getElementById('telefone');

            if (!el) return;

            if (window.jQuery && jQuery.fn && jQuery.fn.inputmask) {
                jQuery(el).inputmask({ mask: '(99) 99999-9999' });
                return;
            }

            function onlyDigits(value) {
                return (value || '').replace(/\D+/g, '');
            }

            el.addEventListener('input', function () {
                const value = onlyDigits(el.value).slice(0, 11);

                if (value.length > 10) {
                    el.value = `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
                    return;
                }

                if (value.length > 6) {
                    el.value = `(${value.slice(0, 2)}) ${value.slice(2, 6)}-${value.slice(6)}`;
                    return;
                }

                if (value.length > 2) {
                    el.value = `(${value.slice(0, 2)}) ${value.slice(2)}`;
                    return;
                }

                if (value.length > 0) {
                    el.value = `(${value}`;
                }
            });
        })();

        (function () {
            const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);

            if (!isIOS) return;

            document.addEventListener('focusin', function (event) {
                if (!event.target.matches('input, textarea, select')) return;

                setTimeout(function () {
                    try {
                        event.target.scrollIntoView({ block: 'center', inline: 'nearest' });
                    } catch { }
                }, 140);
            });

            document.addEventListener('focusout', function () {
                setTimeout(function () {
                    window.scrollTo({ top: 0 });
                }, 0);
            });
        })();

        (function () {
            function applyViewportHeight() {
                let height = window.visualViewport ? visualViewport.height : window.innerHeight;

                if (!height || height < 100) {
                    height = window.innerHeight;
                }

                document.documentElement.style.setProperty('--client-login-vh', height + 'px');
            }

            applyViewportHeight();
            window.addEventListener('resize', applyViewportHeight);

            if (window.visualViewport) {
                visualViewport.addEventListener('resize', applyViewportHeight);
                visualViewport.addEventListener('scroll', applyViewportHeight);
            }
        })();
    </script>
}