@model WebApplicationPods.Models.ConfiguracoesViewModel

@{
    ViewData["Title"] = "Configurações";
}

@section Styles {
    <link rel="stylesheet" href="~/css/configuracoes.css" asp-append-version="true" />
}

<div class="cfg-page">
    <div class="cfg-header">
        <div>
            <h1>Configurações</h1>
            <p>Gerencie preferências da conta e aparência do sistema.</p>
        </div>

        <a asp-controller="Home" asp-action="Index" class="cfg-btn cfg-btn-light">
            <i class="fas fa-arrow-left"></i>
            Voltar
        </a>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="cfg-alert cfg-alert-success">
            @TempData["MensagemSucesso"]
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="cfg-alert cfg-alert-danger">
            @TempData["MensagemErro"]
        </div>
    }

    <div class="cfg-grid">
        <section class="cfg-card">
            <div class="cfg-card-head">
                <div>
                    <h2>Aparência</h2>
                    <p>Escolha como deseja visualizar o sistema.</p>
                </div>
                <i class="fas fa-palette"></i>
            </div>

            <div class="cfg-theme-options">
                <button type="button" class="cfg-theme-option" data-theme-option="light">
                    <span class="cfg-theme-preview cfg-theme-preview-light"></span>
                    <strong>Claro</strong>
                    <small>Visual limpo e iluminado</small>
                </button>

                <button type="button" class="cfg-theme-option" data-theme-option="dark">
                    <span class="cfg-theme-preview cfg-theme-preview-dark"></span>
                    <strong>Escuro</strong>
                    <small>Melhor para ambientes escuros</small>
                </button>
            </div>
        </section>

        <section class="cfg-card">
            <div class="cfg-card-head">
                <div>
                    <h2>Conta</h2>
                    <p>Atualize seu nome de exibição.</p>
                </div>
                <i class="fas fa-user"></i>
            </div>

            <form asp-action="AtualizarPerfil" method="post" class="cfg-form">
                @Html.AntiForgeryToken()

                <div class="cfg-field">
                    <label asp-for="NomeUsuario"></label>
                    <input asp-for="NomeUsuario" class="cfg-input" placeholder="Seu nome" />
                    <span asp-validation-for="NomeUsuario" class="text-danger small"></span>
                </div>

                <div class="cfg-field">
                    <label>Email</label>
                    <input value="@Model.Email" class="cfg-input" disabled />
                </div>

                <button type="submit" class="cfg-btn cfg-btn-primary">
                    <i class="fas fa-save"></i>
                    Salvar conta
                </button>
            </form>
        </section>

        <section class="cfg-card">
            <div class="cfg-card-head">
                <div>
                    <h2>Senha</h2>
                    <p>Altere sua senha de acesso.</p>
                </div>
                <i class="fas fa-lock"></i>
            </div>

            <form asp-action="AlterarSenha" method="post" class="cfg-form">
                @Html.AntiForgeryToken()

                <div class="cfg-field">
                    <label asp-for="SenhaAtual">Senha atual</label>
                    <input asp-for="SenhaAtual" class="cfg-input" autocomplete="current-password" />
                </div>

                <div class="cfg-field">
                    <label asp-for="NovaSenha">Nova senha</label>
                    <input asp-for="NovaSenha" class="cfg-input" autocomplete="new-password" />
                </div>

                <div class="cfg-field">
                    <label asp-for="ConfirmarSenha">Confirmar nova senha</label>
                    <input asp-for="ConfirmarSenha" class="cfg-input" autocomplete="new-password" />
                </div>

                <button type="submit" class="cfg-btn cfg-btn-primary">
                    <i class="fas fa-key"></i>
                    Alterar senha
                </button>
            </form>
        </section>

        <section class="cfg-card">
            <div class="cfg-card-head">
                <div>
                    <h2>Loja</h2>
                    <p>Dados básicos da loja vinculada.</p>
                </div>
                <i class="fas fa-store"></i>
            </div>

            <div class="cfg-store-box">
                <span>Loja atual</span>
                <strong>@(Model.NomeLoja ?? "Conveniência")</strong>
                <small>A edição completa dos dados da loja será feita no próximo passo.</small>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/configuracoes.js" asp-append-version="true"></script>
}