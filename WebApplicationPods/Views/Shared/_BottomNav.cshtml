@using WebApplicationPods.Infra

@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
    var isLojista = User.IsInRole("Lojista");
    var isEntregador = User.IsInRole("Entregador");

    var areaAtual = (ViewContext.RouteData.Values["area"]?.ToString() ?? "");
    var controllerAtual = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");

    string Active(string area, string controller)
    {
        var areaOk = string.Equals(areaAtual, area ?? "", StringComparison.OrdinalIgnoreCase);
        var controllerOk = string.Equals(controllerAtual, controller ?? "", StringComparison.OrdinalIgnoreCase);

        return areaOk && controllerOk ? "active" : "";
    }
}

<nav class="mobile-bottom-nav" aria-label="Navegação inferior">
    @if (isAdmin)
    {
        <a class="bottom-nav-item @Active(AppAreas.Admin, "Dashboard")"
           asp-area="@AppAreas.Admin"
           asp-controller="Dashboard"
           asp-action="Index">
            <i class="fa-solid fa-house"></i>
            <span>Início</span>
        </a>

        <a class="bottom-nav-item @Active(AppAreas.Admin, "Lojas")"
           asp-area="@AppAreas.Admin"
           asp-controller="Lojas"
           asp-action="Index">
            <i class="fa-solid fa-store"></i>
            <span>Lojas</span>
        </a>

        <a class="bottom-nav-item @Active(AppAreas.Admin, "Lojistas")"
           asp-area="@AppAreas.Admin"
           asp-controller="Lojistas"
           asp-action="Index">
            <i class="fa-solid fa-users"></i>
            <span>Usuários</span>
        </a>

        <a class="bottom-nav-item @Active("", "Conta")"
           asp-area=""
           asp-controller="Conta"
           asp-action="Perfil">
            <i class="fa-regular fa-user"></i>
            <span>Perfil</span>
        </a>
    }
    else if (isLojista)
    {
        <a class="bottom-nav-item @Active("", "PainelLojista")"
           asp-area=""
           asp-controller="PainelLojista"
           asp-action="Index">
            <i class="fa-solid fa-house"></i>
            <span>Início</span>
        </a>

        <a class="bottom-nav-item @Active("", "PedidosAdmin")"
           asp-area=""
           asp-controller="PedidosAdmin"
           asp-action="Index">
            <i class="fa-regular fa-clipboard"></i>
            <span>Pedidos</span>
        </a>

        <a class="bottom-nav-item @Active("", "Estoque")"
           asp-area=""
           asp-controller="Estoque"
           asp-action="Index">
            <i class="fa-solid fa-cube"></i>
            <span>Estoque</span>
        </a>

        <a class="bottom-nav-item @Active("", "Conta")"
           asp-area=""
           asp-controller="Conta"
           asp-action="Perfil">
            <i class="fa-regular fa-user"></i>
            <span>Perfil</span>
        </a>
    }
    else if (isEntregador)
    {
        <a class="bottom-nav-item @Active("", "Entregador")"
           asp-area=""
           asp-controller="Entregador"
           asp-action="Index">
            <i class="fa-solid fa-route"></i>
            <span>Entregas</span>
        </a>

        <a class="bottom-nav-item @Active("", "Conta")"
           asp-area=""
           asp-controller="Conta"
           asp-action="Perfil">
            <i class="fa-regular fa-user"></i>
            <span>Perfil</span>
        </a>
    }
    else
    {
        <a class="bottom-nav-item @Active("", "Home")"
           asp-area=""
           asp-controller="Home"
           asp-action="Index">
            <i class="fa-solid fa-house"></i>
            <span>Início</span>
        </a>

        <a class="bottom-nav-item @Active("", "Pedido")"
           asp-area=""
           asp-controller="Pedido"
           asp-action="Ultimo">
            <i class="fa-regular fa-clipboard"></i>
            <span>Pedidos</span>
        </a>

        <a class="bottom-nav-item bottom-cart @Active("", "Carrinho")"
           asp-area=""
           asp-controller="Carrinho"
           asp-action="Index">
            <span class="bottom-nav-icon-wrap">
                <i class="fa-solid fa-cart-shopping"></i>
                <span id="cart-badge-mobile-bottom" class="bottom-nav-badge js-cart-badge">0</span>
                <span id="cart-new-dot" class="bottom-nav-dot"></span>
            </span>
            <span>Carrinho</span>
        </a>

        <a class="bottom-nav-item @Active("", "Conta")"
           asp-area=""
           asp-controller="Conta"
           asp-action="Perfil">
            <i class="fa-regular fa-user"></i>
            <span>Perfil</span>
        </a>
    }
</nav>