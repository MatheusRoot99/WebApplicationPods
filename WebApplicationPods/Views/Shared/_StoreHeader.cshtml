@using Microsoft.AspNetCore.Identity
@using WebApplicationPods.Models
@inject UserManager<ApplicationUser> UserManager

@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var usuarioLogado = isAuth ? await UserManager.GetUserAsync(User!) : null;
    var nomeUsuario = !string.IsNullOrWhiteSpace(usuarioLogado?.Nome)
        ? usuarioLogado!.Nome
        : (User?.Identity?.Name ?? "Perfil");
}

<header class="store-header">
    <div class="store-header-top">
        <button class="store-icon-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
            <i class="fa-solid fa-bars"></i>
        </button>

        <a class="store-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="store-brand-icon">
                <i class="fa-solid fa-store"></i>
            </span>
            <span>
                <strong>Conveniência</strong>
                <small><span></span> Aberto até 23h59</small>
            </span>
        </a>

        <form class="store-search d-none d-md-flex" asp-area="" asp-controller="Home" asp-action="Index" method="get">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="q" placeholder="Buscar produtos" autocomplete="off" />
        </form>

        <div class="store-actions">
            <a class="store-icon-button store-cart-button" asp-area="" asp-controller="Carrinho" asp-action="Index" aria-label="Carrinho">
                <i class="fa-solid fa-cart-shopping"></i>
                <span class="js-cart-badge"></span>
            </a>

            @if (isAuth)
            {
                <a class="store-profile-link d-none d-sm-inline-flex" asp-area="" asp-controller="Conta" asp-action="Perfil">
                    <i class="fa-regular fa-user"></i>
                    <span>@nomeUsuario</span>
                </a>
            }
            else
            {
                <a class="store-profile-link d-none d-sm-inline-flex" asp-area="" asp-controller="Conta" asp-action="Login">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    <span>Entrar</span>
                </a>
            }
        </div>
    </div>

    <div class="store-mobile-search d-md-none">
        <form asp-area="" asp-controller="Home" asp-action="Index" method="get">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="search" name="q" placeholder="Buscar produtos" autocomplete="off" />
        </form>
    </div>

    <nav class="store-category-nav" aria-label="Categorias">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="active">Todos</a>
        <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="pods">Pods</a>
        <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="bebidas">Bebidas</a>
        <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="kits">Kits</a>
        <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-categoria="promocoes">Promoções</a>
    </nav>
</header>
