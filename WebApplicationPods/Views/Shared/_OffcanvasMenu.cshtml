@using WebApplicationPods.Infra

@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
    var isLojista = User.IsInRole("Lojista");
    var isEntregador = User.IsInRole("Entregador");

    var areaAtual = (ViewContext.RouteData.Values["area"]?.ToString() ?? "");
    var controllerAtual = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var actionAtual = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    string Active(string area, string controller, string action = "")
    {
        var areaOk = string.Equals(areaAtual, area ?? "", StringComparison.OrdinalIgnoreCase);
        var controllerOk = string.Equals(controllerAtual, controller ?? "", StringComparison.OrdinalIgnoreCase);
        var actionOk = string.IsNullOrWhiteSpace(action) || string.Equals(actionAtual, action, StringComparison.OrdinalIgnoreCase);

        return areaOk && controllerOk && actionOk ? "active" : "";
    }
}

<div class="offcanvas offcanvas-start mobile-menu" tabindex="-1" id="mobileMenu" aria-labelledby="mobileMenuLabel">
    <div class="mobile-menu-header">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="mobile-menu-brand">
            <span class="mobile-menu-brand-icon">
                <i class="fa-solid fa-store"></i>
            </span>
            <span>
                <strong id="mobileMenuLabel">Conveniência</strong>
                <small><span></span> Aberto</small>
            </span>
        </a>

        <button type="button" class="mobile-menu-close" data-bs-dismiss="offcanvas" aria-label="Fechar">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <div class="mobile-menu-body">
        @if (isAdmin)
        {
            <div class="mobile-menu-section">
                <span>Admin</span>

                <a class="mobile-menu-link @Active(AppAreas.Admin, "Dashboard")"
                   asp-area="@AppAreas.Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <i class="fa-solid fa-chart-line"></i>
                    Dashboard
                </a>

                <a class="mobile-menu-link @Active(AppAreas.Admin, "Lojas")"
                   asp-area="@AppAreas.Admin"
                   asp-controller="Lojas"
                   asp-action="Index">
                    <i class="fa-solid fa-store"></i>
                    Lojas
                </a>

                <a class="mobile-menu-link @Active(AppAreas.Admin, "Lojistas")"
                   asp-area="@AppAreas.Admin"
                   asp-controller="Lojistas"
                   asp-action="Index">
                    <i class="fa-solid fa-users-gear"></i>
                    Usuários
                </a>
            </div>
        }

        @if (isLojista)
        {
            <div class="mobile-menu-section">
                <span>Operação</span>

                <a class="mobile-menu-link @Active("", "PainelLojista")"
                   asp-area=""
                   asp-controller="PainelLojista"
                   asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    Dashboard
                </a>

                <a class="mobile-menu-link @Active("", "PedidosAdmin")"
                   asp-area=""
                   asp-controller="PedidosAdmin"
                   asp-action="Index">
                    <i class="fa-regular fa-clipboard"></i>
                    Pedidos
                </a>

                <a class="mobile-menu-link @Active("", "Estoque")"
                   asp-area=""
                   asp-controller="Estoque"
                   asp-action="Index">
                    <i class="fa-solid fa-cube"></i>
                    Estoque
                </a>

                <a class="mobile-menu-link @Active("", "PedidosAdmin", "Relatorio")"
                   asp-area=""
                   asp-controller="PedidosAdmin"
                   asp-action="Relatorio">
                    <i class="fa-solid fa-chart-column"></i>
                    Relatórios
                </a>
            </div>

            <div class="mobile-menu-section">
                <span>Catálogo</span>

                <a class="mobile-menu-link @Active(AppAreas.Lojista, "Produto")"
                   asp-area="@AppAreas.Lojista"
                   asp-controller="Produto"
                   asp-action="Index">
                    <i class="fa-solid fa-box-open"></i>
                    Produtos
                </a>

                <a class="mobile-menu-link @Active("", "Categorias")"
                   asp-area=""
                   asp-controller="Categorias"
                   asp-action="Index">
                    <i class="fa-regular fa-tag"></i>
                    Categorias
                </a>
            </div>

            <div class="mobile-menu-section">
                <span>Equipe</span>

                <a class="mobile-menu-link @Active(AppAreas.Lojista, "Entregadores")"
                   asp-area="@AppAreas.Lojista"
                   asp-controller="Entregadores"
                   asp-action="Index">
                    <i class="fa-solid fa-truck-fast"></i>
                    Entregadores
                </a>
            </div>
        }

        @if (isEntregador && !isLojista)
        {
            <div class="mobile-menu-section">
                <span>Entrega</span>

                <a class="mobile-menu-link @Active("", "Entregador")"
                   asp-area=""
                   asp-controller="Entregador"
                   asp-action="Index">
                    <i class="fa-solid fa-route"></i>
                    Minhas entregas
                </a>
            </div>
        }

        @if (!isAdmin && !isLojista && !isEntregador)
        {
            <div class="mobile-menu-section">
                <span>Loja</span>

                <a class="mobile-menu-link @Active("", "Home")"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    Início
                </a>

                <a class="mobile-menu-link @Active("", "Pedido")"
                   asp-area=""
                   asp-controller="Pedido"
                   asp-action="Ultimo">
                    <i class="fa-regular fa-clipboard"></i>
                    Pedidos
                </a>

                <a class="mobile-menu-link @Active("", "Carrinho")"
                   asp-area=""
                   asp-controller="Carrinho"
                   asp-action="Index">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Carrinho
                </a>
            </div>
        }

        <div class="mobile-menu-section">
            <span>Conta</span>

            @if (isAuth)
            {
                <a class="mobile-menu-link @Active("", "Conta")"
                   asp-area=""
                   asp-controller="Conta"
                   asp-action="Perfil">
                    <i class="fa-regular fa-user"></i>
                    Perfil
                </a>

                @if (isLojista)
                {
                    <a class="mobile-menu-link @Active(AppAreas.Lojista, "Loja")"
                       asp-area="@AppAreas.Lojista"
                       asp-controller="Loja"
                       asp-action="Editar">
                        <i class="fa-solid fa-gear"></i>
                        Configurações
                    </a>
                }

                <form asp-area="" asp-controller="Conta" asp-action="Logout" method="post" class="mobile-menu-logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="mobile-menu-link mobile-menu-button">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        Sair
                    </button>
                </form>
            }
            else
            {
                <a class="mobile-menu-link @Active("", "Conta", "Login")"
                   asp-area=""
                   asp-controller="Conta"
                   asp-action="Login">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    Entrar
                </a>
            }
        </div>
    </div>
</div>