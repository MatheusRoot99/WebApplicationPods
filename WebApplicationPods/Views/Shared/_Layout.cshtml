@using WebApplicationPods.Infra

@{
    var title = ViewData["Title"]?.ToString() ?? "Conveniência";
    var hideChrome = ViewData["HideChrome"] as bool? == true;
    var hideStoreHeader = ViewData["HideStoreHeader"] as bool? == true;
    var bodyClass = ViewData["BodyClass"]?.ToString() ?? "";

    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
    var isLojista = User.IsInRole("Lojista");
    var isEntregador = User.IsInRole("Entregador");

    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var actionAtual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var areaAtual = ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    var isPainel = isAdmin || isLojista || isEntregador;
    var nomeUsuario = User?.Identity?.Name ?? "Usuário";
    var perfilUsuario = isAdmin ? "Admin" : isLojista ? "Lojista" : isEntregador ? "Entregador" : "Cliente";
}

<!DOCTYPE html>
<html lang="pt-br" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1, maximum-scale=1, minimum-scale=1, user-scalable=no, viewport-fit=cover" />
    <title>@title - Conveniência</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/_BottomNav.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-redesign.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@bodyClass @(isPainel ? "panel-shell-page" : "storefront-shell-page")">
    @if (hideChrome)
    {
        <main class="auth-main">
            @RenderBody()
        </main>
    }
    else
    {
        <div class="d-flex" id="wrapper">
            @if (isPainel)
            {
                <partial name="_Sidebar" />
            }

            <div id="page-content-wrapper">
                @if (isPainel)
                {
                    <header class="panel-topbar">
                        <div class="panel-topbar-left">
                            <button class="panel-icon-button d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu">
                                <i class="fa-solid fa-bars"></i>
                            </button>

                            <button class="panel-icon-button d-none d-lg-inline-flex" type="button" id="desktopSidebarToggle">
                                <i class="fa-solid fa-bars"></i>
                            </button>

                            <nav class="panel-breadcrumb d-none d-md-flex" aria-label="breadcrumb">
                                <a asp-area="" asp-controller="Home" asp-action="Index">Painel</a>
                                <i class="fa-solid fa-chevron-right"></i>
                                <span>@title</span>
                            </nav>
                        </div>

                        <form class="panel-search d-none d-md-flex" asp-area="" asp-controller="Home" asp-action="Index" method="get">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="search" name="q" placeholder="Buscar pedido, produto..." autocomplete="off" />
                        </form>

                        <div class="panel-topbar-actions">
                            <button class="panel-notification-button" type="button" aria-label="Notificações">
                                <i class="fa-regular fa-bell"></i>
                                <span id="notif-badge">3</span>
                            </button>

                            <a class="panel-user-link" asp-area="" asp-controller="Conta" asp-action="Perfil">
                                <span class="panel-user-avatar">
                                    <i class="fa-regular fa-user"></i>
                                </span>
                                <span class="panel-user-text d-none d-sm-flex">
                                    <strong>@nomeUsuario</strong>
                                    <small>@perfilUsuario</small>
                                </span>
                                <i class="fa-solid fa-chevron-down d-none d-sm-inline"></i>
                            </a>
                        </div>
                    </header>
                }
                else if (!hideStoreHeader)
                {
                    <partial name="_StoreHeader" />
                }

                <main id="page-content" class="page-content container-fluid">
                    <div class="page-hero">
                        <div class="app-shell">
                            @RenderBody()
                        </div>
                    </div>
                </main>
            </div>
        </div>

        <partial name="_OffcanvasMenu" />
        <partial name="_BottomNav" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (document.querySelector('.mobile-bottom-nav')) {
                document.body.classList.add('has-bottom-nav');
            }

            const wrapper = document.getElementById('wrapper');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const desktopSidebarToggle = document.getElementById('desktopSidebarToggle');

            function toggleSidebar() {
                if (wrapper) {
                    wrapper.classList.toggle('sidebar-collapsed');
                }
            }

            if (sidebarToggle) {
                sidebarToggle.addEventListener('click', toggleSidebar);
            }

            if (desktopSidebarToggle) {
                desktopSidebarToggle.addEventListener('click', toggleSidebar);
            }

            const badges = document.querySelectorAll('.js-cart-badge');
            const count = parseInt(localStorage.getItem('cart_count') || '0', 10) || 0;

            badges.forEach(function (badge) {
            if (count > 0) {
                badge.textContent = String(count);
                badge.classList.add('show');
            } else {
                badge.textContent = '';
                badge.classList.remove('show');
            }
        });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>