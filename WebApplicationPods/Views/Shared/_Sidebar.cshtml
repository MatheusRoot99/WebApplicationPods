@using WebApplicationPods.Infra

@{
    var isAuth = User?.Identity?.IsAuthenticated ?? false;
    var isAdmin = User.IsInRole("Admin");
    var isLojista = User.IsInRole("Lojista");
    var isEntregador = User.IsInRole("Entregador");

    var areaAtual = (ViewContext.RouteData.Values["area"]?.ToString() ?? "");
    var controllerAtual = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var actionAtual = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    string Active(string area, string controller, string action = "")
    {
        var areaOk = string.Equals(areaAtual, area ?? "", StringComparison.OrdinalIgnoreCase);
        var controllerOk = string.Equals(controllerAtual, controller ?? "", StringComparison.OrdinalIgnoreCase);
        var actionOk = string.IsNullOrWhiteSpace(action) || string.Equals(actionAtual, action, StringComparison.OrdinalIgnoreCase);

        return areaOk && controllerOk && actionOk ? "active" : "";
    }

    var nomeUsuario = User?.Identity?.Name ?? "Usuário";
    var perfil = isAdmin ? "Admin" : isLojista ? "Lojista" : isEntregador ? "Entregador" : "Cliente";
}

<aside id="sidebar-wrapper" class="app-sidebar">
    <div class="sidebar-brand">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="sidebar-brand-link">
            <span class="sidebar-brand-icon">
                <i class="fa-solid fa-store"></i>
            </span>
            <span class="sidebar-brand-text">
                <strong>Conveniência</strong>
                <small><span></span> Aberto</small>
            </span>
        </a>
    </div>

    <nav class="sidebar-nav">
        @if (isAdmin)
        {
            <div class="sidebar-section">
                <span class="sidebar-section-title">Admin</span>

                <a class="sidebar-link @Active(AppAreas.Admin, "Dashboard")"
                   asp-area="@AppAreas.Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>Dashboard</span>
                </a>

                <a class="sidebar-link @Active(AppAreas.Admin, "Lojas")"
                   asp-area="@AppAreas.Admin"
                   asp-controller="Lojas"
                   asp-action="Index">
                    <i class="fa-solid fa-store"></i>
                    <span>Lojas</span>
                </a>

                <a class="sidebar-link @Active(AppAreas.Admin, "Lojistas")"
                   asp-area="@AppAreas.Admin"
                   asp-controller="Lojistas"
                   asp-action="Index">
                    <i class="fa-solid fa-users-gear"></i>
                    <span>Usuários</span>
                </a>
            </div>
        }

        @if (isLojista)
        {
            <div class="sidebar-section">
                <span class="sidebar-section-title">Operação</span>

                <a class="sidebar-link @Active("", "PainelLojista")"
                   asp-area=""
                   asp-controller="PainelLojista"
                   asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    <span>Dashboard</span>
                </a>

                <a class="sidebar-link @Active("", "PedidosAdmin")"
                   asp-area=""
                   asp-controller="PedidosAdmin"
                   asp-action="Index">
                    <i class="fa-regular fa-clipboard"></i>
                    <span>Pedidos</span>
                </a>

                <a class="sidebar-link @Active("", "Estoque")"
                   asp-area=""
                   asp-controller="Estoque"
                   asp-action="Index">
                    <i class="fa-solid fa-cube"></i>
                    <span>Estoque</span>
                </a>

                <a class="sidebar-link @Active("", "PedidosAdmin", "Relatorio")"
                   asp-area=""
                   asp-controller="PedidosAdmin"
                   asp-action="Relatorio">
                    <i class="fa-solid fa-chart-column"></i>
                    <span>Relatórios</span>
                </a>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-section-title">Catálogo</span>

                <a class="sidebar-link @Active(AppAreas.Lojista, "Produto")"
                   asp-area="@AppAreas.Lojista"
                   asp-controller="Produto"
                   asp-action="Index">
                    <i class="fa-solid fa-box-open"></i>
                    <span>Produtos</span>
                </a>

                <a class="sidebar-link @Active("", "Categorias")"
                   asp-area=""
                   asp-controller="Categorias"
                   asp-action="Index">
                    <i class="fa-regular fa-tag"></i>
                    <span>Categorias</span>
                </a>
            </div>

            <div class="sidebar-section">
                <span class="sidebar-section-title">Equipe</span>

                <a class="sidebar-link @Active(AppAreas.Lojista, "Entregadores")"
                   asp-area="@AppAreas.Lojista"
                   asp-controller="Entregadores"
                   asp-action="Index">
                    <i class="fa-solid fa-truck-fast"></i>
                    <span>Entregadores</span>
                </a>

                <a class="sidebar-link @Active("", "Entregador")"
                   asp-area=""
                   asp-controller="Entregador"
                   asp-action="Index">
                    <i class="fa-solid fa-route"></i>
                    <span>Minhas entregas</span>
                </a>
            </div>
        }

        @if (isEntregador && !isLojista)
        {
            <div class="sidebar-section">
                <span class="sidebar-section-title">Entrega</span>

                <a class="sidebar-link @Active("", "Entregador")"
                   asp-area=""
                   asp-controller="Entregador"
                   asp-action="Index">
                    <i class="fa-solid fa-route"></i>
                    <span>Minhas entregas</span>
                </a>
            </div>
        }

        @if (!isAdmin && !isLojista && !isEntregador)
        {
            <div class="sidebar-section">
                <span class="sidebar-section-title">Loja</span>

                <a class="sidebar-link @Active("", "Home")"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="fa-solid fa-house"></i>
                    <span>Início</span>
                </a>

                <a class="sidebar-link @Active("", "Pedido")"
                   asp-area=""
                   asp-controller="Pedido"
                   asp-action="Ultimo">
                    <i class="fa-regular fa-clipboard"></i>
                    <span>Pedidos</span>
                </a>

                <a class="sidebar-link @Active("", "Carrinho")"
                   asp-area=""
                   asp-controller="Carrinho"
                   asp-action="Index">
                    <i class="fa-solid fa-cart-shopping"></i>
                    <span>Carrinho</span>
                </a>
            </div>
        }

        <div class="sidebar-section">
            <span class="sidebar-section-title">Conta</span>

            @if (isAuth)
            {
                <a class="sidebar-link @Active("", "Conta")"
                   asp-area=""
                   asp-controller="Conta"
                   asp-action="Perfil">
                    <i class="fa-regular fa-user"></i>
                    <span>Perfil</span>
                </a>

                @if (isLojista)
                {
                    <a class="sidebar-link @Active(AppAreas.Lojista, "Loja")"
                       asp-area="@AppAreas.Lojista"
                       asp-controller="Loja"
                       asp-action="Editar">
                        <i class="fa-solid fa-gear"></i>
                        <span>Configurações</span>
                    </a>
                }

                @if (isAdmin)
                {
                    <a class="sidebar-link @Active(AppAreas.Admin, "Configuracoes")"
                       asp-area="@AppAreas.Admin"
                       asp-controller="Configuracoes"
                       asp-action="Index">
                        <i class="fa-solid fa-gear"></i>
                        <span>Configurações</span>
                    </a>
                }

                <form asp-area="" asp-controller="Conta" asp-action="Logout" method="post" class="sidebar-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-link sidebar-link-button">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Sair</span>
                    </button>
                </form>
            }
            else
            {
                <a class="sidebar-link @Active("", "Conta", "Login")"
                   asp-area=""
                   asp-controller="Conta"
                   asp-action="Login">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    <span>Entrar</span>
                </a>
            }
        </div>
    </nav>

    <div class="sidebar-footer">
        <div class="sidebar-user">
            <span class="sidebar-user-avatar">
                <i class="fa-regular fa-user"></i>
            </span>
            <span>
                <strong>@nomeUsuario</strong>
                <small>@perfil</small>
            </span>
        </div>

        <button type="button" class="sidebar-collapse-button" id="sidebarToggle">
            <i class="fa-solid fa-chevron-left"></i>
            <span>Recolher</span>
        </button>
    </div>
</aside>