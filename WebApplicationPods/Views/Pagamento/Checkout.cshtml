@using WebApplicationPods.Enum
@using System.Globalization
@model WebApplicationPods.Models.PaymentModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Pagamento";
    ViewData["HideStoreHeader"] = true;

    var ptBR = CultureInfo.GetCultureInfo("pt-BR");
    var isPaid = Model.Status == PaymentStatus.Paid;
    var afToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var orderToken = ViewBag.OrderToken as string ?? Model.Pedido?.RastreioToken;
    var trackUrl = Url.Action("Acompanhar", "Pedido", new { id = Model.PedidoId, t = orderToken });

    var items = ViewBag.Itens as IEnumerable<dynamic>;
    var resumo = ViewBag.PedidoResumo;

    decimal subtotal = resumo?.Subtotal ?? Model.Amount;
    decimal frete = resumo?.Frete ?? 0m;
    decimal desconto = resumo?.Desconto ?? 0m;
    decimal total = subtotal + frete;
}

@section Styles {
    <link rel="stylesheet" href="~/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div id="checkout-page" class="checkout-page">
    <header class="checkout-header">
        <a asp-controller="Carrinho" asp-action="Index" class="checkout-back" aria-label="Voltar para o carrinho">
            <i class="fas fa-arrow-left"></i>
        </a>

        <div class="checkout-header-title">
            @*<span>Pedido #@Model.PedidoId</span>*@
            <h1>Pagamento</h1>
            <p>Finalize o pagamento para confirmarmos seu pedido.</p>
        </div>

        <div class="checkout-safe-badge">
            <i class="fas fa-shield-alt"></i>
            <span>Seguro</span>
        </div>
    </header>

    <section id="checkout-status" class="checkout-status">
        <div class="checkout-status-copy">
            <strong>Status do pagamento</strong>
            <span id="statusBadge" class="checkout-status-pill">Status: @Model.Status</span>
        </div>

        <div class="status-bar" aria-hidden="true">
            <div id="statusFill" class="fill"></div>
        </div>
    </section>

    <div class="checkout-layout">
        <main class="checkout-main">
            <section id="checkout-main-card" class="checkout-card">
                <div class="checkout-card-head">
                    <div>
                        <span class="checkout-eyebrow">Forma de pagamento</span>
                        <h2>Finalize seu pagamento</h2>
                    </div>

                    <div class="checkout-amount-chip">
                        <span>Total</span>
                        <strong>@Model.Amount.ToString("C", ptBR)</strong>
                    </div>
                </div>

                <div class="checkout-card-body">
                    @if (Model.Metodo == PaymentMethod.Pix)
                    {
                        <section id="pix-section" class="checkout-payment-section">
                            <div class="payment-title-row">
                                <div class="payment-icon is-pix">
                                    <i class="fas fa-qrcode"></i>
                                </div>

                                <div>
                                    <h3>Pix</h3>
                                    <p>Escaneie o QR Code ou use o código copia e cola.</p>
                                </div>
                            </div>

                            <div class="pix-grid">
                                <div class="pix-qr-panel">
                                    <div id="pix-qr-container" class="pix-qr-wrap">
                                        @if (!string.IsNullOrEmpty(Model.PixQrBase64Png))
                                        {
                                            <img id="pix-qr-img"
                                                 src="data:image/png;base64,@Model.PixQrBase64Png"
                                                 alt="QR Code Pix" />
                                        }
                                        else
                                        {
                                            <div id="pix-qr" class="qr-box" aria-label="QR Code do Pix">
                                                QR Code
                                            </div>
                                        }
                                    </div>

                                    <div class="pix-meta">
                                        <div class="pix-amount">
                                            <span>Valor</span>
                                            <strong>@Model.Amount.ToString("C", ptBR)</strong>
                                        </div>

                                        @if (Model.ExpiresAt.HasValue)
                                        {
                                            <div class="pix-expire">
                                                <i class="fas fa-clock"></i>
                                                <span id="pix-timer"
                                                      data-exp="@Model.ExpiresAt.Value.ToUniversalTime().ToString("o")">
                                                    Expira em <strong id="pixCountdownTimer">--:--</strong>
                                                </span>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="pix-actions">
                                    <label class="checkout-label" for="pixCopyPaste">Copia e cola</label>

                                    <div class="checkout-copy-control">
                                        <input class="checkout-input"
                                               value="@Model.PixQrData"
                                               id="pixCopyPaste"
                                               readonly />

                                        <button class="checkout-btn checkout-btn-light"
                                                type="button"
                                                onclick="copyPix()"
                                                id="btnCopyPix">
                                            <i class="fas fa-copy"></i>
                                            Copiar
                                        </button>
                                    </div>

                                    <span id="copyBadge" class="copy-badge d-none">Copiado!</span>

                                    <p class="checkout-help">
                                        Cole o código no aplicativo do seu banco se não puder ler o QR Code.
                                    </p>

                                    <div class="checkout-inline-actions">
                                        <button class="checkout-btn checkout-btn-light"
                                                type="button"
                                                id="btnForcarConsulta">
                                            <i class="fas fa-rotate-right"></i>
                                            Atualizar status
                                        </button>

                                        <button class="checkout-btn checkout-btn-ghost"
                                                type="button"
                                                id="pix-cancel-btn">
                                            Cancelar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </section>
                    }

                    @if (Model.Metodo == PaymentMethod.CardCredit || Model.Metodo == PaymentMethod.CardDebit)
                    {
                        <section id="card-section" class="checkout-payment-section">
                            <div class="payment-title-row">
                                <div class="payment-icon">
                                    <i class="fas fa-credit-card"></i>
                                </div>

                                <div>
                                    <h3>Pagamento com cartão</h3>
                                    <p>Preencha os dados do cartão para concluir o pagamento.</p>
                                </div>
                            </div>

                            <div id="cardPaymentBrick_container" class="card-brick-wrap"></div>

                            <div class="checkout-inline-actions mt-3">
                                <button id="mp-cancel-btn"
                                        type="button"
                                        class="checkout-btn checkout-btn-ghost">
                                    Cancelar
                                </button>
                            </div>

                            <p class="checkout-help">
                                Se necessário, faremos a autenticação 3-D Secure.
                            </p>
                        </section>
                    }

                    @if (Model.Metodo == PaymentMethod.Cash)
                    {
                        <section id="cash-section" class="checkout-payment-section">
                            <div class="payment-title-row">
                                <div class="payment-icon is-cash">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>

                                <div>
                                    <h3>Pagamento na entrega</h3>
                                    <p>Seu pedido será cobrado na retirada ou entrega.</p>
                                </div>
                            </div>
                        </section>
                    }

                    <div class="checkout-track-actions">
                        <a id="goTrackBtn" href="@trackUrl" class="checkout-btn checkout-btn-primary d-none">
                            <i class="fas fa-location-dot"></i>
                            Acompanhar pedido
                        </a>
                    </div>
                </div>
            </section>
        </main>

        <aside class="checkout-summary">
            <section id="checkout-summary-card" class="checkout-summary-card">
                <div class="summary-head">
                    <div>
                        <span>Resumo</span>
                        <h2>Resumo do pedido</h2>
                    </div>

                    <span id="pay-badge" class="summary-status">
                        @Model.Status
                    </span>
                </div>

                @if (items != null && items.Any())
                {
                    <ul id="checkout-resumo-itens" class="summary-items">
                        @foreach (var it in items)
                        {
                            <li class="summary-item">
                                @if (it.Img != null)
                                {
                                    <img src="@it.Img" alt="@it.Nome" />
                                }
                                else
                                {
                                    <div class="summary-item-placeholder">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }

                                <div class="summary-item-info">
                                    <strong>@it.Nome</strong>
                                    <span>@it.Qtd × @(((decimal)it.Preco).ToString("C", ptBR))</span>
                                </div>

                                <strong class="summary-item-total">
                                    @(((decimal)it.Subtotal).ToString("C", ptBR))
                                </strong>
                            </li>
                        }
                    </ul>
                }

                <div class="summary-lines">
                    <div>
                        <span>Subtotal</span>
                        <strong>@subtotal.ToString("C", ptBR)</strong>
                    </div>

                    <div>
                        <span>Entrega</span>
                        <strong>@frete.ToString("C", ptBR)</strong>
                    </div>

                    @if (desconto > 0)
                    {
                        <div class="is-discount">
                            <span>Desconto</span>
                            <strong>-@desconto.ToString("C", ptBR)</strong>
                        </div>
                    }
                </div>

                <div class="summary-total">
                    <span>Total</span>
                    <strong>@total.ToString("C", ptBR)</strong>
                </div>

                <a id="btn-acompanhar-pedido"
                   class="checkout-btn checkout-btn-primary w-100 @(isPaid ? "" : "d-none")"
                   href="@Url.Action("Acompanhar", "Pedido", new { id = Model.PedidoId, t = orderToken })">
                    <i class="fas fa-location-dot"></i>
                    Acompanhar pedido
                </a>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="https://sdk.mercadopago.com/js/v2"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
            referrerpolicy="no-referrer"></script>

    <script>
        window.CHECKOUT_CONFIG = {
          paymentId: @Model.Id,
          initialStatus: '@Model.Status',
          mpPublicKey: '@(ViewBag.MP_PublicKey ?? "")',
          antiForgery: '@afToken',
          statusUrl: '@Url.Action("Status", "Pagamento", new { id = Model.Id, t = orderToken })',
          confirmCardUrl: '@Url.Action("ConfirmCard", "Pagamento", new { id = Model.Id, t = orderToken })',
          cancelUrl: '@Url.Action("Cancelar", "Pagamento", new { id = Model.Id, t = orderToken })',
          amountStr: '@Model.Amount.ToString(CultureInfo.InvariantCulture)'
        };
    </script>

    <script src="~/js/checkout.js" asp-append-version="true"></script>
}