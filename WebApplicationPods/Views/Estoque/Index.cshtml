@model WebApplicationPods.Models.EstoqueVM
@using System.Globalization

@{
    ViewData["Title"] = "Estoque";
    var pt = new CultureInfo("pt-BR");
}

@section Styles {
    <link rel="stylesheet" href="~/css/Estoque-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="stock-page">
    <header class="stock-header">
        <div class="stock-title">
            <span>Administração</span>
            <h1>Estoque</h1>
            <p>Controle produtos, níveis e valores em estoque.</p>
        </div>

        <a asp-action="ExportarCsv"
           asp-all-route-data="@(new Dictionary<string, string>
           {
               [nameof(Model.Filtros.Categoria)] = Model.Filtros.Categoria ?? string.Empty,
               [nameof(Model.Filtros.ApenasBaixoEstoque)] = Model.Filtros.ApenasBaixoEstoque.ToString(),
               [nameof(Model.Filtros.ApenasEsgotados)] = Model.Filtros.ApenasEsgotados.ToString(),
               [nameof(Model.Filtros.LancamentoDe)] = Model.Filtros.LancamentoDe?.ToString("yyyy-MM-dd") ?? string.Empty,
               [nameof(Model.Filtros.LancamentoAte)] = Model.Filtros.LancamentoAte?.ToString("yyyy-MM-dd") ?? string.Empty,
               [nameof(Model.Filtros.OrdenarPor)] = Model.Filtros.OrdenarPor ?? string.Empty,
               [nameof(Model.Filtros.LimiteBaixoEstoque)] = Model.Filtros.LimiteBaixoEstoque.ToString()
           })"
           class="stock-btn stock-btn-light">
            <i class="fas fa-file-csv"></i>
            Exportar CSV
        </a>
    </header>

    <div class="stock-alerts">
        @if (TempData["Sucesso"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
            <div class="stock-alert is-success">
                <i class="fas fa-check-circle"></i>
                <span>@ok</span>
            </div>
        }

        @if (TempData["Erro"] is string err && !string.IsNullOrWhiteSpace(err))
        {
            <div class="stock-alert is-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@err</span>
            </div>
        }
    </div>

    <section class="stock-kpis">
        <article class="stock-kpi">
            <div class="stock-kpi-icon is-blue">
                <i class="fas fa-barcode"></i>
            </div>
            <div>
                <span>SKUs</span>
                <strong>@Model.TotalSkus</strong>
            </div>
        </article>

        <article class="stock-kpi">
            <div class="stock-kpi-icon is-green">
                <i class="fas fa-boxes-stacked"></i>
            </div>
            <div>
                <span>Qtd em estoque</span>
                <strong>@Model.QtdTotalEstoque</strong>
            </div>
        </article>

        <article class="stock-kpi">
            <div class="stock-kpi-icon is-blue">
                <i class="fas fa-tags"></i>
            </div>
            <div>
                <span>Valor de venda</span>
                <strong>@Model.ValorVendaTotal.ToString("C", pt)</strong>
            </div>
        </article>

        <article class="stock-kpi">
            <div class="stock-kpi-icon is-amber">
                <i class="fas fa-coins"></i>
            </div>
            <div>
                <span>Valor de custo</span>
                <strong>@((Model.ValorCustoTotal?.ToString("C", pt)) ?? "—")</strong>
            </div>
        </article>
    </section>

    @if (Model.EsgotadosCount > 0 || Model.BaixoEstoqueCount > 0)
    {
        <section class="stock-warning">
            <i class="fas fa-triangle-exclamation"></i>
            <div>
                <strong>Atenção ao estoque</strong>
                <p>
                    @if (Model.EsgotadosCount > 0)
                    {
                        <span>@Model.EsgotadosCount produto(s) esgotado(s). </span>
                    }
                    @if (Model.BaixoEstoqueCount > 0)
                    {
                        <span>@Model.BaixoEstoqueCount produto(s) com estoque baixo. </span>
                    }
                    Atualize o estoque ou pause o produto para evitar venda indevida.
                </p>
            </div>
        </section>
    }

    <section class="stock-filter-card">
        <div class="stock-section-head">
            <div>
                <span>Filtros</span>
                <h2>Filtrar estoque</h2>
            </div>
        </div>

        <form asp-action="Index" method="get" class="stock-filter-form" id="filtrosForm">
            <div class="stock-field">
                <label>Categoria</label>
                <select asp-for="Filtros.Categoria"
                        asp-items="@(new SelectList(Model.Filtros.CategoriasDisponiveis))">
                    <option value="">Todas</option>
                </select>
            </div>

            <div class="stock-field">
                <label>Lançado de</label>
                <input asp-for="Filtros.LancamentoDe" type="date" />
            </div>

            <div class="stock-field">
                <label>até</label>
                <input asp-for="Filtros.LancamentoAte" type="date" />
            </div>

            <div class="stock-field">
                <label>Ordenar por</label>
                <select asp-for="Filtros.OrdenarPor"
                        asp-items="@(new SelectList(Model.Filtros.OpcoesOrdenacao, "Key", "Value", Model.Filtros.OrdenarPor))">
                </select>
            </div>

            <div class="stock-field">
                <label>Limite baixo</label>
                <input asp-for="Filtros.LimiteBaixoEstoque" type="number" min="1" />
            </div>

            <div class="stock-checks">
                <label>
                    <input asp-for="Filtros.ApenasBaixoEstoque" />
                    <span>Baixo estoque</span>
                </label>

                <label>
                    <input asp-for="Filtros.ApenasEsgotados" />
                    <span>Esgotados</span>
                </label>
            </div>

            <div class="stock-filter-actions">
                <button class="stock-btn stock-btn-primary" type="submit">
                    <i class="fas fa-filter"></i>
                    Aplicar
                </button>

                <a asp-action="Index" class="stock-btn stock-btn-light">
                    Limpar
                </a>
            </div>
        </form>
    </section>

    <section class="stock-table-card">
        <div class="stock-table-wrap">
            <table class="stock-table">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th class="text-end">Estoque</th>
                        <th class="text-end">Preço</th>
                        <th class="text-end">Valor (venda)</th>
                        <th>Lançamento</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Itens != null && Model.Itens.Any())
                    {
                        @foreach (var i in Model.Itens)
                        {
                            var precoBase = (i.EmPromocao && i.PrecoPromocional.HasValue) ? i.PrecoPromocional.Value : i.Preco;
                            var statusClass = i.Esgotado ? "is-zero" : i.BaixoEstoque(Model.Filtros.LimiteBaixoEstoque) ? "is-low" : "is-ok";
                            var statusText = i.Esgotado ? "Esgotado" : i.BaixoEstoque(Model.Filtros.LimiteBaixoEstoque) ? "Baixo estoque" : "OK";

                            <tr class="@statusClass">
                                <td>
                                    <div class="stock-product">
                                        <div class="stock-product-img">
                                            <img src="@Url.Content(i.ImagemUrl ?? "/images/placeholder-80.png")"
                                                 alt="@i.Nome"
                                                 loading="lazy" />
                                        </div>

                                        <div class="stock-product-info">
                                            <strong>@i.Nome</strong>
                                            <span class="stock-status @statusClass">@statusText</span>

                                            @if (i.EmPromocao)
                                            {
                                                <span class="stock-promo">Promo</span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>@i.Categoria</td>

                                <td class="text-end">
                                    <strong>@i.EstoqueDescricao</strong>

                                    @if (i.EhEmbalagemComposta)
                                    {
                                        <small>Venda limitada a @i.Estoque @(i.Estoque == 1 ? "embalagem" : "embalagens")</small>
                                    }
                                </td>

                                <td class="text-end">
                                    <strong>@precoBase.ToString("C", pt)</strong>

                                    @if (i.EmPromocao)
                                    {
                                        <small><s>@i.Preco.ToString("C", pt)</s></small>
                                    }
                                </td>

                                <td class="text-end">
                                    <strong>@i.ValorVendaEmEstoque.ToString("C", pt)</strong>
                                </td>

                                <td>
                                    <span class="stock-date">
                                        @(i.Lancamento?.ToString("dd/MM/yyyy") ?? "—")
                                    </span>
                                </td>

                                <td class="text-end">
                                    <a asp-controller="Produto"
                                       asp-action="Editar"
                                       asp-route-id="@i.Id"
                                       class="stock-icon-action"
                                       aria-label="Editar @i.Nome">
                                        <i class="fas fa-pen"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="stock-empty-inline">
                                    <i class="fas fa-info-circle"></i>
                                    Nenhum produto encontrado.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="stock-mobile-list">
        @if (Model.Itens != null && Model.Itens.Any())
        {
            @foreach (var i in Model.Itens)
            {
                var precoBase = (i.EmPromocao && i.PrecoPromocional.HasValue) ? i.PrecoPromocional.Value : i.Preco;
                var statusClass = i.Esgotado ? "is-zero" : i.BaixoEstoque(Model.Filtros.LimiteBaixoEstoque) ? "is-low" : "is-ok";
                var statusText = i.Esgotado ? "Esgotado" : i.BaixoEstoque(Model.Filtros.LimiteBaixoEstoque) ? "Baixo estoque" : "OK";

                <article class="stock-mobile-card @statusClass">
                    <header class="stock-mobile-head">
                        <div class="stock-product-img">
                            <img src="@Url.Content(i.ImagemUrl ?? "/images/placeholder-80.png")"
                                 alt="@i.Nome"
                                 loading="lazy" />
                        </div>

                        <div>
                            <h3>@i.Nome</h3>
                            <span class="stock-status @statusClass">@statusText</span>

                            @if (i.EmPromocao)
                            {
                                <span class="stock-promo">Promo</span>
                            }
                        </div>
                    </header>

                    <div class="stock-mobile-lines">
                        <div>
                            <span>Categoria</span>
                            <strong>@i.Categoria</strong>
                        </div>

                        <div>
                            <span>Estoque</span>
                            <strong>@i.EstoqueDescricao</strong>
                        </div>

                        <div>
                            <span>Preço</span>
                            <strong>@precoBase.ToString("C", pt)</strong>
                        </div>

                        <div>
                            <span>Valor (venda)</span>
                            <strong>@i.ValorVendaEmEstoque.ToString("C", pt)</strong>
                        </div>

                        <div>
                            <span>Lançamento</span>
                            <strong>@(i.Lancamento?.ToString("dd/MM/yyyy") ?? "—")</strong>
                        </div>
                    </div>

                    <footer>
                        <a asp-controller="Produto"
                           asp-action="Editar"
                           asp-route-id="@i.Id"
                           class="stock-btn stock-btn-light">
                            <i class="fas fa-pen"></i>
                            Editar
                        </a>
                    </footer>
                </article>
            }
        }
        else
        {
            <div class="stock-empty-inline">
                <i class="fas fa-info-circle"></i>
                Nenhum produto encontrado.
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            setTimeout(() => {
                document.querySelectorAll('.stock-alert').forEach(a => a.remove());
            }, 5000);

            const filtrosForm = document.getElementById('filtrosForm');

            if (filtrosForm) {
                filtrosForm.querySelectorAll('select, input[type="checkbox"]').forEach(el => {
                    el.addEventListener('change', () => filtrosForm.submit());
                });
            }
        });
    </script>
}