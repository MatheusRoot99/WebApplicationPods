@using WebApplicationPods.Models
@model CarrinhoModel

@{
    ViewData["Title"] = "Resumo do Pedido";
}

<div class="container-fluid py-4 resumo-pedido-page">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card resumo-card">
                <div class="card-header resumo-card-header">
                    <h4 class="mb-0">Itens do Pedido</h4>
                </div>

                <div class="card-body">
                    @if (Model?.Itens != null && Model.Itens.Any())
                    {
                        foreach (var item in Model.Itens)
                        {
                            var produto = item.Produto;
                            var nome = produto?.Nome ?? $"Produto #{item.ProdutoId}";
                            var img = !string.IsNullOrWhiteSpace(produto?.ImagemUrl)
                            ? produto.ImagemUrl
                            : null;

                            var resumoQuantidade = produto?.EhEmbalagemComposta == true
                            ? $"{item.Quantidade} {(item.Quantidade == 1 ? produto.EmbalagemVendaSingular : produto.EmbalagemVendaPlural)} com {produto.UnidadesFisicasPorEmbalagem} unidades ({item.Quantidade * produto.UnidadesFisicasPorEmbalagem} unidades físicas)"
                            : (item.Quantidade == 1 ? "1 unidade" : $"{item.Quantidade} unidades");

                            <div class="resumo-item">
                                <div class="resumo-item-img">
                                    @if (!string.IsNullOrWhiteSpace(img))
                                    {
                                        <img src="@img" alt="@nome" />
                                    }
                                    else
                                    {
                                        <span>Sem imagem</span>
                                    }
                                </div>

                                <div class="resumo-item-info">
                                    <h5>@nome</h5>
                                    <div class="resumo-item-qtd">@resumoQuantidade</div>

                                    @if (!string.IsNullOrWhiteSpace(item.Sabor))
                                    {
                                        <div class="resumo-item-extra">
                                            <strong>Sabor:</strong> @item.Sabor
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Observacoes))
                                    {
                                        <div class="resumo-item-extra">
                                            <strong>Obs:</strong> @item.Observacoes
                                        </div>
                                    }
                                </div>

                                <div class="resumo-item-total">
                                    @item.Subtotal.ToString("C")
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0">
                            Nenhum item encontrado no carrinho.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card resumo-card resumo-total-card">
                <div class="card-header resumo-card-header">
                    <h4 class="mb-0">Total do Pedido</h4>
                </div>

                <div class="card-body">
                    <div class="resumo-total-linha">
                        <span>Subtotal</span>
                        <strong>@(Model?.Total.ToString("C") ?? "R$ 0,00")</strong>
                    </div>

                    <div class="resumo-total-linha">
                        <span>Frete</span>
                        <strong>A calcular</strong>
                    </div>

                    <hr />

                    <div class="resumo-total-final">
                        <span>Total</span>
                        <strong>@(Model?.Total.ToString("C") ?? "R$ 0,00")</strong>
                    </div>

                    <div class="mt-4">
                        <h5 class="resumo-section-title">Método de Pagamento</h5>

                        <label class="resumo-radio">
                            <input type="radio" name="metodoPagamento" id="pix" value="Pix" checked />
                            <span>Pix</span>
                        </label>

                        <label class="resumo-radio">
                            <input type="radio" name="metodoPagamento" id="cartao" value="CartaoCredito" />
                            <span>Cartão de Crédito</span>
                        </label>
                    </div>

                    <button id="finalizarPedido" class="btn-finalizar-pedido">
                        Finalizar Pedido
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .resumo-pedido-page {
        width: 100%;
    }

    .resumo-card {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .08);
    }

    .resumo-card-header {
        background: linear-gradient(135deg, #6d28d9, #2563eb);
        color: #fff;
        padding: 18px 22px;
    }

    .resumo-item {
        display: grid;
        grid-template-columns: 76px 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 16px 0;
        border-bottom: 1px solid #e5e7eb;
    }

        .resumo-item:last-child {
            border-bottom: 0;
        }

    .resumo-item-img {
        width: 76px;
        height: 76px;
        border-radius: 14px;
        background: #f1f5f9;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        color: #94a3b8;
        font-size: .75rem;
        text-align: center;
    }

        .resumo-item-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .resumo-item-info h5 {
        margin: 0 0 4px;
        font-weight: 800;
        color: #111827;
    }

    .resumo-item-qtd {
        font-size: .9rem;
        color: #2563eb;
        font-weight: 700;
    }

    .resumo-item-extra {
        font-size: .82rem;
        color: #6b7280;
        margin-top: 2px;
    }

    .resumo-item-total {
        font-weight: 800;
        color: #111827;
        white-space: nowrap;
    }

    .resumo-total-linha,
    .resumo-total-final {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .resumo-total-final {
        font-size: 1.25rem;
    }

        .resumo-total-final strong {
            color: #16a34a;
            font-size: 1.5rem;
        }

    .resumo-section-title {
        font-size: 1rem;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .resumo-radio {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        margin-bottom: 8px;
        cursor: pointer;
    }

    .btn-finalizar-pedido {
        width: 100%;
        margin-top: 20px;
        border: 0;
        border-radius: 14px;
        padding: 14px 18px;
        background: linear-gradient(135deg, #6d28d9, #2563eb);
        color: #fff;
        font-weight: 800;
    }

    [data-theme="dark"] .resumo-card,
    body.dark .resumo-card {
        background: #111827;
        color: #e5e7eb;
    }

    [data-theme="dark"] .resumo-item,
    body.dark .resumo-item {
        border-color: #263244;
    }

    [data-theme="dark"] .resumo-item-info h5,
    [data-theme="dark"] .resumo-item-total,
    body.dark .resumo-item-info h5,
    body.dark .resumo-item-total {
        color: #fff;
    }

    [data-theme="dark"] .resumo-item-img,
    body.dark .resumo-item-img {
        background: #0f172a;
        border-color: #263244;
    }

    [data-theme="dark"] .resumo-radio,
    body.dark .resumo-radio {
        border-color: #263244;
        background: #0f172a;
    }

    @@media (max-width: 576px) {
        .resumo-item {
            grid-template-columns: 64px 1fr;
        }

        .resumo-item-total {
            grid-column: 2;
        }

        .resumo-item-img {
            width: 64px;
            height: 64px;
        }
    }
</style>

@section Scripts {
    <script>
        document.getElementById('finalizarPedido')?.addEventListener('click', function () {
            window.location.href = '/Carrinho/Finalizar';
        });
    </script>
}