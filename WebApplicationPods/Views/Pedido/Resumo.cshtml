@using WebApplicationPods.Models
@model CarrinhoModel

@{
    ViewData["Title"] = "Resumo do Pedido";

    var itens = Model?.Itens ?? new List<CarrinhoItemViewModel>();
    var temItens = itens.Any();
    var total = Model?.Total ?? 0m;
}

@section Styles {
    <link rel="stylesheet" href="~/css/ResumoPedidoCliente.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="order-summary-page">
    <header class="order-summary-header">
        <a asp-controller="Carrinho" asp-action="Index" class="order-summary-back" aria-label="Voltar para o carrinho">
            <i class="fas fa-arrow-left"></i>
        </a>

        <div class="order-summary-title">
            <span>Conferência</span>
            <h1>Resumo do pedido</h1>
            <p>Revise seus itens e escolha a forma de pagamento.</p>
        </div>

        <div class="order-summary-safe">
            <i class="fas fa-shield-alt"></i>
            <span>Seguro</span>
        </div>
    </header>

    @if (temItens)
    {
        <div class="order-summary-layout">
            <main class="order-summary-items">
                <section class="order-summary-card">
                    <div class="order-summary-card-head">
                        <div>
                            <span>Itens</span>
                            <h2>Itens do pedido</h2>
                        </div>

                        <strong>@itens.Count item(ns)</strong>
                    </div>

                    <div class="order-items-list">
                        @foreach (var item in itens)
                        {
                            var produto = item.Produto;
                            var nome = produto?.Nome ?? $"Produto #{item.ProdutoId}";
                            var img = !string.IsNullOrWhiteSpace(produto?.ImagemUrl)
                            ? produto.ImagemUrl
                            : null;

                            var quantidade = item.Quantidade;
                            var ehEmbalagemComposta = produto?.EhEmbalagemComposta == true;
                            var unidadesPorEmbalagem = produto?.UnidadesFisicasPorEmbalagem ?? 1;
                            var totalFisico = quantidade * unidadesPorEmbalagem;

                            var resumoQuantidade = ehEmbalagemComposta
                            ? $"{quantidade} {(quantidade == 1 ? produto!.EmbalagemVendaSingular : produto!.EmbalagemVendaPlural)} com {unidadesPorEmbalagem} unidades"
                            : quantidade == 1 ? "1 unidade" : $"{quantidade} unidades";

                            var totalFisicoTexto = ehEmbalagemComposta
                            ? $"Total físico: {totalFisico} {(totalFisico == 1 ? "unidade" : "unidades")}"
                            : "";

                            <article class="order-item-card">
                                <div class="order-item-img">
                                    @if (!string.IsNullOrWhiteSpace(img))
                                    {
                                        <img src="@Url.Content(img)" alt="@nome" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-image"></i>
                                    }
                                </div>

                                <div class="order-item-info">
                                    <h3>@nome</h3>

                                    <div class="order-item-meta is-primary">
                                        @resumoQuantidade
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(totalFisicoTexto))
                                    {
                                        <div class="order-item-meta is-success">
                                            @totalFisicoTexto
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Sabor))
                                    {
                                        <div class="order-item-meta">
                                            <strong>Sabor:</strong> @item.Sabor
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.Observacoes))
                                    {
                                        <div class="order-item-meta">
                                            <strong>Obs:</strong> @item.Observacoes
                                        </div>
                                    }
                                </div>

                                <strong class="order-item-total">
                                    @item.Subtotal.ToString("C")
                                </strong>
                            </article>
                        }
                    </div>
                </section>
            </main>

            <aside class="order-summary-aside">
                <section class="order-total-card">
                    <div class="order-total-head">
                        <div>
                            <span>Total</span>
                            <h2>Total do pedido</h2>
                        </div>

                        <div class="order-total-icon">
                            <i class="fas fa-receipt"></i>
                        </div>
                    </div>

                    <div class="order-total-lines">
                        <div>
                            <span>Subtotal</span>
                            <strong>@total.ToString("C")</strong>
                        </div>

                        <div>
                            <span>Entrega</span>
                            <strong>A calcular</strong>
                        </div>
                    </div>

                    <div class="order-total-final">
                        <span>Total</span>
                        <strong>@total.ToString("C")</strong>
                    </div>

                    <div class="order-payment">
                        <h3>Método de pagamento</h3>

                        <label class="order-payment-option">
                            <input type="radio" name="metodoPagamento" id="pix" value="Pix" checked />
                            <span class="order-payment-check"></span>
                            <i class="fas fa-qrcode"></i>
                            <strong>Pix</strong>
                        </label>

                        <label class="order-payment-option">
                            <input type="radio" name="metodoPagamento" id="cartao" value="CartaoCredito" />
                            <span class="order-payment-check"></span>
                            <i class="fas fa-credit-card"></i>
                            <strong>Cartão de Crédito</strong>
                        </label>
                    </div>

                    <button id="finalizarPedido" class="order-finish-btn" type="button">
                        Finalizar pedido
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </section>
            </aside>
        </div>
    }
    else
    {
        <section class="order-empty">
            <div class="order-empty-icon">
                <i class="fas fa-bag-shopping"></i>
            </div>

            <h2>Nenhum item encontrado</h2>
            <p>Adicione produtos ao carrinho para continuar.</p>

            <a asp-controller="Home" asp-action="Index" class="order-finish-btn">
                Ver produtos
                <i class="fas fa-store"></i>
            </a>
        </section>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('finalizarPedido')?.addEventListener('click', function () {
            window.location.href = '/Carrinho/Finalizar';
        });
    </script>
}