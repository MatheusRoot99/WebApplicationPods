@using System.Text.Json
@using WebApplicationPods.Enum
@model WebApplicationPods.Models.ProdutoListagemViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="home-index">

    <div class="topbar container-fluid">
        <div class="topbar-inner container px-0">
            <button class="topbar-btn" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#filtersCollapse"
                    aria-expanded="false"
                    aria-controls="filtersCollapse">
                <i class="fa-solid fa-sliders"></i>
                <span>Filtrar</span>
            </button>

            <div class="topbar-select">
                <label for="Filtros_OrdenarPor" class="form-label m-0">Ordenar por</label>
                <select id="Filtros_OrdenarPor" name="OrdenarPor" class="form-select form-select-sm">
                    @foreach (var kv in Model.Filtros.OpcoesOrdenacao)
                    {
                        if (Model.Filtros.OrdenarPor == kv.Key)
                        {
                            <option value="@kv.Key" selected="selected">@kv.Value</option>
                        }
                        else
                        {
                            <option value="@kv.Key">@kv.Value</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <section class="hero-section text-center text-white mb-3">
        <div class="container">
            <h1 class="display-6 fw-bold mb-1">
                Bem-vindo à @(Model.Loja?.Nome ?? "nossa loja")
            </h1>
            <p class="lead fs-6 mb-0">Os melhores produtos do mercado!</p>
        </div>
    </section>

    <div class="container mb-3">
        <div class="collapse d-lg-block" id="filtersCollapse">
            <form asp-area=""
                  asp-action="Index"
                  method="get"
                  class="filters-card card border-0 p-3 mb-3"
                  id="filtersForm">

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-lg-4">
                        <label class="form-label">Buscar</label>
                        <input name="Termo"
                               value="@(Model.Filtros.Termo ?? "")"
                               class="form-control"
                               placeholder="Ex: Heineken, Pod, Whisky..." />
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label class="form-label">Categoria</label>
                        <select name="Categoria"
                                class="form-select"
                                asp-items="@(new SelectList(Model.Filtros.CategoriasDisponiveis, Model.Filtros.Categoria))">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filtros.Categoria))">
                                Todas Categorias
                            </option>
                        </select>
                    </div>

                    <div class="col-6 col-lg-2">
                        <label class="form-label">Preço mín</label>
                        <input name="PrecoMin"
                               value="@(Model.Filtros.PrecoMin?.ToString() ?? "")"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="R$" />
                    </div>

                    <div class="col-6 col-lg-2">
                        <label class="form-label">Preço máx</label>
                        <input name="PrecoMax"
                               value="@(Model.Filtros.PrecoMax?.ToString() ?? "")"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="R$" />
                    </div>

                    <div class="col-12 col-lg-1 d-none d-lg-block">
                        <label class="form-label">Ord.</label>
                        <select name="OrdenarPor" class="form-select" id="OrdenarPorForm">
                            @foreach (var kv in Model.Filtros.OpcoesOrdenacao)
                            {
                                if (Model.Filtros.OrdenarPor == kv.Key)
                                {
                                    <option value="@kv.Key" selected="selected">@kv.Value</option>
                                }
                                else
                                {
                                    <option value="@kv.Key">@kv.Value</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-12">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="ApenasPromocoes"
                                           value="true"
                                           @(Model.Filtros.ApenasPromocoes ? "checked" : "")
                                           id="ckPromo" />
                                    <label class="form-check-label" for="ckPromo">Promoções</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="ApenasEstoque"
                                           value="true"
                                           @(Model.Filtros.ApenasEstoque ? "checked" : "")
                                           id="ckEstoque" />
                                    <label class="form-check-label" for="ckEstoque">Em estoque</label>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-filter me-1"></i> Filtrar
                                </button>

                                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                                    <i class="fas fa-times me-1"></i> Limpar
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <div class="container mb-4">
        @if (Model.Produtos != null && Model.Produtos.Any())
        {
            <div class="product-grid">
                @foreach (var produto in Model.Produtos)
                {
                    var promoOk = produto.EmPromocao
                    && produto.PrecoPromocional.HasValue
                    && produto.PrecoPromocional.Value > 0
                    && produto.PrecoPromocional.Value < produto.Preco;

                    var precoAtual = promoOk ? produto.PrecoPromocional!.Value : produto.Preco;

                    var estaEsgotado = produto.EstaEsgotado;
                    var estoqueBaixo = produto.EstaComEstoqueBaixo;
                    var statusEstoqueTexto = produto.StatusEstoqueTexto;
                    var statusEstoqueCss = produto.StatusEstoqueCss;

                    var isPod = produto.TipoProduto == ProdutoTipo.PodVape;
                    var isBebida = produto.TipoProduto == ProdutoTipo.BebidaAlcoolica
                    || produto.BebidaVolumeMl.HasValue
                    || produto.BebidaEmbalagem.HasValue
                    || produto.BebidaQtdPorEmbalagem.HasValue
                    || !string.IsNullOrWhiteSpace(produto.BebidaTipo);

                    var exigeSelecaoDeSabor = isPod
                    || (
                    produto.SaboresQuantidadesList != null &&
                    produto.SaboresQuantidadesList.Any(s => s.Quantidade > 0)
                    );

                    var temVolume = produto.BebidaVolumeMl.HasValue && produto.BebidaVolumeMl.Value > 0;
                    var embalagemResumo = "";

                    if (isBebida)
                    {
                        if (!string.IsNullOrWhiteSpace(produto.UnidadeVendaDescricao))
                        {
                            embalagemResumo = produto.UnidadeVendaDescricao;
                        }
                        else if (produto.BebidaEmbalagem.HasValue &&
                        produto.BebidaEmbalagem.Value != BebidaEmbalagemTipo.NaoInformado)
                        {
                            embalagemResumo = produto.BebidaEmbalagem.Value switch
                            {
                                BebidaEmbalagemTipo.Unidade => "unidade",
                                BebidaEmbalagemTipo.Lata => "lata",
                                BebidaEmbalagemTipo.LongNeck => "long neck",
                                BebidaEmbalagemTipo.Garrafa => "garrafa",
                                BebidaEmbalagemTipo.Pack => "pack",
                                BebidaEmbalagemTipo.Fardo => "fardo",
                                BebidaEmbalagemTipo.Caixa => "caixa",
                                _ => ""
                            };
                        }
                    }

                    var temSpecsBebida = temVolume || !string.IsNullOrWhiteSpace(embalagemResumo);

                    var temPuffs = produto.PodPuffs > 0;
                    var bateriaTexto = (produto.PodCapacidadeBateria ?? "").Trim();
                    var temBateria = !string.IsNullOrWhiteSpace(bateriaTexto);
                    var temSaborPod = !string.IsNullOrWhiteSpace(produto.Sabor);

                    <article class="produto-card h-100">
                        <a asp-area=""
                           asp-controller="Produto"
                           asp-action="Detalhes"
                           asp-route-id="@produto.Id"
                           class="thumb-link"
                           aria-label="@produto.Nome">

                            <div class="product-thumb">
                                @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                                {
                                    <img src="@Url.Content(produto.ImagemUrl)" alt="@produto.Nome" />
                                }
                                else
                                {
                                    <div class="no-image">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }

                                @if (estaEsgotado)
                                {
                                    <span class="badge badge-top-right badge-stock-out">ESGOTADO</span>
                                }
                                else if (estoqueBaixo)
                                {
                                    <span class="badge badge-top-right badge-stock-low">ULTIMAS UNIDADES</span>
                                }
                                else if (promoOk)
                                {
                                    <span class="badge badge-top-right badge-promo">PROMOÇÃO</span>
                                }
                            </div>
                        </a>

                        <div class="card-body">
                            <a asp-area=""
                               asp-controller="Produto"
                               asp-action="Detalhes"
                               asp-route-id="@produto.Id"
                               class="text-decoration-none">

                                <h6 class="title text-truncate-2">@produto.Nome</h6>

                                @if (isPod)
                                {
                                    <div class="specs specs-inline small text-muted">
                                        @if (temPuffs)
                                        {
                                            <span class="spec-item">
                                                <i class="fa-solid fa-smoking"></i>
                                                @produto.PodPuffs puffs
                                            </span>
                                        }

                                        @if (temPuffs && temBateria)
                                        {
                                            <span class="spec-separator">•</span>
                                        }

                                        @if (temBateria)
                                        {
                                            <span class="spec-item">
                                                <i class="fa-solid fa-battery-three-quarters"></i>
                                                @bateriaTexto
                                            </span>
                                        }

                                        @if ((temPuffs || temBateria) && temSaborPod)
                                        {
                                            <span class="spec-separator">•</span>
                                        }

                                        @if (temSaborPod)
                                        {
                                            <span class="spec-item">
                                                <i class="fa-solid fa-leaf"></i>
                                                @produto.Sabor
                                            </span>
                                        }
                                    </div>
                                }
                                else if (temSpecsBebida)
                                {
                                    <div class="specs specs-inline small text-muted">
                                        @if (temVolume)
                                        {
                                            <span class="spec-item">
                                                <i class="fa-solid fa-glass-water"></i>
                                                @produto.BebidaVolumeMl ml
                                            </span>
                                        }

                                        @if (temVolume && !string.IsNullOrWhiteSpace(embalagemResumo))
                                        {
                                            <span class="spec-separator">•</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(embalagemResumo))
                                        {
                                            <span class="spec-item">
                                                <i class="fa-solid fa-box"></i>
                                                @embalagemResumo
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="specs specs-inline small text-muted"></div>
                                }

                                <div class="price-line">
                                    @if (promoOk)
                                    {
                                        <span class="old">@produto.Preco.ToString("C")</span>
                                    }

                                    <span class="current">@precoAtual.ToString("C")</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(statusEstoqueTexto))
                                {
                                    @* <div class="stock-status-line @statusEstoqueCss">
                                        @statusEstoqueTexto
                                    </div> *@
                                }
                            </a>

                            @if (!estaEsgotado)
                            {
                                if (exigeSelecaoDeSabor)
                                {
                                    <div class="quick-add-form">
                                        <a asp-area=""
                                           asp-controller="Produto"
                                           asp-action="Detalhes"
                                           asp-route-id="@produto.Id"
                                           class="quick-add text-decoration-none"
                                           title="Escolher opções"
                                           aria-label="Escolher opções de @produto.Nome">
                                            <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <form asp-controller="Carrinho"
                                          asp-action="AdicionarItem"
                                          method="post"
                                          class="quick-add-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="produtoId" value="@produto.Id" />
                                        <input type="hidden" name="quantidade" value="1" />
                                        <input type="hidden" name="sabor" value="" />
                                        <input type="hidden" name="observacoes" value="" />
                                        <input type="hidden" name="buyNow" value="false" />

                                        <button type="submit"
                                                class="quick-add"
                                                data-product-id="@produto.Id"
                                                title="Adicionar ao carrinho"
                                                aria-label="Adicionar @produto.Nome ao carrinho">
                                            <i class="fa-solid fa-cart-plus qa-icon" aria-hidden="true"></i>
                                            <i class="fa-solid fa-spinner fa-spin qa-spin" aria-hidden="true"></i>
                                            <i class="fa-solid fa-check qa-done" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                }
                            }
                            else
                            {
                                <div class="quick-add-form">
                                    <button type="button"
                                            class="quick-add disabled"
                                            disabled
                                            title="Produto esgotado"
                                            aria-label="@produto.Nome esgotado">
                                        <i class="fa-solid fa-ban" aria-hidden="true"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-box-open"></i>
                Nenhum produto encontrado. Tente ajustar os filtros para encontrar o que procura.
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const STORAGE_KEY = 'produtos_adicionados_carrinho';

            const produtosNoCarrinhoServidor = @Html.Raw(JsonSerializer.Serialize(
                            (Model.ProdutosNoCarrinho ?? new List<int>()).Select(x => x.ToString())
                    ));

        const topbarOrder = document.getElementById('Filtros_OrdenarPor');
        const formOrder = document.getElementById('OrdenarPorForm');
        const filtersForm = document.getElementById('filtersForm');

            if (topbarOrder) {
                topbarOrder.addEventListener('change', function () {
                    if (formOrder) {
                        formOrder.value = topbarOrder.value;
                    }

                    if (filtersForm) {
                        filtersForm.submit();
                    }
                });
            }

            function getStorage() {
                try {
                    const data = localStorage.getItem(STORAGE_KEY);
                    if (!data) return [];

                    const parsed = JSON.parse(data);
                    return Array.isArray(parsed) ? parsed.map(String) : [];
                } catch {
                    return [];
                }
            }

            function saveStorage(ids) {
                localStorage.setItem(
                    STORAGE_KEY,
                    JSON.stringify([...new Set((ids || []).map(String))])
                );
            }

            function addStorage(id) {
                id = String(id || '');
                if (!id) return;

                const ids = getStorage();

                if (!ids.includes(id)) {
                    ids.push(id);
                    saveStorage(ids);
                }
            }

            function removeStorage(id) {
                id = String(id || '');
                if (!id) return;

                const ids = getStorage().filter(x => x !== id);
                saveStorage(ids);
            }

            function setButtonState(button, state) {
                if (!button) return;

                const cart = button.querySelector('.qa-icon');
                const spin = button.querySelector('.qa-spin');
                const done = button.querySelector('.qa-done');

                button.classList.remove('is-loading', 'is-success');

                if (cart) cart.style.display = 'none';
                if (spin) spin.style.display = 'none';
                if (done) done.style.display = 'none';

                if (state === 'loading') {
                    button.classList.add('is-loading');
                    if (spin) spin.style.display = 'inline-block';
                    return;
                }

                if (state === 'success') {
                    button.classList.add('is-success');
                    if (done) done.style.display = 'inline-block';
                    return;
                }

                if (cart) cart.style.display = 'inline-block';
            }

            function sincronizarStorageComServidor() {
                const idsServidor = Array.isArray(produtosNoCarrinhoServidor)
                    ? produtosNoCarrinhoServidor.map(String)
                    : [];

                saveStorage(idsServidor);
                return idsServidor;
            }

            function restoreButtons() {
                const ids = sincronizarStorageComServidor();

                document.querySelectorAll('button.quick-add[data-product-id]').forEach(button => {
                    const id = String(button.dataset.productId || '');

                    if (ids.includes(id)) {
                        setButtonState(button, 'success');
                    } else {
                        setButtonState(button, 'default');
                    }
                });
            }

            function updateCartCount(count) {
                const els = document.querySelectorAll('[data-cart-count], .cart-count, #cartCount');
                els.forEach(el => el.textContent = count);
            }

            async function submitQuickAdd(form) {
                const button = form.querySelector('button.quick-add');
                if (!button) return;

                const productId = button.dataset.productId;
                if (!productId) return;

                if (button.classList.contains('is-success')) return;

                setButtonState(button, 'loading');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        credentials: 'same-origin'
                    });

                    const contentType = response.headers.get('content-type') || '';
                    let data = null;

                    if (contentType.includes('application/json')) {
                        data = await response.json();
                    }

                    if (!response.ok) {
                        throw new Error(data?.error || 'Erro ao adicionar produto.');
                    }

                    if (data && data.ok === false) {
                        throw new Error(data.error || 'Não foi possível adicionar.');
                    }

                    addStorage(productId);
                    setButtonState(button, 'success');

                    if (data && typeof data.count !== 'undefined') {
                        updateCartCount(data.count);
                    }
                } catch (e) {
                    console.error(e);
                    setButtonState(button, 'default');

                    alert(e?.message || 'Não foi possível adicionar o produto ao carrinho.');
                }
            }

            document.addEventListener('submit', function (e) {
                const form = e.target.closest('form.quick-add-form');
                if (!form) return;

                const button = form.querySelector('button.quick-add');
                if (!button) return;

                e.preventDefault();
                e.stopPropagation();

                submitQuickAdd(form);
            });

            document.addEventListener('DOMContentLoaded', function () {
                restoreButtons();
            });

            window.addEventListener('pageshow', function () {
                restoreButtons();
            });

            window.produtosCarrinho = {
                listar: () => getStorage(),
                limpar: () => {
                    localStorage.removeItem(STORAGE_KEY);
                    restoreButtons();
                },
                remover: (productId) => {
                    removeStorage(productId);
                },
                sincronizar: () => {
                    restoreButtons();
                }
            };
        })();
    </script>
}