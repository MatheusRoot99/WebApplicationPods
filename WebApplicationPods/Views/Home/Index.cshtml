@using System.Text.Json
@using WebApplicationPods.Enum
@model WebApplicationPods.Models.ProdutoListagemViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model.Loja?.Nome ?? "Loja";
    ViewData["HideStoreHeader"] = true;
    ViewData["BodyClass"] = "storefront-full";

    var lojaNome = Model.Loja?.Nome ?? "Conveniência X";
    var produtos = Model.Produtos ?? Enumerable.Empty<WebApplicationPods.Models.ProdutoModel>();
    var categorias = Model.Filtros.CategoriasDisponiveis ?? Enumerable.Empty<string>();
    var categoriaAtual = Model.Filtros.Categoria ?? "";
    var termoAtual = Model.Filtros.Termo ?? "";

    var produtosNoCarrinho = Model.ProdutosNoCarrinho ?? new List<int>();
    var carrinhoCountInicial = produtosNoCarrinho.Count;

    var produtosNoCarrinhoJson = JsonSerializer.Serialize(
        produtosNoCarrinho.Select(x => x.ToString())
    );
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="storefront-page">

    <header class="storefront-header">
        <div class="storefront-store">
            <div class="storefront-logo">
                <i class="fa-solid fa-store"></i>
            </div>

            <div>
                <h1>@lojaNome</h1>

                <div class="storefront-status">
                    <span class="status-dot"></span>
                    <strong>Aberto</strong>
                    <span>Até 23h59</span>
                </div>
            </div>
        </div>

        @* <div class="storefront-actions">
            <button type="button"
                    class="storefront-icon-btn"
                    aria-label="Buscar"
                    onclick="document.getElementById('storeSearchInput')?.focus()">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>

            <a asp-controller="Auth"
               asp-action="Perfil"
               class="storefront-icon-btn"
               aria-label="Conta">
                <i class="fa-regular fa-user"></i>
            </a>
        </div> *@
    </header>

    <section class="store-search-section">
        <form asp-area=""
              asp-controller="Home"
              asp-action="Index"
              method="get"
              class="store-search-form"
              id="storeSearchForm">

            <input type="hidden" name="Categoria" value="@categoriaAtual" />
            <input type="hidden" name="OrdenarPor" value="@Model.Filtros.OrdenarPor" />

            <i class="fa-solid fa-magnifying-glass"></i>

            <input id="storeSearchInput"
                   name="Termo"
                   value="@termoAtual"
                   type="search"
                   placeholder="Buscar produtos..."
                   autocomplete="off" />
        </form>

        @* <button type="button"
                class="store-scan-btn"
                aria-label="Scanner">
            <i class="fa-solid fa-barcode"></i>
        </button> *@
    </section>

    <section class="store-category-strip" aria-label="Categorias">
        <a class="store-category-chip @(string.IsNullOrWhiteSpace(categoriaAtual) ? "active" : "")"
           href="@Url.Action("Index", "Home", new { Termo = termoAtual, OrdenarPor = Model.Filtros.OrdenarPor })">
            Todas
        </a>

        @foreach (var categoria in categorias)
        {
            <a class="store-category-chip @(string.Equals(categoriaAtual, categoria, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="@Url.Action("Index", "Home", new { Termo = termoAtual, Categoria = categoria, OrdenarPor = Model.Filtros.OrdenarPor })">
                @categoria
            </a>
        }
    </section>

    <section class="store-advanced-row">
        <button type="button"
                class="store-filter-toggle"
                id="advancedFiltersToggle">
            <i class="fa-solid fa-sliders"></i>
            Filtros
        </button>

        <form asp-area=""
              asp-controller="Home"
              asp-action="Index"
              method="get"
              class="store-sort-form">
            <input type="hidden" name="Termo" value="@termoAtual" />
            <input type="hidden" name="Categoria" value="@categoriaAtual" />

            <label for="OrdenarPor">Ordenar</label>

            <select id="OrdenarPor" name="OrdenarPor" onchange="this.form.submit()">
                @foreach (var kv in Model.Filtros.OpcoesOrdenacao)
                {
                    if (Model.Filtros.OrdenarPor == kv.Key)
                    {
                        <option value="@kv.Key" selected="selected">@kv.Value</option>
                    }
                    else
                    {
                        <option value="@kv.Key">@kv.Value</option>
                    }
                }
            </select>
        </form>
    </section>

    <section class="store-advanced-panel" id="advancedFiltersPanel" hidden>
        <form asp-area=""
              asp-controller="Home"
              asp-action="Index"
              method="get"
              class="store-filter-form">

            <input type="hidden" name="OrdenarPor" value="@Model.Filtros.OrdenarPor" />

            <div class="store-filter-grid">
                <div class="store-field">
                    <label>Buscar</label>
                    <input name="Termo"
                           value="@termoAtual"
                           placeholder="Ex: Heineken, Coca-Cola, Pod..." />
                </div>

                <div class="store-field">
                    <label>Categoria</label>
                    <select name="Categoria">
                        <option value="">Todas categorias</option>

                        @foreach (var categoria in categorias)
                        {
                            if (string.Equals(categoriaAtual, categoria, StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@categoria" selected="selected">@categoria</option>
                            }
                            else
                            {
                                <option value="@categoria">@categoria</option>
                            }
                        }
                    </select>
                </div>

                <div class="store-field">
                    <label>Preço mín</label>
                    <input name="PrecoMin"
                           value="@(Model.Filtros.PrecoMin?.ToString() ?? "")"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="R$" />
                </div>

                <div class="store-field">
                    <label>Preço máx</label>
                    <input name="PrecoMax"
                           value="@(Model.Filtros.PrecoMax?.ToString() ?? "")"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="R$" />
                </div>
            </div>

            <div class="store-filter-options">
                <label>
                    <input type="checkbox"
                           name="ApenasPromocoes"
                           value="true"
                           @(Model.Filtros.ApenasPromocoes ? "checked" : "") />
                    Promoções
                </label>

                <label>
                    <input type="checkbox"
                           name="ApenasEstoque"
                           value="true"
                           @(Model.Filtros.ApenasEstoque ? "checked" : "") />
                    Em estoque
                </label>
            </div>

            <div class="store-filter-actions">
                <a href="@Url.Action("Index", "Home")" class="store-btn store-btn-light">
                    Limpar
                </a>

                <button type="submit" class="store-btn store-btn-primary">
                    Aplicar filtros
                </button>
            </div>
        </form>
    </section>

    <main class="store-products-section">
        @if (produtos.Any())
        {
            <div class="store-product-grid">
                @foreach (var produto in produtos)
                {
                    var promoOk = produto.EmPromocao
                    && produto.PrecoPromocional.HasValue
                    && produto.PrecoPromocional.Value > 0
                    && produto.PrecoPromocional.Value < produto.Preco;

                    var precoAtual = promoOk ? produto.PrecoPromocional!.Value : produto.Preco;

                    var estaEsgotado = produto.EstaEsgotado;
                    var estoqueBaixo = produto.EstaComEstoqueBaixo;

                    var isPod = produto.TipoProduto == ProdutoTipo.PodVape;
                    var isBebida = produto.TipoProduto == ProdutoTipo.BebidaAlcoolica
                    || produto.BebidaVolumeMl.HasValue
                    || produto.BebidaEmbalagem.HasValue
                    || produto.BebidaQtdPorEmbalagem.HasValue
                    || !string.IsNullOrWhiteSpace(produto.BebidaTipo);

                    var exigeSelecaoDeSabor = isPod
                    || (
                    produto.SaboresQuantidadesList != null &&
                    produto.SaboresQuantidadesList.Any(s => s.Quantidade > 0)
                    );

                    var categoriaLabel = produto.Categoria?.Nome
                    ?? (isPod ? "Pod" : isBebida ? "Bebida" : "Produto");

                    var embalagemTexto = produto.UnidadeVendaDescricao;

                    var temVolume = produto.BebidaVolumeMl.HasValue && produto.BebidaVolumeMl.Value > 0;
                    var descricaoCurta = "";

                    if (isBebida)
                    {
                        var volume = temVolume ? $"{produto.BebidaVolumeMl.Value}ml" : "";
                        descricaoCurta = string.Join(" • ", new[] { embalagemTexto, volume }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    }
                    else if (isPod)
                    {
                        var puffs = produto.PodPuffs.HasValue && produto.PodPuffs.Value > 0
                        ? $"{produto.PodPuffs.Value} puffs"
                        : "";

                        descricaoCurta = string.Join(" • ", new[] { produto.Sabor, puffs }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    }
                    else
                    {
                        descricaoCurta = embalagemTexto;
                    }

                    if (string.IsNullOrWhiteSpace(descricaoCurta))
                    {
                        descricaoCurta = produto.Descricao ?? "";
                    }

                    <article class="store-product-card @(estaEsgotado ? "is-sold-out" : "")">
                        <a asp-area=""
                           asp-controller="Produto"
                           asp-action="Detalhes"
                           asp-route-id="@produto.Id"
                           class="store-product-image-link"
                           aria-label="@produto.Nome">

                            <div class="store-product-image">
                                @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                                {
                                    <img src="@Url.Content(produto.ImagemUrl)"
                                         alt="@produto.Nome"
                                         loading="lazy"
                                         decoding="async" />
                                }
                                else
                                {
                                    <div class="store-product-placeholder">
                                        <i class="fa-regular fa-image"></i>
                                    </div>
                                }

                                @if (estaEsgotado)
                                {
                                    <span class="store-product-badge is-out">Esgotado</span>
                                }
                                else if (estoqueBaixo)
                                {
                                    <span class="store-product-badge is-low">Últimas</span>
                                }
                                else if (promoOk)
                                {
                                    <span class="store-product-badge is-promo">Promo</span>
                                }
                            </div>
                        </a>

                        <div class="store-product-body">
                            <a asp-area=""
                               asp-controller="Produto"
                               asp-action="Detalhes"
                               asp-route-id="@produto.Id"
                               class="store-product-info-link">

                                <span class="store-product-category">@categoriaLabel</span>

                                <h2>@produto.Nome</h2>

                                @if (!string.IsNullOrWhiteSpace(descricaoCurta))
                                {
                                    <p>@descricaoCurta</p>
                                }

                                @if (!estaEsgotado)
                                {
                                    <div class="store-stock-pill is-ok">
                                        <i class="fa-solid fa-circle-check"></i>
                                        <span>Em estoque</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="store-stock-pill is-out">
                                        <i class="fa-solid fa-circle-xmark"></i>
                                        <span>Esgotado</span>
                                    </div>
                                }

                                @if (!estaEsgotado)
                                {
                                    <div class="store-stock-summary">
                                        <i class="fa-solid fa-cube"></i>
                                        <span>Estoque: @produto.EstoqueDescricao</span>
                                    </div>
                                }
                            </a>

                            <div class="store-product-footer">
                                <div class="store-price">
                                    @if (promoOk)
                                    {
                                        <span class="old">@produto.Preco.ToString("C")</span>
                                    }

                                    <strong>@precoAtual.ToString("C")</strong>
                                </div>

                                @if (!estaEsgotado)
                                {
                                    if (exigeSelecaoDeSabor)
                                    {
                                        <a asp-area=""
                                           asp-controller="Produto"
                                           asp-action="Detalhes"
                                           asp-route-id="@produto.Id"
                                           class="store-add-btn"
                                           title="Escolher opções"
                                           aria-label="Escolher opções de @produto.Nome">
                                            <i class="fa-solid fa-list-check"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <form asp-controller="Carrinho"
                                              asp-action="AdicionarItem"
                                              method="post"
                                              class="quick-add-form store-quick-add-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="produtoId" value="@produto.Id" />
                                            <input type="hidden" name="quantidade" value="1" />
                                            <input type="hidden" name="sabor" value="" />
                                            <input type="hidden" name="observacoes" value="" />
                                            <input type="hidden" name="buyNow" value="false" />

                                            <button type="submit"
                                                    class="store-add-btn quick-add"
                                                    data-product-id="@produto.Id"
                                                    title="Adicionar ao carrinho"
                                                    aria-label="Adicionar @produto.Nome ao carrinho">
                                                <i class="fa-solid fa-plus qa-icon" aria-hidden="true"></i>
                                                <i class="fa-solid fa-spinner fa-spin qa-spin" aria-hidden="true"></i>
                                                <i class="fa-solid fa-check qa-done" aria-hidden="true"></i>
                                            </button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    <button type="button"
                                            class="store-add-btn disabled"
                                            disabled
                                            title="Produto esgotado"
                                            aria-label="@produto.Nome esgotado">
                                        <i class="fa-solid fa-ban"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="store-empty-state">
                <i class="fa-solid fa-box-open"></i>
                <strong>Nenhum produto encontrado</strong>
                <span>Tente ajustar os filtros para encontrar o que procura.</span>
            </div>
        }
    </main>

    <aside class="store-cart-dock @(carrinhoCountInicial > 0 ? "is-visible" : "")" id="storeCartDock">
        <div class="store-cart-info">
            <div class="store-cart-icon">
                <i class="fa-solid fa-cart-shopping"></i>
                <span id="storeCartDockCount">@carrinhoCountInicial</span>
            </div>

            <div>
                <strong><span id="storeCartDockText">@carrinhoCountInicial</span> item(ns) no carrinho</strong>
                <small>Continue pelo carrinho</small>
            </div>
        </div>

        <a asp-controller="Carrinho"
           asp-action="Index"
           class="store-cart-button">
            Ver carrinho
        </a>
    </aside>
</div>

@section Scripts {
    <script>
        (function () {
            const STORAGE_KEY = 'produtos_adicionados_carrinho';

            const produtosNoCarrinhoServidor = @Html.Raw(produtosNoCarrinhoJson);

            const filtersToggle = document.getElementById('advancedFiltersToggle');
            const filtersPanel = document.getElementById('advancedFiltersPanel');

            filtersToggle?.addEventListener('click', function () {
                if (!filtersPanel) return;

                const isHidden = filtersPanel.hasAttribute('hidden');

                if (isHidden) {
                    filtersPanel.removeAttribute('hidden');
                    filtersToggle.classList.add('active');
                    return;
                }

                filtersPanel.setAttribute('hidden', 'hidden');
                filtersToggle.classList.remove('active');
            });

            function getStorage() {
                try {
                    const data = localStorage.getItem(STORAGE_KEY);
                    if (!data) return [];

                    const parsed = JSON.parse(data);
                    return Array.isArray(parsed) ? parsed.map(String) : [];
                } catch {
                    return [];
                }
            }

            function saveStorage(ids) {
                localStorage.setItem(
                    STORAGE_KEY,
                    JSON.stringify([...new Set((ids || []).map(String))])
                );
            }

            function addStorage(id) {
                id = String(id || '');
                if (!id) return;

                const ids = getStorage();

                if (!ids.includes(id)) {
                    ids.push(id);
                    saveStorage(ids);
                }
            }

            function setButtonState(button, state) {
                if (!button) return;

                const cart = button.querySelector('.qa-icon');
                const spin = button.querySelector('.qa-spin');
                const done = button.querySelector('.qa-done');

                button.classList.remove('is-loading', 'is-success');

                if (cart) cart.style.display = 'none';
                if (spin) spin.style.display = 'none';
                if (done) done.style.display = 'none';

                if (state === 'loading') {
                    button.classList.add('is-loading');
                    if (spin) spin.style.display = 'inline-block';
                    return;
                }

                if (state === 'success') {
                    button.classList.add('is-success');
                    if (done) done.style.display = 'inline-block';
                    return;
                }

                if (cart) cart.style.display = 'inline-block';
            }

            function updateCartCount(count) {
                const normalized = Number(count || 0);

                const els = document.querySelectorAll('[data-cart-count], .cart-count, #cartCount');
                els.forEach(el => el.textContent = normalized);

                const dock = document.getElementById('storeCartDock');
                const dockCount = document.getElementById('storeCartDockCount');
                const dockText = document.getElementById('storeCartDockText');

                if (dockCount) dockCount.textContent = normalized;
                if (dockText) dockText.textContent = normalized;

                if (dock) {
                    dock.classList.toggle('is-visible', normalized > 0);
                }
            }

            function sincronizarStorageComServidor() {
                const idsServidor = Array.isArray(produtosNoCarrinhoServidor)
                    ? produtosNoCarrinhoServidor.map(String)
                    : [];

                saveStorage(idsServidor);
                return idsServidor;
            }

            function restoreButtons() {
                const ids = sincronizarStorageComServidor();

                document.querySelectorAll('button.quick-add[data-product-id]').forEach(button => {
                    const id = String(button.dataset.productId || '');

                    if (ids.includes(id)) {
                        setButtonState(button, 'success');
                    } else {
                        setButtonState(button, 'default');
                    }
                });

                updateCartCount(ids.length);
            }

            async function submitQuickAdd(form) {
                const button = form.querySelector('button.quick-add');
                if (!button) return;

                const productId = button.dataset.productId;
                if (!productId) return;

                if (button.classList.contains('is-success')) return;

                setButtonState(button, 'loading');

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        credentials: 'same-origin'
                    });

                    const contentType = response.headers.get('content-type') || '';
                    let data = null;

                    if (contentType.includes('application/json')) {
                        data = await response.json();
                    }

                    if (!response.ok) {
                        throw new Error(data?.error || 'Erro ao adicionar produto.');
                    }

                    if (data && data.ok === false) {
                        throw new Error(data.error || 'Não foi possível adicionar.');
                    }

                    addStorage(productId);
                    setButtonState(button, 'success');

                    const ids = getStorage();
                    updateCartCount(data && typeof data.count !== 'undefined' ? data.count : ids.length);
                } catch (e) {
                    console.error(e);
                    setButtonState(button, 'default');

                    alert(e?.message || 'Não foi possível adicionar o produto ao carrinho.');
                }
            }

            document.addEventListener('submit', function (e) {
                const form = e.target.closest('form.quick-add-form');
                if (!form) return;

                const button = form.querySelector('button.quick-add');
                if (!button) return;

                e.preventDefault();
                e.stopPropagation();

                submitQuickAdd(form);
            });

            document.addEventListener('DOMContentLoaded', restoreButtons);
            window.addEventListener('pageshow', restoreButtons);

            window.produtosCarrinho = {
                listar: () => getStorage(),
                limpar: () => {
                    localStorage.removeItem(STORAGE_KEY);
                    restoreButtons();
                },
                sincronizar: restoreButtons
            };
        })();
    </script>
}