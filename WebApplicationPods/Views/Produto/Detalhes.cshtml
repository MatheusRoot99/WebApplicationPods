@using System.Globalization
@using WebApplicationPods.Enum
@model WebApplicationPods.Models.ProdutoDetalhesViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = Model?.Produto?.Nome ?? "Produto";
    ViewData["HideStoreHeader"] = true;

    var produto = Model?.Produto;
    if (produto == null)
    {
        <div class="container py-5">
            <div class="alert alert-warning">Produto não encontrado.</div>
        </div>
        return;
    }

    var temPromocao = produto.PrecoPromocional.HasValue
        && produto.PrecoPromocional.Value > 0
        && produto.PrecoPromocional.Value < produto.Preco;

    var precoAtual = temPromocao ? produto.PrecoPromocional!.Value : produto.Preco;

    var isPod = produto.TipoProduto == ProdutoTipo.PodVape;
    var isBebida = produto.TipoProduto == ProdutoTipo.BebidaAlcoolica
        || produto.BebidaVolumeMl.HasValue
        || produto.BebidaEmbalagem.HasValue
        || produto.BebidaQtdPorEmbalagem.HasValue
        || !string.IsNullOrWhiteSpace(produto.BebidaTipo);

    var isPadrao = !isPod && !isBebida;

    var totalSabores = Model?.SaboresDisponiveis?.Count ?? 0;
    var totalSaboresComEstoque = Model?.SaboresDisponiveis?.Count(s => s.Quantidade > 0) ?? 0;

    string tipoLabel = isPod ? "Pod" : isBebida ? "Bebida" : "Produto";

    var disponibilidade = produto.StatusEstoqueTexto;
    var statusCss = produto.StatusEstoqueCss;

    var estoqueDescricao = produto.EstoqueDescricao;
    var unidadeVendaDescricao = produto.UnidadeVendaDescricao;

    var desconto = temPromocao
        ? (int)Math.Round(100 - (precoAtual / produto.Preco * 100))
        : 0;

    var estaEsgotado = produto.EstaEsgotado;

    var temVolume = produto.BebidaVolumeMl.HasValue && produto.BebidaVolumeMl.Value > 0;
    var volumeTexto = temVolume ? $"{produto.BebidaVolumeMl.GetValueOrDefault()} ml" : "";

    var temEmbalagem = !string.IsNullOrWhiteSpace(unidadeVendaDescricao);
    var temTipoBebida = !string.IsNullOrWhiteSpace(produto.BebidaTipo);

    var temPuffs = produto.PodPuffs.HasValue && produto.PodPuffs.Value > 0;
    var temBateria = !string.IsNullOrWhiteSpace(produto.PodCapacidadeBateria);
    var temTipoPod = !string.IsNullOrWhiteSpace(produto.PodTipo);
    var temSaborPod = !string.IsNullOrWhiteSpace(produto.Sabor);

    var mostrarEstoqueFisico = isBebida
        && produto.BebidaQtdPorEmbalagem.HasValue
        && produto.BebidaQtdPorEmbalagem.Value > 1;

    var estoqueFisicoTotal = mostrarEstoqueFisico
        ? produto.Estoque * produto.BebidaQtdPorEmbalagem.GetValueOrDefault()
        : produto.Estoque;
}

@section Styles {
    <link rel="stylesheet" href="~/css/produto-detalhes.css" asp-append-version="true" />
}

<div id="product-data"
     data-stock="@produto.Estoque"
     data-is-out-of-stock="@(estaEsgotado ? "true" : "false")"
     data-resumo-url="@Url.Action("Resumo", "Carrinho")"
     hidden>
</div>

<div class="pdp-page" itemscope itemtype="https://schema.org/Product">

    <div class="pdp-topbar">
        <a href="javascript:history.back()" class="pdp-back">
            <i class="fas fa-arrow-left"></i>
            <span>Voltar</span>
        </a>

        <div class="pdp-topbar-badges">
            <span class="pdp-chip pdp-chip-type">@tipoLabel</span>

            @if (produto.RequerMaioridade)
            {
                <span class="pdp-chip pdp-chip-age">
                    <i class="fas fa-ban"></i>
                    18+
                </span>
            }

            @if (estaEsgotado)
            {
                <span class="pdp-chip pdp-chip-out">Esgotado</span>
            }
            else if (produto.EstaComEstoqueBaixo)
            {
                <span class="pdp-chip pdp-chip-low">Estoque baixo</span>
            }
            else
            {
                <span class="pdp-chip pdp-chip-in">Disponível</span>
            }
        </div>
    </div>

    <section class="pdp-hero">
        <div class="pdp-gallery-card">
            <div class="pdp-gallery-stage">
                @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                {
                    <img src="@Url.Content(produto.ImagemUrl)"
                         alt="@produto.Nome"
                         class="pdp-main-image"
                         width="900"
                         height="900"
                         loading="lazy"
                         decoding="async"
                         itemprop="image" />
                }
                else
                {
                    <div class="pdp-image-placeholder">
                        <i class="fas fa-image"></i>
                        <span>Imagem não disponível</span>
                    </div>
                }
            </div>

            <div class="pdp-trust-list">
                <div class="pdp-trust-item">
                    <i class="fas fa-shield-alt"></i>
                    <span>Compra segura</span>
                </div>

                <div class="pdp-trust-item">
                    <i class="fas fa-bolt"></i>
                    <span>Pedido rápido</span>
                </div>

                @if (!estaEsgotado)
                {
                    <div class="pdp-trust-item">
                        <i class="fas fa-box-open"></i>
                        <span>Em estoque</span>
                    </div>
                }
            </div>
        </div>

        <aside class="pdp-summary-card">
            <header class="pdp-header">
                <div class="pdp-header-main">
                    <h1 class="pdp-title" itemprop="name">@produto.Nome</h1>

                    @if (!string.IsNullOrWhiteSpace(produto.Marca))
                    {
                        <div class="pdp-subline">
                            <span class="pdp-brand">@produto.Marca</span>
                        </div>
                    }
                </div>
            </header>

            <section class="pdp-price-box pdp-price-box--clean" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                <meta itemprop="priceCurrency" content="BRL" />
                <meta itemprop="price" content="@precoAtual.ToString(CultureInfo.InvariantCulture)" />
                <link itemprop="availability" href="https://schema.org/@(!estaEsgotado ? "InStock" : "OutOfStock")" />

                <div class="pdp-price-top">
                    <div class="pdp-price-main">
                        @if (temPromocao)
                        {
                            <span class="pdp-old-price">@produto.Preco.ToString("C")</span>
                        }

                        <div class="pdp-price-line">
                            <span class="pdp-current-price">@precoAtual.ToString("C")</span>

                            @if (temPromocao)
                            {
                                <span class="pdp-discount-badge">
                                    <i class="fas fa-tag"></i>
                                    @desconto% OFF
                                </span>
                            }
                        </div>
                    </div>

                    <div class="pdp-stock-badge @statusCss">
                        <i class="fas @(!estaEsgotado ? "fa-check-circle" : "fa-times-circle")"></i>
                        <span>@disponibilidade</span>
                    </div>
                </div>
            </section>

            <section class="pdp-highlights">
                <div class="pdp-highlight-grid">
                    @if (isPod)
                    {
                        @if (temSaborPod)
                        {
                            <div class="pdp-info-card is-wide">
                                <span>Sabor</span>
                                <strong>@produto.Sabor</strong>
                            </div>
                        }

                        @if (temPuffs)
                        {
                            <div class="pdp-info-card">
                                <span>Puffs</span>
                                <strong>@produto.PodPuffs.GetValueOrDefault()</strong>
                            </div>
                        }

                        @if (temBateria)
                        {
                            <div class="pdp-info-card">
                                <span>Bateria</span>
                                <strong>@produto.PodCapacidadeBateria</strong>
                            </div>
                        }

                        @if (temTipoPod)
                        {
                            <div class="pdp-info-card">
                                <span>Tipo</span>
                                <strong>@produto.PodTipo</strong>
                            </div>
                        }

                        <div class="pdp-info-card">
                            <span>Estoque</span>
                            <strong>@estoqueDescricao</strong>
                        </div>
                    }
                    else if (isBebida)
                    {
                        @if (temVolume)
                        {
                            <div class="pdp-info-card">
                                <span>Volume</span>
                                <strong>@volumeTexto</strong>
                            </div>
                        }

                        @if (temEmbalagem)
                        {
                            <div class="pdp-info-card">
                                <span>Venda</span>
                                <strong>@unidadeVendaDescricao</strong>
                            </div>
                        }

                        @if (temTipoBebida)
                        {
                            <div class="pdp-info-card">
                                <span>Tipo</span>
                                <strong>@produto.BebidaTipo</strong>
                            </div>
                        }

                        @*<div class="pdp-info-card">
                            <span>Estoque</span>
                            <strong>@estoqueDescricao</strong>
                        </div>*@

                        @if (mostrarEstoqueFisico)
                        {
                            @*<div class="pdp-info-card">
                                <span>Total físico</span>
                                <strong>@estoqueFisicoTotal unidades</strong>
                            </div>*@
                        }
                    }
                    else
                    {
                        @*<div class="pdp-info-card">
                            <span>Estoque</span>
                            <strong>@estoqueDescricao</strong>
                        </div>*@
                    }
                </div>
            </section>

            @if (isPod && Model?.SaboresDisponiveis != null && Model.SaboresDisponiveis.Any())
            {
                <section class="pdp-flavors-box">
                    <div class="pdp-section-head">
                        <h3>Escolha o sabor</h3>
                        <small>@totalSaboresComEstoque de @totalSabores disponível(is)</small>
                    </div>

                    <fieldset class="pdp-flavors-fieldset" @(estaEsgotado ? "disabled" : null)>
                        <legend class="visually-hidden">Sabores disponíveis</legend>

                        <div class="pdp-flavors-grid">
                            @{
                                var idx = 0;
                            }

                            @foreach (var sabor in Model.SaboresDisponiveis)
                            {
                                var saborId = $"sabor-{idx++}";
                                var disabled = sabor.Quantidade <= 0 || estaEsgotado;

                                <div class="pdp-flavor-item @(disabled ? "is-disabled" : "")">
                                    <input type="radio"
                                           name="flavor"
                                           id="@saborId"
                                           value="@sabor.Sabor"
                                           class="pdp-flavor-radio"
                                           data-estoque="@sabor.Quantidade"
                                           @(disabled ? "disabled" : null) />

                                    <label for="@saborId" class="pdp-flavor-label">
                                        <span class="pdp-flavor-name">@sabor.Sabor</span>
                                        <small>@(disabled ? "Esgotado" : $"{sabor.Quantidade} em estoque")</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </fieldset>

                    <div class="pdp-flavor-stock" id="estoque-info" hidden>
                        <i class="fas fa-boxes"></i>
                        Estoque do sabor: <strong id="estoque-quantidade"></strong>
                    </div>
                </section>
            }

            <section class="pdp-buy-box">
                <div class="pdp-qty-wrap">
                    <label for="quantity" class="pdp-qty-label">Quantidade</label>
                    <small class="pdp-qty-helper">@unidadeVendaDescricao</small>

                    <div class="pdp-qty-control">
                        <button type="button"
                                class="pdp-qty-btn minus"
                                aria-label="Diminuir"
                                @(estaEsgotado ? "disabled" : null)>
                            -
                        </button>

                        <input type="number"
                               id="quantity"
                               value="1"
                               min="1"
                               max="@(!estaEsgotado ? produto.Estoque : 1)"
                               class="pdp-qty-input"
                               @(estaEsgotado ? "disabled" : null) />

                        <button type="button"
                                class="pdp-qty-btn plus"
                                aria-label="Aumentar"
                                @(estaEsgotado ? "disabled" : null)>
                            +
                        </button>
                    </div>
                </div>

                <form asp-controller="Carrinho" asp-action="AdicionarItem" method="post" id="addToCartForm" class="pdp-buy-form" data-cart-local-handler="true">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="produtoId" value="@produto.Id" />
                    <input type="hidden" name="quantidade" id="quantidadeHidden" value="1" />
                    <input type="hidden" name="sabor" id="saborSelecionado" value="@(isPod && !string.IsNullOrWhiteSpace(produto.Sabor) ? produto.Sabor : "")" />
                    <input type="hidden" name="observacoes" id="observacoesProduto" value="" />
                    <input type="hidden" name="buyNow" id="buyNowHidden" value="false" />

                    <div class="pdp-buy-actions">
                        <button type="submit"
                                id="addToCartBtn"
                                class="pdp-btn pdp-btn-primary @(estaEsgotado ? "is-disabled" : "")"
                                @(estaEsgotado ? "disabled" : null)>
                            <i class="fas fa-shopping-cart"></i>
                            @(estaEsgotado ? "Produto esgotado" : "Adicionar ao carrinho")
                        </button>

                        <button type="button"
                                id="buyNowBtn"
                                class="pdp-btn pdp-btn-secondary @(estaEsgotado ? "is-disabled" : "")"
                                @(estaEsgotado ? "disabled" : null)>
                            <i class="fas fa-bolt"></i>
                            @(estaEsgotado ? "Indisponível" : "Comprar agora")
                        </button>
                    </div>
                </form>
            </section>
        </aside>
    </section>

    <section class="pdp-tabs-section">
        <div class="pdp-tabs-header" role="tablist">
            <button class="pdp-tab-btn active" type="button" data-tab="descricao">Descrição</button>
            <button class="pdp-tab-btn" type="button" data-tab="especificacoes">Especificações</button>
            <button class="pdp-tab-btn" type="button" data-tab="informacoes">Info</button>
        </div>

        <div class="pdp-tab-pane active" data-pane="descricao">
            <div class="pdp-content-card">
                <h3>Descrição</h3>
                <p>@(string.IsNullOrWhiteSpace(produto.Descricao) ? "Sem descrição cadastrada." : produto.Descricao)</p>
            </div>
        </div>

        <div class="pdp-tab-pane" data-pane="especificacoes">
            <div class="pdp-content-card">
                <h3>Especificações</h3>

                <div class="pdp-specs-grid">
                    @if (!string.IsNullOrWhiteSpace(produto.Marca))
                    {
                        <div class="pdp-spec-item">
                            <span>Marca</span>
                            <strong>@produto.Marca</strong>
                        </div>
                    }

                    <div class="pdp-spec-item">
                        <span>Preço</span>
                        <strong>@precoAtual.ToString("C")</strong>
                    </div>

                    <div class="pdp-spec-item">
                        <span>Estoque</span>
                        <strong>@estoqueDescricao</strong>
                    </div>

                    @if (isPod)
                    {
                        @if (temSaborPod)
                        {
                            <div class="pdp-spec-item">
                                <span>Sabor</span>
                                <strong>@produto.Sabor</strong>
                            </div>
                        }

                        @if (temPuffs)
                        {
                            <div class="pdp-spec-item">
                                <span>Puffs</span>
                                <strong>@produto.PodPuffs.GetValueOrDefault()</strong>
                            </div>
                        }

                        @if (temBateria)
                        {
                            <div class="pdp-spec-item">
                                <span>Bateria</span>
                                <strong>@produto.PodCapacidadeBateria</strong>
                            </div>
                        }

                        @if (temTipoPod)
                        {
                            <div class="pdp-spec-item">
                                <span>Tipo do pod</span>
                                <strong>@produto.PodTipo</strong>
                            </div>
                        }
                    }

                    @if (isBebida)
                    {
                        @if (temVolume)
                        {
                            <div class="pdp-spec-item">
                                <span>Volume</span>
                                <strong>@volumeTexto</strong>
                            </div>
                        }

                        @if (temTipoBebida)
                        {
                            <div class="pdp-spec-item">
                                <span>Tipo</span>
                                <strong>@produto.BebidaTipo</strong>
                            </div>
                        }

                        @if (temEmbalagem)
                        {
                            <div class="pdp-spec-item">
                                <span>Venda</span>
                                <strong>@unidadeVendaDescricao</strong>
                            </div>
                        }

                        @if (mostrarEstoqueFisico)
                        {
                            <div class="pdp-spec-item">
                                <span>Total físico em estoque</span>
                                <strong>@estoqueFisicoTotal unidades</strong>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="pdp-tab-pane" data-pane="informacoes">
            <div class="pdp-content-card">
                <h3>Informações adicionais</h3>

                <ul class="pdp-info-list">
                    <li>Produto vendido por loja vinculada à plataforma.</li>
                    <li>Disponibilidade sujeita à atualização de estoque.</li>

                    @if (produto.RequerMaioridade)
                    {
                        <li>Venda permitida apenas para maiores de 18 anos.</li>
                    }

                    @if (isPod)
                    {
                        <li>Selecione o sabor antes de adicionar ao carrinho.</li>
                    }

                    @if (isBebida)
                    {
                        <li>Confira volume e embalagem antes da compra.</li>
                    }
                </ul>
            </div>
        </div>
    </section>

    @if (Model?.ProdutosRelacionados != null && Model.ProdutosRelacionados.Any())
    {
        <section class="pdp-related-section">
            <div class="pdp-related-head">
                <div>
                    <h2>Você também pode gostar</h2>
                    <p>Outras opções disponíveis na loja.</p>
                </div>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="pdp-related-see-all">
                    Ver todos
                </a>
            </div>

            <div class="pdp-related-grid">
                @foreach (var pr in Model.ProdutosRelacionados)
                {
                    var prTemPromo = pr.PrecoPromocional.HasValue
                    && pr.PrecoPromocional.Value > 0
                    && pr.PrecoPromocional.Value < pr.Preco;

                    var prPreco = prTemPromo ? pr.PrecoPromocional!.Value : pr.Preco;
                    var prEsgotado = pr.EstaEsgotado;
                    var prEstoqueBaixo = pr.EstaComEstoqueBaixo;

                    var prCategoria = pr.Categoria?.Nome ?? "Produto";

                    var prIsPod = pr.TipoProduto == ProdutoTipo.PodVape;
                    var prIsBebida = pr.TipoProduto == ProdutoTipo.BebidaAlcoolica
                    || pr.BebidaVolumeMl.HasValue
                    || pr.BebidaEmbalagem.HasValue
                    || pr.BebidaQtdPorEmbalagem.HasValue
                    || !string.IsNullOrWhiteSpace(pr.BebidaTipo);

                    var prDescricaoCurta = "";

                    if (prIsBebida)
                    {
                        var volume = pr.BebidaVolumeMl.HasValue && pr.BebidaVolumeMl.Value > 0
                        ? $"{pr.BebidaVolumeMl.Value}ml"
                        : "";

                        prDescricaoCurta = string.Join(" • ", new[] { pr.UnidadeVendaDescricao, volume }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    }
                    else if (prIsPod)
                    {
                        var puffs = pr.PodPuffs.HasValue && pr.PodPuffs.Value > 0
                        ? $"{pr.PodPuffs.Value} puffs"
                        : "";

                        prDescricaoCurta = string.Join(" • ", new[] { pr.Sabor, puffs }.Where(x => !string.IsNullOrWhiteSpace(x)));
                    }
                    else
                    {
                        prDescricaoCurta = pr.UnidadeVendaDescricao;
                    }

                    if (string.IsNullOrWhiteSpace(prDescricaoCurta))
                    {
                        prDescricaoCurta = pr.Descricao ?? "";
                    }

                    <article class="pdp-related-card @(prEsgotado ? "is-sold-out" : "")">
                        <a asp-controller="Produto"
                           asp-action="Detalhes"
                           asp-route-id="@pr.Id"
                           class="pdp-related-link"
                           aria-label="@pr.Nome">

                            <div class="pdp-related-image">
                                @if (!string.IsNullOrWhiteSpace(pr.ImagemUrl))
                                {
                                    <img src="@Url.Content(pr.ImagemUrl)"
                                         alt="@pr.Nome"
                                         loading="lazy"
                                         decoding="async" />
                                }
                                else
                                {
                                    <div class="pdp-related-placeholder">
                                        <i class="fas fa-image"></i>
                                    </div>
                                }

                                @if (prEsgotado)
                                {
                                    <span class="pdp-related-ribbon is-out">
                                        Esgotado
                                    </span>
                                }
                                else if (prEstoqueBaixo)
                                {
                                    <span class="pdp-related-ribbon is-low">
                                        Últimas
                                    </span>
                                }
                                else if (prTemPromo)
                                {
                                    <span class="pdp-related-ribbon is-promo">
                                        Promo
                                    </span>
                                }
                            </div>

                            <div class="pdp-related-body">
                                <span class="pdp-related-category">@prCategoria</span>

                                <h3>@pr.Nome</h3>

                                @if (!string.IsNullOrWhiteSpace(prDescricaoCurta))
                                {
                                    <p>@prDescricaoCurta</p>
                                }

                                <div class="pdp-related-footer">
                                    <div class="pdp-related-price">
                                        @if (prTemPromo)
                                        {
                                            <span class="old">@pr.Preco.ToString("C")</span>
                                        }

                                        <span class="new">@prPreco.ToString("C")</span>
                                    </div>

                                    <span class="pdp-related-add @(prEsgotado ? "disabled" : "")">
                                        <i class="fas @(prEsgotado ? "fa-ban" : "fa-plus")"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const productData = document.getElementById('product-data');
            const isOutOfStock = productData?.dataset?.isOutOfStock === 'true';
            const resumoUrl = productData?.dataset?.resumoUrl || '/Carrinho/Resumo';

            const qtd = document.getElementById('quantity');
            const qtdHidden = document.getElementById('quantidadeHidden');
            const minus = document.querySelector('.pdp-qty-btn.minus');
            const plus = document.querySelector('.pdp-qty-btn.plus');

            const form = document.getElementById('addToCartForm');
            const addToCartBtn = document.getElementById('addToCartBtn');
            const buyNowBtn = document.getElementById('buyNowBtn');
            const buyNowHidden = document.getElementById('buyNowHidden');

            const flavorRadios = document.querySelectorAll('.pdp-flavor-radio');
            const saborSelecionado = document.getElementById('saborSelecionado');
            const estoqueInfo = document.getElementById('estoque-info');
            const estoqueQuantidade = document.getElementById('estoque-quantidade');

            const max = parseInt(qtd?.max || '1', 10);

            function normalizeQty() {
                if (!qtd) return;

                let value = parseInt(qtd.value || '1', 10);

                if (isNaN(value) || value < 1) value = 1;
                if (value > max) value = max;

                qtd.value = value;

                if (qtdHidden) qtdHidden.value = value;
            }

            function hasFlavorOptions() {
                return flavorRadios.length > 0;
            }

            function getSelectedFlavor() {
                return document.querySelector('.pdp-flavor-radio:checked');
            }

            function flavorIsRequiredAndMissing() {
                if (!hasFlavorOptions()) return false;
                return !getSelectedFlavor();
            }

            function updateButtonsState() {
                const missingFlavor = flavorIsRequiredAndMissing();

                if (addToCartBtn) {
                    addToCartBtn.disabled = isOutOfStock || missingFlavor;
                    addToCartBtn.title = missingFlavor ? 'Selecione um sabor antes de continuar.' : '';
                }

                if (buyNowBtn) {
                    buyNowBtn.disabled = isOutOfStock || missingFlavor;
                    buyNowBtn.title = missingFlavor ? 'Selecione um sabor antes de continuar.' : '';
                }
            }

            function setLoading(button, loading, text) {
                if (!button) return;

                if (loading) {
                    button.dataset.originalText = button.innerHTML;
                    button.disabled = true;
                    button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> ' + text;
                } else {
                    button.disabled = false;

                    if (button.dataset.originalText) {
                        button.innerHTML = button.dataset.originalText;
                    }
                }
            }

            async function submitCart(buyNow) {
                if (!form || isOutOfStock) return;

                normalizeQty();

                if (flavorIsRequiredAndMissing()) {
                    alert('Selecione um sabor antes de continuar.');
                    return;
                }

                if (buyNowHidden) buyNowHidden.value = buyNow ? 'true' : 'false';

                const button = buyNow ? buyNowBtn : addToCartBtn;
                setLoading(button, true, buyNow ? 'Indo para compra...' : 'Adicionando...');

                try {
                    const formData = new FormData(form);

                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'RequestVerificationToken': form.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                        },
                        credentials: 'same-origin',
                        cache: 'no-store'
                    });

                    const data = await response.json();

                    if (!data?.ok) {
                        alert(data?.error || 'Não foi possível adicionar ao carrinho.');
                        return;
                    }

                    if (typeof window.updateCartBadges === 'function') {
                        window.updateCartBadges(data.count || 0);
                    }

                    if (buyNow || data.buyNow) {
                        window.location.href = resumoUrl;
                        return;
                    }

                    if (addToCartBtn) {
                        addToCartBtn.classList.add('is-added');
                        addToCartBtn.innerHTML = '<i class="fa-solid fa-check"></i> Adicionado';

                        setTimeout(function () {
                            addToCartBtn.classList.remove('is-added');
                            addToCartBtn.innerHTML = '<i class="fas fa-shopping-cart"></i> Adicionar ao carrinho';
                        }, 900);
                    }
                } catch {
                    alert('Erro ao adicionar ao carrinho. Tente novamente.');
                } finally {
                    setLoading(button, false);
                }
            }

            minus?.addEventListener('click', function () {
                if (!qtd || isOutOfStock) return;
                qtd.stepDown();
                normalizeQty();
            });

            plus?.addEventListener('click', function () {
                if (!qtd || isOutOfStock) return;
                qtd.stepUp();
                normalizeQty();
            });

            qtd?.addEventListener('input', normalizeQty);
            qtd?.addEventListener('change', normalizeQty);

            flavorRadios.forEach(radio => {
                radio.addEventListener('change', function (event) {
                    const value = event.target.value;
                    const estoque = event.target.getAttribute('data-estoque') || '0';

                    if (saborSelecionado) saborSelecionado.value = value;

                    if (estoqueInfo && estoqueQuantidade) {
                        estoqueQuantidade.textContent = estoque;
                        estoqueInfo.hidden = false;
                    }

                    updateButtonsState();
                });
            });

            form?.addEventListener('submit', function (event) {
                event.preventDefault();
                submitCart(false);
            });

            buyNowBtn?.addEventListener('click', function () {
                submitCart(true);
            });

            normalizeQty();
            updateButtonsState();
        })();

        (function () {
            const tabs = document.querySelectorAll('.pdp-tab-btn');
            const panes = document.querySelectorAll('.pdp-tab-pane');

            tabs.forEach(btn => {
                btn.addEventListener('click', function () {
                    const tab = btn.getAttribute('data-tab');

                    tabs.forEach(x => x.classList.remove('active'));
                    panes.forEach(x => x.classList.remove('active'));

                    btn.classList.add('active');
                    document.querySelector(`.pdp-tab-pane[data-pane="${tab}"]`)?.classList.add('active');
                });
            });
        })();
    </script>
}
