@using Microsoft.AspNetCore.Mvc.Rendering
@using WebApplicationPods.Enum
@model WebApplicationPods.Models.ProdutoFormSimplesViewModel

@{
    var isEdit = Model?.Id.HasValue == true && Model.Id.Value > 0;

    string action = isEdit
        ? "EditarSimples"
        : (Model?.TipoProduto == ProdutoTipo.BebidaAlcoolica ? "CriarBebida"
           : Model?.TipoProduto == ProdutoTipo.PodVape ? "CriarPod"
           : "CriarPadrao");

    var tipoAtual = Model?.TipoProduto ?? ProdutoTipo.Padrao;
    var isPod = tipoAtual == ProdutoTipo.PodVape;
    var isBebida = tipoAtual == ProdutoTipo.BebidaAlcoolica;
    var isPadrao = tipoAtual == ProdutoTipo.Padrao;

    var tituloPagina = isEdit ? "Editar produto" : "Novo produto";

    var phNome = isPod
        ? "Ex: Ignite 28000 Puffs Banana Ice"
        : isBebida
            ? "Ex: Heineken Long Neck 330ml"
            : "Ex: Chocolate Lacta 90g";
}

<div class="ps-page ps-redesign">
    <div class="ps-shell">

        <div id="psEnums"
             data-padrao="@((int)ProdutoTipo.Padrao)"
             data-pod="@((int)ProdutoTipo.PodVape)"
             data-bebida="@((int)ProdutoTipo.BebidaAlcoolica)"
             data-action-padrao="@Url.Action("CriarPadrao", "Produto")"
             data-action-pod="@Url.Action("CriarPod", "Produto")"
             data-action-bebida="@Url.Action("CriarBebida", "Produto")"
             data-action-editar="@Url.Action("EditarSimples", "Produto", new { id = Model?.Id })">
        </div>

        <form class="ps-form"
              id="produtoSimplesForm"
              asp-action="@action"
              asp-route-id="@(isEdit ? Model!.Id : null)"
              method="post"
              enctype="multipart/form-data"
              novalidate>

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagemUrl" />
            <input type="hidden"
                   name="TipoProduto"
                   id="TipoProduto"
                   value="@((int)tipoAtual)" />

            <header class="ps-topbar">
                <div class="ps-breadcrumb">
                    <a asp-action="Index" class="ps-icon-back" aria-label="Voltar">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>

                    <div>
                        <div class="ps-breadcrumb-line">
                            <a asp-action="Index">Produtos</a>
                            <i class="fa-solid fa-chevron-right"></i>
                            <span>@tituloPagina</span>
                        </div>

                        <h1>@(ViewData["Title"] ?? tituloPagina)</h1>
                    </div>
                </div>

                <div class="ps-top-actions">
                    <a asp-action="Index" class="ps-btn ps-btn-light">
                        Cancelar
                    </a>

                    <button class="ps-btn ps-btn-primary" type="submit" name="submit" value="save">
                        Salvar produto
                    </button>

                    @if (!isEdit)
                    {
                        <button class="ps-btn ps-btn-success" type="submit" name="submit" value="save_new">
                            Salvar e adicionar novo
                        </button>
                    }
                </div>
            </header>

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="ps-layout">
                <main class="ps-main-column">

                    <section class="ps-panel">
                        <div class="ps-section-title">
                            <h2>Tipo de produto</h2>
                        </div>

                        <div class="ps-type-tabs">
                            <a asp-action="CriarPadrao"
                               class="ps-type-tab @(isPadrao ? "active" : "") @(isEdit ? "disabled" : "")">
                                <i class="fa-solid fa-cube"></i>
                                <span>Produto Padrão</span>
                            </a>

                            <a asp-action="CriarBebida"
                               class="ps-type-tab @(isBebida ? "active" : "") @(isEdit ? "disabled" : "")">
                                <i class="fa-solid fa-bottle-water"></i>
                                <span>Bebida</span>
                            </a>

                            <a asp-action="CriarPod"
                               class="ps-type-tab @(isPod ? "active" : "") @(isEdit ? "disabled" : "")">
                                <i class="fa-solid fa-smoking"></i>
                                <span>Pod</span>
                            </a>
                        </div>
                    </section>

                    <section class="ps-panel">
                        <div class="ps-section-title">
                            <h2>Básico</h2>
                        </div>

                        <div class="ps-grid ps-grid-2">
                            <div class="ps-field">
                                <label class="ps-label">Nome do produto <span class="ps-req">*</span></label>
                                <input asp-for="Nome" class="ps-input" maxlength="120" placeholder="@phNome" />
                                <span asp-validation-for="Nome" class="text-danger small"></span>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Categoria <span class="ps-req">*</span></label>
                                <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="ps-input ps-select">
                                    <option value="">Selecione uma categoria</option>
                                </select>
                                <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="ps-field mt-3">
                            <label class="ps-label">Descrição</label>
                            <textarea asp-for="Descricao"
                                      class="ps-input ps-textarea"
                                      id="Descricao"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Ex.: Produto gelado, embalagem fechada, pack promocional..."></textarea>
                            <small class="ps-counter" id="descricaoCounter">0/1000 caracteres</small>
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>
                    </section>

                    <section class="ps-panel">
                        <div class="ps-section-title">
                            <h2>Venda e estoque</h2>
                        </div>

                        <div class="ps-grid ps-grid-3">
                            <div class="ps-field">
                                <label class="ps-label">Preço de venda <span class="ps-req">*</span></label>
                                <div class="ps-money">
                                    <span class="ps-money-prefix">R$</span>
                                    <input asp-for="Preco"
                                           class="ps-input ps-money-input js-money"
                                           inputmode="decimal"
                                           autocomplete="off"
                                           placeholder="0,00" />
                                </div>
                                <span asp-validation-for="Preco" class="text-danger small"></span>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Preço promocional</label>
                                <div class="ps-money">
                                    <span class="ps-money-prefix">R$</span>
                                    <input asp-for="PrecoPromocional"
                                           class="ps-input ps-money-input js-money"
                                           inputmode="decimal"
                                           autocomplete="off"
                                           placeholder="0,00" />
                                </div>
                                <small id="promoHint" class="ps-hint"></small>
                                <span asp-validation-for="PrecoPromocional" class="text-danger small"></span>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">
                                    @(isBebida ? "Estoque para venda" : "Estoque") <span class="ps-req">*</span>
                                </label>
                                <input asp-for="Estoque" class="ps-input" id="Estoque" type="number" min="0" />
                                <small id="estoqueHint" class="ps-hint">
                                    @(isBebida
                                                                        ? "Informe quantas embalagens você tem para vender. Ex.: 6 packs."
                                                                        : "Informe quantas unidades estão disponíveis.")
                                </small>
                                <span asp-validation-for="Estoque" class="text-danger small"></span>
                            </div>
                        </div>

                        @if (isBebida)
                        {
                            <div class="ps-stock-helper mt-3" id="BebidaEstoqueResumo">
                                Informe embalagem, unidades por embalagem e estoque.
                            </div>
                        }
                    </section>

                    <section id="bebidaDetailsBox" class="ps-panel" style="@(isBebida ? "" : "display:none;")">
                        <div class="ps-section-title">
                            <h2>Embalagem</h2>
                            <p>Configure como o produto será vendido: unidade, pack, fardo ou caixa.</p>
                        </div>

                        <div class="ps-grid ps-grid-3">
                            <div class="ps-field">
                                <label class="ps-label">Volume (ml)</label>
                                <input asp-for="BebidaVolumeMl"
                                       class="ps-input"
                                       type="number"
                                       min="1"
                                       placeholder="Ex: 330" />
                                <span asp-validation-for="BebidaVolumeMl" class="text-danger small"></span>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Tipo de embalagem <span class="ps-req">*</span></label>
                                <select asp-for="BebidaEmbalagem" class="ps-input ps-select" id="BebidaEmbalagem">
                                    <option value="@((int)BebidaEmbalagemTipo.NaoInformado)">Não informado</option>
                                    <option value="@((int)BebidaEmbalagemTipo.Unidade)">Unidade</option>
                                    <option value="@((int)BebidaEmbalagemTipo.Lata)">Lata</option>
                                    <option value="@((int)BebidaEmbalagemTipo.LongNeck)">Long Neck</option>
                                    <option value="@((int)BebidaEmbalagemTipo.Garrafa)">Garrafa</option>
                                    <option value="@((int)BebidaEmbalagemTipo.Pack)">Pack</option>
                                    <option value="@((int)BebidaEmbalagemTipo.Fardo)">Fardo</option>
                                    <option value="@((int)BebidaEmbalagemTipo.Caixa)">Caixa</option>
                                </select>
                                <span asp-validation-for="BebidaEmbalagem" class="text-danger small"></span>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Unidades por embalagem <span class="ps-req">*</span></label>
                                <input asp-for="BebidaQtdPorEmbalagem"
                                       class="ps-input"
                                       id="BebidaQtdPorEmbalagem"
                                       type="number"
                                       min="1"
                                       placeholder="Ex: 6, 12, 24" />
                                <span asp-validation-for="BebidaQtdPorEmbalagem" class="text-danger small"></span>
                            </div>

                            <div class="ps-field ps-mini-result">
                                <span id="BebidaUnidadeBadge">Configure a embalagem</span>
                            </div>
                        </div>

                        <div class="ps-toggles">
                            <label class="ps-toggle-line">
                                <input class="ps-check" type="checkbox" asp-for="RequerMaioridade" id="RequerMaioridade" />
                                <span class="ps-toggle-box"></span>
                                <span>
                                    <strong>+18</strong>
                                    <small>Produto destinado a maiores de 18 anos</small>
                                </span>
                            </label>

                            <label class="ps-toggle-line">
                                <input class="ps-check" type="checkbox" asp-for="Ativo" />
                                <span class="ps-toggle-box"></span>
                                <span>
                                    <strong>Ativo</strong>
                                    <small>Produto disponível para venda</small>
                                </span>
                            </label>
                        </div>
                    </section>

                    <section id="podDetailsBox" class="ps-panel" style="@(isPod ? "" : "display:none;")">
                        <div class="ps-section-title">
                            <h2>Informações do Pod</h2>
                        </div>

                        <div class="ps-grid ps-grid-3">
                            <div class="ps-field">
                                <label class="ps-label">Sabor <span class="ps-req">*</span></label>

                                <div id="saborFieldWrap">
                                    <select class="ps-input ps-select mb-2" id="SaborSelect" name="SaborSelect">
                                        <option value="">Selecione um sabor...</option>

                                        @if (ViewBag.Sabores is IEnumerable<SelectListItem> sabores)
                                        {
                                            foreach (var s in sabores)
                                            {
                                                var selected = string.Equals(Model?.Sabor, s.Value, StringComparison.OrdinalIgnoreCase);

                                                if (selected)
                                                {
                                                    <option value="@s.Value" selected>@s.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@s.Value">@s.Text</option>
                                                }
                                            }
                                        }
                                    </select>

                                    <input type="text"
                                           class="ps-input"
                                           id="SaborOutro"
                                           name="SaborOutro"
                                           placeholder="Ou escreva um novo sabor..." />

                                    <input type="hidden" asp-for="Sabor" id="Sabor" />
                                </div>

                                <span asp-validation-for="Sabor" class="text-danger small"></span>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Número de puffs</label>
                                <input asp-for="PodPuffs"
                                       class="ps-input"
                                       type="number"
                                       min="0"
                                       placeholder="Ex: 28000" />
                                <span asp-validation-for="PodPuffs" class="text-danger small"></span>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Bateria</label>
                                <input asp-for="PodCapacidadeBateria"
                                       class="ps-input"
                                       placeholder="Ex: 650mAh" />
                                <span asp-validation-for="PodCapacidadeBateria" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="ps-toggles">
                            <label class="ps-toggle-line">
                                <input class="ps-check" type="checkbox" asp-for="RequerMaioridade" id="RequerMaioridade" />
                                <span class="ps-toggle-box"></span>
                                <span>
                                    <strong>+18</strong>
                                    <small>Produto destinado a maiores de 18 anos</small>
                                </span>
                            </label>

                            <label class="ps-toggle-line">
                                <input class="ps-check" type="checkbox" asp-for="Ativo" />
                                <span class="ps-toggle-box"></span>
                                <span>
                                    <strong>Ativo</strong>
                                    <small>Produto disponível para venda</small>
                                </span>
                            </label>
                        </div>
                    </section>

                    @if (isPadrao)
                    {
                        <section class="ps-panel">
                            <div class="ps-section-title">
                                <h2>Disponibilidade</h2>
                            </div>

                            <div class="ps-toggles">
                                <label class="ps-toggle-line">
                                    <input class="ps-check" type="checkbox" asp-for="Ativo" />
                                    <span class="ps-toggle-box"></span>
                                    <span>
                                        <strong>Ativo</strong>
                                        <small>Produto disponível para venda</small>
                                    </span>
                                </label>

                                <label class="ps-toggle-line">
                                    <input class="ps-check" type="checkbox" asp-for="MaisVendido" />
                                    <span class="ps-toggle-box"></span>
                                    <span>
                                        <strong>Mais vendido</strong>
                                        <small>Destaque na loja</small>
                                    </span>
                                </label>
                            </div>
                        </section>
                    }
                </main>

                <aside class="ps-side-column">
                    <section class="ps-panel ps-image-panel">
                        <div class="ps-section-title">
                            <h2>Imagem do produto</h2>
                        </div>

                        <input asp-for="ImagemUpload"
                               id="ImagemUpload"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               class="ps-file-hidden" />

                        <div class="ps-preview-box">
                            <img id="imgPreview"
                                 src="@(string.IsNullOrWhiteSpace(Model?.ImagemUrl) ? "" : Model!.ImagemUrl)"
                                 class="@(string.IsNullOrWhiteSpace(Model?.ImagemUrl) ? "d-none" : "")"
                                 alt="Preview" />

                            <div id="imgPreviewEmpty"
                                 class="ps-preview-empty @(string.IsNullOrWhiteSpace(Model?.ImagemUrl) ? "" : "d-none")">
                                <i class="fa-regular fa-image"></i>
                                <span>Pré-visualização</span>
                            </div>
                        </div>

                        <label for="ImagemUpload" class="ps-upload-btn">
                            <i class="fa-solid fa-arrow-up-from-bracket"></i>
                            Alterar imagem
                        </label>

                        <small class="ps-muted d-block mt-2">
                            PNG, JPG ou WEBP. Máx. 2MB.
                        </small>

                        <span asp-validation-for="ImagemUpload" class="text-danger small"></span>
                    </section>
                </aside>
            </div>
        </form>
    </div>
</div>