@using Microsoft.AspNetCore.Mvc.Rendering
@using WebApplicationPods.Enum
@model WebApplicationPods.Models.ProdutoFormSimplesViewModel

@{
    var isEdit = Model?.Id.HasValue == true && Model.Id.Value > 0;

    string action = isEdit
        ? "EditarSimples"
        : (Model?.TipoProduto == ProdutoTipo.BebidaAlcoolica ? "CriarBebida"
           : Model?.TipoProduto == ProdutoTipo.PodVape ? "CriarPod"
           : "CriarPadrao");

    var isPod = Model?.TipoProduto == ProdutoTipo.PodVape;
    var isBebida = Model?.TipoProduto == ProdutoTipo.BebidaAlcoolica;

    var phNome = isPod
        ? "Ex: Ignite 28000 Puffs Banana Ice"
        : (isBebida
            ? "Ex: Heineken 330ml Pack"
            : "Ex: Chocolate Lacta 90g");
}

<div class="ps-page">
    <div class="ps-container">

        <div id="psEnums"
             data-padrao="@((int)ProdutoTipo.Padrao)"
             data-pod="@((int)ProdutoTipo.PodVape)"
             data-bebida="@((int)ProdutoTipo.BebidaAlcoolica)"
             data-action-padrao="@Url.Action("CriarPadrao", "Produto")"
             data-action-pod="@Url.Action("CriarPod", "Produto")"
             data-action-bebida="@Url.Action("CriarBebida", "Produto")"
             data-action-editar="@Url.Action("EditarSimples", "Produto", new { id = Model?.Id })">
        </div>

        <div class="ps-header">
            <div class="ps-header-left">
                <div class="ps-app-icon">
                    <i class="fa-solid fa-cube"></i>
                </div>

                <div class="ps-header-texts">
                    <h1 class="ps-title">@ViewData["Title"]</h1>
                    <p class="ps-subtitle">Cadastro simples para venda rápida na loja.</p>
                </div>
            </div>

            <a asp-action="Index" class="ps-btn ps-btn-ghost">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Voltar</span>
            </a>
        </div>

        <div class="ps-card">
            <form class="ps-form"
                  id="produtoSimplesForm"
                  asp-action="@action"
                  asp-route-id="@(isEdit ? Model!.Id : null)"
                  method="post"
                  enctype="multipart/form-data"
                  novalidate>

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImagemUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                <div class="ps-grid ps-grid-2">
                    <div class="ps-field">
                        <label class="ps-label">Tipo de Produto</label>
                        <select asp-for="TipoProduto" class="ps-input ps-select" id="TipoProduto">
                            <option value="@((int)ProdutoTipo.Padrao)">Padrão</option>
                            <option value="@((int)ProdutoTipo.PodVape)">Pod / Vape</option>
                            <option value="@((int)ProdutoTipo.BebidaAlcoolica)">Bebida Alcoólica</option>
                        </select>
                        <small class="ps-hint">
                            Pod e bebida serão marcados como +18 automaticamente.
                        </small>
                    </div>

                    <div class="ps-field">
                        <label class="ps-label">Categoria <span class="ps-req">*</span></label>
                        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="ps-input ps-select">
                            <option value="">Selecione uma categoria</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="ps-field">
                    <label class="ps-label">Nome do Produto <span class="ps-req">*</span></label>
                    <input asp-for="Nome" class="ps-input" maxlength="120" placeholder="@phNome" />
                    <small class="ps-hint">
                        Use um nome claro. Ex.: Heineken 330ml Pack, Coca-Cola 2L, Ignite Banana Ice.
                    </small>
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>

                <div class="ps-grid ps-grid-2">
                    <div class="ps-field">
                        <label class="ps-label">Marca</label>
                        <input asp-for="Marca" class="ps-input" maxlength="80" placeholder="Ex: Heineken, Coca-Cola, Ignite" />
                        <span asp-validation-for="Marca" class="text-danger small"></span>
                    </div>

                    <div class="ps-field">
                        <label class="ps-label">Estoque <span class="ps-req">*</span></label>
                        <input asp-for="Estoque" class="ps-input" id="Estoque" type="number" min="0" />
                        <small id="estoqueHint" class="ps-hint">
                            @(isBebida ? "Informe quantas embalagens você tem para vender. Ex.: 6 packs." : "Informe quantas unidades estão disponíveis.")
                        </small>
                        <span asp-validation-for="Estoque" class="text-danger small"></span>
                    </div>
                </div>

                <div class="ps-field">
                    <label class="ps-label">Descrição</label>
                    <textarea asp-for="Descricao"
                              class="ps-input ps-textarea"
                              id="Descricao"
                              rows="4"
                              maxlength="1000"
                              placeholder="Ex.: Produto gelado, embalagem fechada, unidade individual, pack promocional..."></textarea>
                    <small class="ps-counter" id="descricaoCounter">0/1000 caracteres</small>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="ps-grid ps-grid-3">
                    <div class="ps-field">
                        <label class="ps-label">Preço <span class="ps-req">*</span></label>
                        <div class="ps-money">
                            <span class="ps-money-prefix">R$</span>
                            <input asp-for="Preco"
                                   class="ps-input ps-money-input js-money"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   placeholder="0,00" />
                        </div>
                        <span asp-validation-for="Preco" class="text-danger small"></span>
                    </div>

                    <div class="ps-field">
                        <label class="ps-label">Preço Promocional</label>
                        <div class="ps-money">
                            <span class="ps-money-prefix">R$</span>
                            <input asp-for="PrecoPromocional"
                                   class="ps-input ps-money-input js-money"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   placeholder="0,00" />
                        </div>
                        <small id="promoHint" class="ps-hint"></small>
                        <span asp-validation-for="PrecoPromocional" class="text-danger small"></span>
                    </div>

                    <div class="ps-field">
                        <label class="ps-label">Status</label>

                        <label class="ps-check-card ps-check-card-compact">
                            <input class="ps-check" type="checkbox" asp-for="Ativo" />
                            <div class="ps-check-content">
                                <div class="ps-check-top">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <strong>Produto ativo</strong>
                                </div>
                                <div class="ps-check-sub">Aparece na loja pública</div>
                            </div>
                        </label>
                    </div>
                </div>

                <div class="ps-media-row">
                    <div class="ps-field">
                        <label class="ps-label">Imagem do Produto</label>

                        <input asp-for="ImagemUpload"
                               id="ImagemUpload"
                               type="file"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               class="ps-file-hidden" />

                        <label for="ImagemUpload" class="ps-dropzone">
                            <div class="ps-dropzone-icon">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                            </div>
                            <div class="ps-dropzone-text">
                                <div class="ps-dropzone-title">Clique para fazer upload</div>
                                <div class="ps-dropzone-sub">JPG, PNG ou WEBP até 2MB</div>
                            </div>
                        </label>

                        <span asp-validation-for="ImagemUpload" class="text-danger small"></span>

                        <div class="ps-preview-box">
                            <img id="imgPreview"
                                 src="@(string.IsNullOrWhiteSpace(Model?.ImagemUrl) ? "" : Model!.ImagemUrl)"
                                 class="@(string.IsNullOrWhiteSpace(Model?.ImagemUrl) ? "d-none" : "")"
                                 alt="Preview" />

                            <div id="imgPreviewEmpty"
                                 class="ps-preview-empty @(string.IsNullOrWhiteSpace(Model?.ImagemUrl) ? "" : "d-none")">
                                <i class="fa-regular fa-image"></i>
                                <span>Pré-visualização da imagem</span>
                            </div>
                        </div>
                    </div>

                    <div class="ps-right-stack">

                        <div class="ps-field" id="saborFieldWrap" style="@(isPod ? "" : "display:none;")">
                            <label class="ps-label">Sabor do Pod <span class="ps-req">*</span></label>

                            <div id="podSaborBox">
                                <select class="ps-input ps-select mb-2" id="SaborSelect" name="SaborSelect">
                                    <option value="">Selecione um sabor...</option>

                                    @if (ViewBag.Sabores is IEnumerable<SelectListItem> sabores)
                                    {
                                        foreach (var s in sabores)
                                        {
                                            var selected = string.Equals(Model?.Sabor, s.Value, StringComparison.OrdinalIgnoreCase);

                                            if (selected)
                                            {
                                                <option value="@s.Value" selected>@s.Text</option>
                                            }
                                            else
                                            {
                                                <option value="@s.Value">@s.Text</option>
                                            }
                                        }
                                    }
                                </select>

                                <input type="text"
                                       class="ps-input"
                                       id="SaborOutro"
                                       name="SaborOutro"
                                       placeholder="Ou escreva um novo sabor..." />

                                <input type="hidden" asp-for="Sabor" id="Sabor" />

                                <span asp-validation-for="Sabor" class="text-danger small"></span>
                                <small class="ps-hint">
                                    Se preencher “Outro sabor”, ele será usado no lugar do selecionado.
                                </small>
                            </div>
                        </div>

                        <div id="bebidaDetailsBox" class="ps-bebida-card" style="@(isBebida ? "" : "display:none;")">
                            <div class="ps-bebida-head">
                                <div class="ps-bebida-title">
                                    <i class="fa-solid fa-wine-bottle"></i>
                                    <strong>Informações da Bebida</strong>
                                </div>
                            </div>

                            <div class="ps-grid ps-grid-2">
                                <div class="ps-field">
                                    <label class="ps-label">Tipo da Bebida</label>
                                    <input asp-for="BebidaTipo"
                                           class="ps-input"
                                           placeholder="Ex: Cerveja, Whisky, Vodka, Gin..." />
                                    <span asp-validation-for="BebidaTipo" class="text-danger small"></span>
                                </div>

                                <div class="ps-field">
                                    <label class="ps-label">Volume (ml)</label>
                                    <input asp-for="BebidaVolumeMl"
                                           class="ps-input"
                                           type="number"
                                           min="1"
                                           placeholder="Ex: 330" />
                                    <span asp-validation-for="BebidaVolumeMl" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="ps-grid ps-grid-2">
                                <div class="ps-field">
                                    <label class="ps-label">Embalagem</label>
                                    <select asp-for="BebidaEmbalagem" class="ps-input ps-select" id="BebidaEmbalagem">
                                        <option value="@((int)BebidaEmbalagemTipo.NaoInformado)">Não informado</option>
                                        <option value="@((int)BebidaEmbalagemTipo.Unidade)">Unidade</option>
                                        <option value="@((int)BebidaEmbalagemTipo.Lata)">Lata</option>
                                        <option value="@((int)BebidaEmbalagemTipo.LongNeck)">Long Neck</option>
                                        <option value="@((int)BebidaEmbalagemTipo.Garrafa)">Garrafa</option>
                                        <option value="@((int)BebidaEmbalagemTipo.Pack)">Pack</option>
                                        <option value="@((int)BebidaEmbalagemTipo.Fardo)">Fardo</option>
                                        <option value="@((int)BebidaEmbalagemTipo.Caixa)">Caixa</option>
                                    </select>
                                    <span asp-validation-for="BebidaEmbalagem" class="text-danger small"></span>
                                </div>

                                <div class="ps-field">
                                    <label class="ps-label">Unidades por embalagem</label>
                                    <input asp-for="BebidaQtdPorEmbalagem"
                                           class="ps-input"
                                           id="BebidaQtdPorEmbalagem"
                                           type="number"
                                           min="1"
                                           placeholder="Ex: 6, 12, 24" />
                                    <span asp-validation-for="BebidaQtdPorEmbalagem" class="text-danger small"></span>
                                    <small class="ps-hint">
                                        Ex.: pack com 10 unidades, fardo com 12, caixa com 24.
                                    </small>
                                </div>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Resumo do estoque</label>
                                <div class="ps-input ps-stock-summary" id="BebidaEstoqueResumo" aria-live="polite">
                                    Informe embalagem, unidades por embalagem e estoque.
                                </div>
                                <small class="ps-hint">
                                    Se o estoque for 6 packs com 10 unidades, o físico será 60 unidades.
                                </small>
                            </div>
                        </div>

                        <div id="podDetailsBox" class="ps-pod-card" style="@(isPod ? "" : "display:none;")">
                            <div class="ps-pod-head">
                                <div class="ps-pod-title">
                                    <i class="fa-solid fa-bolt"></i>
                                    <strong>Informações do Pod</strong>
                                </div>
                            </div>

                            <div class="ps-grid ps-grid-2">
                                <div class="ps-field">
                                    <label class="ps-label">Número de Puffs</label>
                                    <input asp-for="PodPuffs"
                                           class="ps-input"
                                           type="number"
                                           min="0"
                                           placeholder="Ex: 28000" />
                                    <span asp-validation-for="PodPuffs" class="text-danger small"></span>
                                </div>

                                <div class="ps-field">
                                    <label class="ps-label">Bateria</label>
                                    <input asp-for="PodCapacidadeBateria"
                                           class="ps-input"
                                           placeholder="Ex: 650mAh" />
                                    <span asp-validation-for="PodCapacidadeBateria" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="ps-field">
                                <label class="ps-label">Tipo do Pod</label>
                                <input asp-for="PodTipo"
                                       class="ps-input"
                                       placeholder="Ex: Descartável, Recarregável" />
                                <span asp-validation-for="PodTipo" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="ps-actions">
                    <a asp-action="Index" class="ps-btn ps-btn-ghost">
                        <i class="fa-solid fa-xmark"></i>
                        <span>Cancelar</span>
                    </a>

                    <button class="ps-btn ps-btn-blue" type="submit" name="submit" value="save">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Salvar Produto</span>
                    </button>

                    @if (!isEdit)
                    {
                        <button class="ps-btn ps-btn-green" type="submit" name="submit" value="save_new">
                            <i class="fa-solid fa-plus"></i>
                            <span>Salvar e Adicionar Novo</span>
                        </button>
                    }
                </div>

            </form>
        </div>
    </div>
</div>