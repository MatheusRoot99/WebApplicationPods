@using WebApplicationPods.Enum
@using WebApplicationPods.Models
@using WebApplicationPods.Constants
@model IEnumerable<PedidoModel>

@{
    var allowed = ViewBag.Allowed as IDictionary<string, string[]>;
    var pedidos = Model?.OrderByDescending(x => x.DataPedido) ?? Enumerable.Empty<PedidoModel>();
}

@foreach (var p in pedidos)
{
    var statusAtual = p.Status ?? string.Empty;

    var proximas = Array.Empty<string>();
    if (allowed != null && allowed.TryGetValue(statusAtual, out var arr) && arr != null)
    {
        proximas = arr;
    }

    if (!p.RetiradaNoLocal &&
        string.Equals(statusAtual, PedidoStatus.Pronto, StringComparison.OrdinalIgnoreCase))
    {
        proximas = proximas
            .Where(x =>
                !string.Equals(x, PedidoStatus.SaiuParaEntrega, StringComparison.OrdinalIgnoreCase) &&
                !string.Equals(x, PedidoStatus.Concluido, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    var pagamentoPixManualPendente = p.Pagamentos?
        .OrderByDescending(pg => pg.Id)
        .FirstOrDefault(pg =>
            pg.Metodo == PaymentMethod.Pix &&
            string.Equals(pg.Provider, "PixManual", StringComparison.OrdinalIgnoreCase) &&
            pg.Status == PaymentStatus.Pending);

    var metodo = (p.MetodoPagamento ?? string.Empty).Trim();
    var metodoLower = metodo.ToLowerInvariant();

    var isDinheiroOuDebito =
        metodoLower == "dinheiro" ||
        metodoLower == "cartão de débito" ||
        metodoLower == "cartao de debito";

    var podeAprovarNaEntrega =
        isDinheiroOuDebito &&
        string.Equals(p.Status, PedidoStatus.AguardandoPagamentoEntrega, StringComparison.OrdinalIgnoreCase);

    var podeAtribuirEntregador =
        !p.RetiradaNoLocal &&
        (
            string.Equals(statusAtual, PedidoStatus.Pronto, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(statusAtual, PedidoEntregaStatus.AguardandoAtribuicao, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(statusAtual, PedidoEntregaStatus.Atribuido, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(statusAtual, PedidoEntregaStatus.SaiuParaEntrega, StringComparison.OrdinalIgnoreCase)
        );

    var mostrarMotivoEntrega =
        p.Entrega != null &&
        string.Equals(p.Entrega.Status, EntregaStatus.NaoEntregue, StringComparison.OrdinalIgnoreCase) &&
        !string.IsNullOrWhiteSpace(p.Entrega.Observacao);

    var motivoEntrega = mostrarMotivoEntrega ? p.Entrega!.Observacao! : string.Empty;

    var pagamentoIcon = "bi-credit-card";
    if (metodoLower.Contains("pix")) pagamentoIcon = "bi-qr-code";
    else if (metodoLower.Contains("dinheiro")) pagamentoIcon = "bi-cash-coin";
    else if (metodoLower.Contains("cart")) pagamentoIcon = "bi-credit-card-2-front";

    var pagamentoTexto = string.IsNullOrWhiteSpace(metodo) ? "—" : metodo;

    var pagamentoSub = "Pagamento registrado";
    if (pagamentoPixManualPendente != null)
    {
        pagamentoSub = "Pagamento pendente";
    }
    else if (string.Equals(statusAtual, PedidoStatus.Pago, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(statusAtual, PedidoStatus.EmPreparacao, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(statusAtual, PedidoStatus.Pronto, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(statusAtual, PedidoStatus.SaiuParaEntrega, StringComparison.OrdinalIgnoreCase) ||
             string.Equals(statusAtual, PedidoStatus.Concluido, StringComparison.OrdinalIgnoreCase))
    {
        pagamentoSub = "Pago";
    }
    else if (statusAtual.Contains("Pagamento", StringComparison.OrdinalIgnoreCase))
    {
        pagamentoSub = statusAtual;
    }

    var statusSub = statusAtual switch
    {
        var s when string.Equals(s, PedidoStatus.AguardandoPagamento, StringComparison.OrdinalIgnoreCase)
            => "Aguardando aprovação",

        var s when string.Equals(s, PedidoStatus.AguardandoPagamentoEntrega, StringComparison.OrdinalIgnoreCase)
            => "Pagamento na entrega",

        var s when string.Equals(s, PedidoStatus.Pago, StringComparison.OrdinalIgnoreCase)
            => p.DataPagamentoAprovado.HasValue
                ? $"Pago às {p.DataPagamentoAprovado.Value:HH:mm}"
                : "Pagamento aprovado",

        var s when string.Equals(s, PedidoStatus.EmPreparacao, StringComparison.OrdinalIgnoreCase)
            => p.DataInicioPreparo.HasValue
                ? $"Iniciado às {p.DataInicioPreparo.Value:HH:mm}"
                : "Em andamento",

        var s when string.Equals(s, PedidoStatus.Pronto, StringComparison.OrdinalIgnoreCase)
            => "Aguardando entrega",

        var s when string.Equals(s, PedidoStatus.SaiuParaEntrega, StringComparison.OrdinalIgnoreCase)
            => p.DataSaiuParaEntregaOuRetirada.HasValue
                ? $"Saiu às {p.DataSaiuParaEntregaOuRetirada.Value:HH:mm}"
                : "Saiu para entrega",

        var s when string.Equals(s, PedidoStatus.Concluido, StringComparison.OrdinalIgnoreCase)
            => p.DataConcluido.HasValue
                ? $"Entregue às {p.DataConcluido.Value:HH:mm}"
                : "Pedido entregue",

        var s when string.Equals(s, PedidoStatus.Cancelado, StringComparison.OrdinalIgnoreCase)
            => p.DataCancelado.HasValue
                ? $"Cancelado às {p.DataCancelado.Value:HH:mm}"
                : "Pedido cancelado",

        _ => "Atualizado"
    };

    <tr data-id="@p.Id" data-order-id="@p.Id">
        <td data-th="Pedido">
            <div class="cell-primary">
                <div class="title">#@p.Id</div>
                <div class="sub">@p.DataPedido.ToString("dd/MM HH:mm")</div>
            </div>
        </td>

        <td data-th="Cliente">
            <div class="cell-primary">
                <div class="title">@((p.Cliente?.Nome) ?? "—")</div>
                <div class="sub">
                    @(p.Cliente?.Telefone ?? "Sem telefone")
                </div>
            </div>
        </td>

        <td data-th="Pagamento">
            <div class="payment-cell">
                <div class="payment-main">
                    <i class="bi @pagamentoIcon"></i>
                    <strong>@pagamentoTexto</strong>
                </div>

                <span class="payment-sub @(pagamentoPixManualPendente != null ? "is-pending" : "is-ok")">
                    @pagamentoSub
                </span>

                @if (pagamentoPixManualPendente != null)
                {
                    <form class="js-inline-action mt-2"
                          data-action="confirmar-pix"
                          data-success="PIX confirmado e estoque baixado!"
                          action="@Url.Action("ConfirmarPixManual", "Pagamento")"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="pagamentoId" value="@pagamentoPixManualPendente.Id" />
                        <button type="submit" class="order-mini-button">
                            Aprovar PIX
                        </button>
                    </form>
                }
            </div>
        </td>

        <td data-th="Itens do pedido">
            <div class="order-items-summary">
                @{
                    var itensPedido = p.PedidoItens?.Take(3).ToList() ?? new List<PedidoItemModel>();
                    var restante = Math.Max((p.PedidoItens?.Count ?? 0) - itensPedido.Count, 0);
                }

                @if (itensPedido.Any())
                {
                    foreach (var item in itensPedido)
                    {
                        <div class="order-item-line">
                            <strong>@item.NomeExibicao</strong>
                            <span>@item.ResumoQuantidadeExibicao</span>

                            @if (item.UnidadesPorEmbalagemExibicao > 1)
                            {
                                <em>@item.TotalUnidadesFisicasExibicao</em>
                            }
                        </div>
                    }

                    if (restante > 0)
                    {
                        <div class="order-item-more">
                            Ver mais @restante item(ns)
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted">Sem itens</span>
                }
            </div>
        </td>

        <td data-th="Total" class="text-end">
            <div class="cell-primary text-end">
                <div class="title" style="padding-left:0px">@p.ValorTotalComEntrega.ToString("C")</div>
                <div class="sub">
                    @if (p.RetiradaNoLocal)
                    {
                        <span>Retirada no local</span>
                    }
                    else
                    {
                        <span>Com entrega</span>
                    }
                </div>
            </div>
        </td>

        <td data-th="Status">
            <div class="status-cell">
                <span class="badge badge-state" data-state="@statusAtual">@statusAtual</span>
                <small style="text-align:center">@statusSub</small>

                @if (mostrarMotivoEntrega)
                {
                    <small class="text-danger fw-semibold">Falha anterior: @motivoEntrega</small>
                }
            </div>
        </td>

        <td data-th="Entregador">
            <div class="driver-cell">
                @if (p.RetiradaNoLocal)
                {
                    <strong>Retirada</strong>
                    <span>Cliente retira na loja</span>
                }
                else if (p.Entregador != null)
                {
                    <strong>@p.Entregador.Nome</strong>
                    <span>@(string.IsNullOrWhiteSpace(p.Entregador.Telefone) ? "Sem telefone" : p.Entregador.Telefone)</span>

                    @if (podeAtribuirEntregador)
                    {
                        <a asp-controller="PedidosAdmin"
                           asp-action="AtribuirEntregador"
                           asp-route-id="@p.Id">
                            Alterar
                        </a>
                    }
                }
                else if (podeAtribuirEntregador)
                {
                    <a asp-controller="PedidosAdmin"
                       asp-action="AtribuirEntregador"
                       asp-route-id="@p.Id"
                       class="driver-assign">
                        <i class="bi bi-person-plus"></i>
                        Atribuir
                    </a>

                    <span>Nenhum</span>
                }
                else
                {
                    <strong>Nenhum</strong>
                    <span>Aguardando preparo</span>
                }
            </div>
        </td>

        <td data-th="Ações" class="text-end">
            <div class="actions-wrap">
                @if (proximas.Any())
                {
                    foreach (var prox in proximas)
                    {
                        if (podeAprovarNaEntrega &&
                        string.Equals(prox, PedidoStatus.Pago, StringComparison.OrdinalIgnoreCase))
                        {
                            continue;
                        }

                        var lowered = (prox ?? string.Empty).ToLowerInvariant();
                        var label = prox;
                        var icon = "bi-arrow-right";
                        var css = "order-action-button is-neutral";

                        if (lowered.Contains("pago"))
                        {
                            label = "Aprovar pagamento";
                            icon = "bi-check2-circle";
                            css = "order-action-button is-success";
                        }
                        else if (lowered.Contains("prepara"))
                        {
                            label = "Iniciar preparo";
                            icon = "bi-play-fill";
                            css = "order-action-button is-primary";
                        }
                        else if (lowered.Contains("pronto"))
                        {
                            label = "Marcar pronto";
                            icon = "bi-check-circle";
                            css = "order-action-button is-warning";
                        }
                        else if (lowered.Contains("saiu") && lowered.Contains("entrega"))
                        {
                            label = "Saiu p/ entrega";
                            icon = "bi-truck";
                            css = "order-action-button is-purple";
                        }
                        else if (lowered.Contains("entregue") || lowered.Contains("conclu"))
                        {
                            label = "Entregue";
                            icon = "bi-geo-alt";
                            css = "order-action-button is-dark";
                        }
                        else if (lowered.Contains("cancel"))
                        {
                            label = "Cancelar pedido";
                            icon = "bi-x-circle";
                            css = "order-action-button is-danger";
                        }

                        <form class="js-inline-action"
                              data-action="status"
                              data-success="Status atualizado!"
                              data-confirm="@((lowered.Contains("cancel")) ? "Confirmar cancelamento do pedido?" : "")"
                              action="@Url.Action("AtualizarStatus", "PedidosAdmin")"
                              method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@p.Id" />
                            <input type="hidden" name="status" value="@prox" />
                            <button type="submit" class="@css">
                                <i class="bi @icon"></i>
                                @label
                            </button>
                        </form>
                    }
                }

                @if (podeAprovarNaEntrega)
                {
                    <form class="js-inline-action"
                          data-action="aprovar-entrega"
                          data-success="Pagamento aprovado na entrega e estoque baixado!"
                          action="@Url.Action("AprovarPagamentoEntrega", "Pagamento")"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="pedidoId" value="@p.Id" />
                        <button type="submit" class="order-action-button is-success">
                            <i class="bi bi-cash-coin"></i>
                            Aprovar pagamento
                        </button>
                    </form>
                }

                @if (string.Equals(p.Status, PedidoStatus.Cancelado, StringComparison.OrdinalIgnoreCase))
                {
                    <form class="js-inline-action"
                          data-action="excluir"
                          data-success="Pedido excluído."
                          data-confirm="Excluir este pedido?"
                          action="@Url.Action("Excluir", "PedidosAdmin")"
                          method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@p.Id" />
                        <button type="submit" class="order-action-button is-danger">
                            <i class="bi bi-trash"></i>
                            Excluir
                        </button>
                    </form>
                }
            </div>
        </td>
    </tr>
}