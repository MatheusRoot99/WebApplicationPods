@using WebApplicationPods.Models
@using System.Linq
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@model IEnumerable<PedidoModel>

@{
    ViewData["Title"] = "Pedidos";

    var filtro = (string)(ViewBag.Filtro ?? "abertos");
    var tableUrl = Url.Action("Table", "PedidosAdmin", new { filtro });
    var afToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    var alertasEstoque = ViewBag.AlertasEstoque as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var totalEsgotados = ViewBag.TotalEsgotados as int? ?? 0;
    var totalBaixoEstoque = ViewBag.TotalBaixoEstoque as int? ?? 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/orders-admin.css" asp-append-version="true" />
}

<meta name="request-verification-token" content="@afToken" />

@{
    var pedidosLista = Model?.ToList() ?? new List<PedidoModel>();

    var totalAbertos = pedidosLista.Count;

    var totalPreparo = pedidosLista.Count(p =>
        string.Equals(p.Status, "Em Preparo", StringComparison.OrdinalIgnoreCase));

    var totalProntos = pedidosLista.Count(p =>
        string.Equals(p.Status, "Pronto", StringComparison.OrdinalIgnoreCase));

    var totalEntrega = pedidosLista.Count(p =>
        string.Equals(p.Status, "Saiu para Entrega", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(p.Status, "Saiu p/ Entrega", StringComparison.OrdinalIgnoreCase));

    var totalAtrasados = pedidosLista.Count(p =>
        !string.Equals(p.Status, "Cancelado", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(p.Status, "Entregue", StringComparison.OrdinalIgnoreCase) &&
        !string.Equals(p.Status, "Concluido", StringComparison.OrdinalIgnoreCase) &&
        p.DataPedido <= DateTime.Now.AddMinutes(-45));

    var valorAberto = pedidosLista.Sum(p => p.ValorTotalComEntrega);
}

<header class="orders-page-header">
    <div>
        <h1>Pedidos</h1>
        <p>Gerencie e acompanhe todos os pedidos da sua loja</p>
    </div>

    <div class="orders-header-actions">
        <button type="button" class="orders-icon-button" title="Notificações">
            <i class="bi bi-bell"></i>
            @if (totalAbertos > 0)
            {
                <span>@totalAbertos</span>
            }
        </button>

        <button type="button" class="orders-filter-button">
            <i class="bi bi-funnel"></i>
            Filtros avançados
        </button>
    </div>
</header>

<div class="orders-filter-row">
    <div class="orders-tabs">
        <a class="orders-tab @(filtro == "abertos" ? "active" : "")"
           asp-action="Index"
           asp-route-filtro="abertos">
            Abertos
            <span>@totalAbertos</span>
        </a>

        <a class="orders-tab @(filtro == "dia" ? "active" : "")"
           asp-action="Index"
           asp-route-filtro="dia">
            Hoje
            <span>@pedidosLista.Count</span>
        </a>
    </div>

    <div class="orders-search">
        <i class="bi bi-search"></i>
        <input id="qPedidos"
               type="search"
               placeholder="Buscar por cliente, método, status..."
               autocomplete="off" />
    </div>

    @if (filtro == "dia")
    {
        <a class="orders-report-button"
           asp-controller="PedidosAdmin"
           asp-action="Relatorio"
           asp-route-modo="dia"
           asp-route-data="@DateTime.Today.ToString("yyyy-MM-dd")">
            Relatório hoje
        </a>
    }
    else
    {
        <a class="orders-report-button"
           asp-controller="PedidosAdmin"
           asp-action="Relatorio"
           asp-route-modo="mes"
           asp-route-ano="@DateTime.Today.Year"
           asp-route-mes="@DateTime.Today.Month">
            Relatório mês
        </a>
    }
</div>

<div class="orders-kpis">
    <div class="orders-kpi">
        <strong>@totalAbertos</strong>
        <div>
            <span>Pedidos abertos</span>
            <small>@valorAberto.ToString("C")</small>
        </div>
        <i class="bi bi-receipt orders-kpi-icon is-blue"></i>
    </div>

    <div class="orders-kpi">
        <strong>@totalPreparo</strong>
        <div>
            <span>Em preparo</span>
            <small>Acompanhar cozinha</small>
        </div>
        <i class="bi bi-clipboard-check orders-kpi-icon is-amber"></i>
    </div>

    <div class="orders-kpi">
        <strong>@totalProntos</strong>
        <div>
            <span>Prontos</span>
            <small>Aguardando entrega</small>
        </div>
        <i class="bi bi-check-circle orders-kpi-icon is-green"></i>
    </div>

    <div class="orders-kpi">
        <strong>@totalEntrega</strong>
        <div>
            <span>A caminho</span>
            <small>Em rota</small>
        </div>
        <i class="bi bi-bicycle orders-kpi-icon is-purple"></i>
    </div>

    <div class="orders-kpi">
        <strong>@totalAtrasados</strong>
        <div>
            <span>Atrasados</span>
            <small>Mais de 45 min</small>
        </div>
        <i class="bi bi-clock orders-kpi-icon is-red"></i>
    </div>
</div>

<div class="status-legend mb-3">
    <span class="legend-item"><i class="dot dot-info"></i> Aguardando</span>
    <span class="legend-item"><i class="dot dot-primary"></i> Em preparo</span>
    <span class="legend-item"><i class="dot dot-warning"></i> Pronto</span>
    <span class="legend-item"><i class="dot dot-secondary"></i> Saiu p/ entrega</span>
    <span class="legend-item"><i class="dot dot-dark"></i> Entregue</span>
    <span class="legend-item"><i class="dot dot-danger"></i> Cancelado</span>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>

    <script src="~/js/orders-admin.js" asp-append-version="true"></script>

    <script>
        window.__ORDERS_ADMIN__.boot({
            tableUrl: '@tableUrl',
            highlightFromQueryString: true
        });
    </script>
}