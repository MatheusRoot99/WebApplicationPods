@model WebApplicationPods.DTO.ReportsDTO.AdminReportViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Relatório de Vendas";

    var serie = Model.SeriePorDia ?? new();
    var metodos = Model.Metodos ?? new();
    var topClientes = Model.TopClientes ?? new();

    var serieJson = JsonSerializer.Serialize(serie.Select(s => new { dia = s.Dia.ToString("dd/MM"), qtd = s.Quantidade, total = s.Total }));
    var metodosJson = JsonSerializer.Serialize(metodos.Select(m => new { metodo = m.Metodo, qtd = m.Quantidade, total = m.Total }));

    var qs = ViewContext.HttpContext.Request.Query;
    var hoje = DateTime.Today;
    var modoSel = (qs["modo"].ToString() ?? "dia").ToLowerInvariant();
    var dataSel = qs["data"].ToString();
    var anoSel = qs["ano"].ToString();
    var mesSel = qs["mes"].ToString();

    var conversao = Model.Resumo.Recebidos > 0
        ? (decimal)Model.Resumo.Pagos / Model.Resumo.Recebidos * 100m
        : 0m;
}

@section Styles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}

<div class="reports-page">
    <header class="reports-header">
        <div class="reports-title">
            <span>Relatórios</span>
            <h1>Vendas</h1>
            <p>Acompanhe pedidos, faturamento e clientes no período selecionado.</p>
        </div>

        <form method="get" class="reports-filter">
            <div class="reports-field">
                <label for="selModo">Modo</label>
                <select name="modo" id="selModo">
                    <option value="dia" selected="@(modoSel == "dia")">Dia</option>
                    <option value="mes" selected="@(modoSel == "mes")">Mês</option>
                </select>
            </div>

            <div class="reports-field" id="grpDia">
                <label>Data</label>
                <input type="date" name="data" value="@(string.IsNullOrEmpty(dataSel) ? hoje.ToString("yyyy-MM-dd") : dataSel)" />
            </div>

            <div class="reports-field reports-month-field" id="grpMes">
                <label>Ano</label>
                <input type="number" name="ano" min="2000" max="2100" value="@(string.IsNullOrEmpty(anoSel) ? hoje.Year.ToString() : anoSel)" />
            </div>

            <div class="reports-field reports-month-field" id="grpMes2">
                <label>Mês</label>
                <input type="number" name="mes" min="1" max="12" value="@(string.IsNullOrEmpty(mesSel) ? hoje.Month.ToString() : mesSel)" />
            </div>

            <button type="submit" class="reports-btn">
                <i class="fa-solid fa-filter"></i>
                Aplicar
            </button>
        </form>
    </header>

    <section class="reports-period-card">
        <div>
            <span>Período atual</span>
            <strong>@Model.PeriodoDescricao</strong>
        </div>
        <i class="fa-solid fa-calendar-days"></i>
    </section>

    <section class="reports-kpis">
        <article class="reports-kpi">
            <span class="reports-kpi-icon"><i class="fa-regular fa-clipboard"></i></span>
            <div>
                <small>Pedidos recebidos</small>
                <strong>@Model.Resumo.Recebidos</strong>
            </div>
        </article>

        <article class="reports-kpi">
            <span class="reports-kpi-icon"><i class="fa-solid fa-circle-check"></i></span>
            <div>
                <small>Pedidos pagos</small>
                <strong>@Model.Resumo.Pagos</strong>
            </div>
        </article>

        <article class="reports-kpi">
            <span class="reports-kpi-icon"><i class="fa-solid fa-chart-line"></i></span>
            <div>
                <small>Conversão</small>
                <strong>@conversao.ToString("0.0")%</strong>
            </div>
        </article>

        <article class="reports-kpi">
            <span class="reports-kpi-icon"><i class="fa-solid fa-sack-dollar"></i></span>
            <div>
                <small>Total vendido</small>
                <strong>@Model.Resumo.TotalVendido.ToString("C")</strong>
            </div>
        </article>
    </section>

    <section class="reports-grid">
        <article class="reports-card reports-card-large">
            <div class="reports-card-head">
                <div>
                    <span>Faturamento</span>
                    <h2>Pedidos e vendas</h2>
                </div>
            </div>
            <div class="reports-chart-wrap">
                @if (serie.Any())
                {
                    <canvas id="chartSerie"></canvas>
                }
                else
                {
                    <div class="reports-empty">
                        <i class="fa-regular fa-chart-bar"></i>
                        <strong>Sem vendas no período</strong>
                        <span>Quando houver pedidos, o gráfico aparece aqui.</span>
                    </div>
                }
            </div>
        </article>

        <article class="reports-card">
            <div class="reports-card-head">
                <div>
                    <span>Pagamento</span>
                    <h2>Formas usadas</h2>
                </div>
            </div>
            <div class="reports-chart-wrap reports-chart-small">
                @if (metodos.Any())
                {
                    <canvas id="chartMetodos"></canvas>
                }
                else
                {
                    <div class="reports-empty">
                        <i class="fa-regular fa-credit-card"></i>
                        <strong>Nenhum pagamento</strong>
                        <span>Os métodos pagos entram neste resumo.</span>
                    </div>
                }
            </div>
        </article>
    </section>

    <section class="reports-card reports-table-card">
        <div class="reports-card-head">
            <div>
                <span>Clientes</span>
                <h2>Top clientes</h2>
            </div>
        </div>

        @if (topClientes.Any())
        {
            <div class="reports-table-wrap">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>Pedidos</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cliente in topClientes)
                        {
                            <tr>
                                <td data-label="Cliente">@(string.IsNullOrWhiteSpace(cliente.Nome) ? "#" + cliente.ClienteId : cliente.Nome)</td>
                                <td data-label="Pedidos">@cliente.Quantidade</td>
                                <td data-label="Total">@cliente.Total.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="reports-empty reports-empty-table">
                <i class="fa-regular fa-user"></i>
                <strong>Nenhum cliente neste período</strong>
                <span>Quando houver pedidos finalizados, eles aparecem nessa lista.</span>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        (() => {
            const serie = @Html.Raw(serieJson);
            const metodos = @Html.Raw(metodosJson);
            const modo = document.getElementById('selModo');
            const grpDia = document.getElementById('grpDia');
            const grpMes = document.getElementById('grpMes');
            const grpMes2 = document.getElementById('grpMes2');

            function togglePeriodo() {
                const mensal = modo?.value === 'mes';
                if (grpDia) grpDia.hidden = mensal;
                if (grpMes) grpMes.hidden = !mensal;
                if (grpMes2) grpMes2.hidden = !mensal;
            }

            function brl(value) {
                return (Number(value) || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            }

            function chartColor(name, fallback) {
                return getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;
            }

            function commonOptions() {
                const grid = 'rgba(148, 163, 184, .22)';
                const text = '#475467';

                return {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: text,
                                boxWidth: 12,
                                boxHeight: 12,
                                font: { weight: 700 }
                            }
                        }
                    },
                    scales: {
                        x: { ticks: { color: text }, grid: { display: false } },
                        y: { ticks: { color: text }, grid: { color: grid } }
                    }
                };
            }

            modo?.addEventListener('change', togglePeriodo);
            togglePeriodo();

            const serieEl = document.getElementById('chartSerie');
            if (serieEl && serie.length) {
                new Chart(serieEl, {
                    type: 'line',
                    data: {
                        labels: serie.map(x => x.dia),
                        datasets: [
                            {
                                label: 'Pedidos',
                                data: serie.map(x => x.qtd),
                                borderColor: chartColor('--settings-blue', '#2563eb'),
                                backgroundColor: 'rgba(37, 99, 235, .12)',
                                borderWidth: 3,
                                tension: .35,
                                fill: true,
                                yAxisID: 'y'
                            },
                            {
                                label: 'Faturamento',
                                data: serie.map(x => x.total),
                                borderColor: '#16a34a',
                                backgroundColor: 'rgba(22, 163, 74, .10)',
                                borderWidth: 3,
                                tension: .35,
                                fill: true,
                                yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        ...commonOptions(),
                        interaction: { mode: 'index', intersect: false },
                        scales: {
                            x: commonOptions().scales.x,
                            y: { beginAtZero: true, ticks: { precision: 0, color: '#475467' }, grid: { color: 'rgba(148, 163, 184, .22)' } },
                            y1: { beginAtZero: true, position: 'right', ticks: { color: '#475467', callback: brl }, grid: { drawOnChartArea: false } }
                        },
                        plugins: {
                            ...commonOptions().plugins,
                            tooltip: {
                                callbacks: {
                                    label: (ctx) => ctx.dataset.label === 'Faturamento'
                                        ? `Faturamento: ${brl(ctx.parsed.y)}`
                                        : `Pedidos: ${ctx.parsed.y}`
                                }
                            }
                        }
                    }
                });
            }

            const metodosEl = document.getElementById('chartMetodos');
            if (metodosEl && metodos.length) {
                new Chart(metodosEl, {
                    type: 'bar',
                    data: {
                        labels: metodos.map(x => x.metodo || 'Não informado'),
                        datasets: [{
                            label: 'Pedidos',
                            data: metodos.map(x => x.qtd),
                            backgroundColor: 'rgba(37, 99, 235, .82)',
                            borderRadius: 10
                        }]
                    },
                    options: commonOptions()
                });
            }
        })();
    </script>
}
