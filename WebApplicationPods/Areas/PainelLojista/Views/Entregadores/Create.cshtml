@model WebApplicationPods.Models.EntregadorCreateViewModel

@{
    ViewData["Title"] = "Novo entregador";
}

@section Styles {
    <link rel="stylesheet" href="~/css/entregadores-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
}

<div class="driver-form-page">
    <header class="driver-form-header">
        <a asp-area="PainelLojista"
           asp-controller="Entregadores"
           asp-action="Index"
           class="driver-form-back"
           aria-label="Voltar">
            <i class="fas fa-arrow-left"></i>
        </a>

        <div class="driver-form-title">
            <span>Entregadores</span>
            <h1>Novo entregador</h1>
            <p>Cadastre um entregador e crie o acesso dele no sistema.</p>
        </div>
    </header>

    <section class="driver-form-card">
        <div class="driver-form-card-head">
            <div class="driver-form-icon">
                <i class="fas fa-truck"></i>
            </div>

            <div>
                <span>Cadastro</span>
                <h2>Dados do entregador</h2>
            </div>
        </div>

        <div class="driver-form-card-body">
            <form asp-area="PainelLojista"
                  asp-controller="Entregadores"
                  asp-action="Create"
                  method="post"
                  class="driver-form">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly" class="drivers-alert is-error"></div>
                }

                <div class="driver-form-grid">
                    <div class="driver-field is-wide">
                        <label asp-for="Nome"></label>
                        <div class="driver-input-wrap">
                            <i class="fas fa-user"></i>
                            <input asp-for="Nome" placeholder="Nome completo" />
                        </div>
                        <span asp-validation-for="Nome" class="driver-validation"></span>
                    </div>

                    <div class="driver-field">
                        <label asp-for="CPF"></label>
                        <div class="driver-input-wrap">
                            <i class="fas fa-id-card"></i>
                            <input asp-for="CPF" placeholder="000.000.000-00" />
                        </div>
                        <span asp-validation-for="CPF" class="driver-validation"></span>
                    </div>

                    <div class="driver-field">
                        <label asp-for="PhoneNumber"></label>
                        <div class="driver-input-wrap">
                            <i class="fas fa-phone"></i>
                            <input asp-for="PhoneNumber" placeholder="(00) 00000-0000" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="driver-validation"></span>
                    </div>

                    <div class="driver-field">
                        <label asp-for="Email"></label>
                        <div class="driver-input-wrap">
                            <i class="fas fa-envelope"></i>
                            <input asp-for="Email" placeholder="email@exemplo.com" />
                        </div>
                        <span asp-validation-for="Email" class="driver-validation"></span>
                    </div>

                    <div class="driver-field">
                        <label asp-for="Password"></label>
                        <div class="driver-input-wrap">
                            <i class="fas fa-lock"></i>
                            <input asp-for="Password" type="password" placeholder="Senha de acesso" />
                        </div>
                        <span asp-validation-for="Password" class="driver-validation"></span>
                    </div>

                    <div class="driver-field">
                        <label asp-for="Veiculo"></label>
                        <div class="driver-input-wrap">
                            <i class="fas fa-motorcycle"></i>
                            <input asp-for="Veiculo" placeholder="Moto, carro, bicicleta..." />
                        </div>
                        <span asp-validation-for="Veiculo" class="driver-validation"></span>
                    </div>

                    <div class="driver-field">
                        <label asp-for="PlacaVeiculo"></label>
                        <div class="driver-input-wrap">
                            <i class="fas fa-rectangle-list"></i>
                            <input asp-for="PlacaVeiculo" placeholder="ABC-1234" />
                        </div>
                        <span asp-validation-for="PlacaVeiculo" class="driver-validation"></span>
                    </div>

                    <div class="driver-field is-check">
                        <label class="driver-check">
                            <input asp-for="Ativo" />
                            <span></span>
                            <strong>Entregador ativo</strong>
                        </label>
                    </div>

                    <div class="driver-field is-full">
                        <label asp-for="Observacoes"></label>
                        <div class="driver-input-wrap is-textarea">
                            <i class="fas fa-align-left"></i>
                            <textarea asp-for="Observacoes" rows="4" placeholder="Observações internas sobre o entregador"></textarea>
                        </div>
                        <span asp-validation-for="Observacoes" class="driver-validation"></span>
                    </div>
                </div>

                <div class="driver-form-actions">
                    <a asp-area="PainelLojista"
                       asp-controller="Entregadores"
                       asp-action="Index"
                       class="drivers-btn drivers-btn-light">
                        <i class="fas fa-arrow-left"></i>
                        Voltar
                    </a>

                    <button type="submit" class="drivers-btn drivers-btn-primary">
                        <i class="fas fa-save"></i>
                        Salvar entregador
                    </button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}