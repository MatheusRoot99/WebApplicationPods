@using Microsoft.AspNetCore.Authorization
@using WebApplicationPods.Models
@model WebApplicationPods.Models.LojaConfig
@inject IAuthorizationService Authz

@{
    ViewData["Title"] = "Configurações da Loja";
    var authResult = await Authz.AuthorizeAsync(User, policyName: "Admin");
    var isAdmin = authResult.Succeeded || (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"));
}

@section Styles {
    <link rel="stylesheet" href="~/css/loja-settings.css" asp-append-version="true" />
}

<div class="store-settings-page">
    <header class="store-settings-header">
        <div class="store-settings-title">
            <span>Configurações</span>
            <h1>Configurações da loja</h1>
            <p>Edite identidade, horário de funcionamento e endereço usado para retirada no local.</p>
        </div>

        <a asp-area="PainelLojista" asp-controller="Dashboard" asp-action="Index" class="store-settings-btn store-settings-btn-light">
            <i class="fa-solid fa-arrow-left"></i>
            Voltar
        </a>
    </header>

    @if (TempData["Sucesso"] is string okMsg)
    {
        <div class="store-settings-alert is-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@okMsg</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="store-settings-alert is-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Corrija os campos destacados antes de salvar.</span>
        </div>
    }

    <form asp-action="Editar" method="post" enctype="multipart/form-data" class="store-settings-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <section class="store-settings-card">
            <div class="store-settings-card-head">
                <div class="store-settings-card-title">
                    <span class="store-settings-icon"><i class="fa-solid fa-store"></i></span>
                    <div>
                        <span>Identidade</span>
                        <h2>Dados da loja</h2>
                    </div>
                </div>
            </div>

            <div class="store-settings-grid two">
                <div class="store-field">
                    <label asp-for="Nome">Nome do estabelecimento</label>
                    <input asp-for="Nome" />
                    <span asp-validation-for="Nome"></span>
                </div>

                <div class="store-field">
                    <label>Logo da loja</label>
                    <input type="file" name="logoFile" accept=".png,.jpg,.jpeg,.webp" />
                    <span asp-validation-for="LogoPath"></span>

                    @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                    {
                        <div class="store-logo-current">
                            <img src="@Model.LogoPath" alt="Logo atual" />
                            <small>@Model.LogoPath</small>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="store-settings-card">
            <div class="store-settings-card-head">
                <div class="store-settings-card-title">
                    <span class="store-settings-icon"><i class="fa-regular fa-clock"></i></span>
                    <div>
                        <span>Funcionamento</span>
                        <h2>Horários e status</h2>
                    </div>
                </div>
            </div>

            <div class="store-settings-grid hours">
                <div class="store-field">
                    <label>Abre às</label>
                    <input asp-for="HorarioAbertura" type="time" />
                    <span asp-validation-for="HorarioAbertura"></span>
                </div>

                <div class="store-field">
                    <label>Fecha às</label>
                    <input asp-for="HorarioFechamento" type="time" />
                    <small>Suporta virar o dia, como 18:00 até 02:00.</small>
                    <span asp-validation-for="HorarioFechamento"></span>
                </div>

                <div class="store-days">
                    <label>Dias abertos</label>
                    <div class="store-days-list">
                        @foreach (DiasSemanaFlags d in Enum.GetValues(typeof(DiasSemanaFlags)))
                        {
                            if (d == DiasSemanaFlags.Nenhum || d == DiasSemanaFlags.Todos) { continue; }

                            <label class="store-check-pill">
                                <input type="checkbox"
                                       name="DiasAbertosSelecionados"
                                       value="@((int)d)"
                                       checked="@(Model.DiasAbertos.HasFlag(d))" />
                                <span>@d</span>
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="store-settings-grid two compact">
                <label class="store-toggle-row">
                    <input asp-for="Ativo" />
                    <span>
                        <strong>Loja ativa</strong>
                        <small>A loja pode receber pedidos.</small>
                    </span>
                </label>

                <label class="store-toggle-row">
                    <input asp-for="ForcarFechado" />
                    <span>
                        <strong>Forçar fechado</strong>
                        <small>Use quando precisar pausar vendas.</small>
                    </span>
                </label>
            </div>

            <div class="store-field">
                <label asp-for="MensagemStatus">Mensagem de status</label>
                <input asp-for="MensagemStatus" placeholder="Ex.: Voltamos às 19h" />
                <span asp-validation-for="MensagemStatus"></span>
            </div>
        </section>

        <section class="store-settings-card">
            <div class="store-settings-card-head">
                <div class="store-settings-card-title">
                    <span class="store-settings-icon"><i class="fa-solid fa-location-dot"></i></span>
                    <div>
                        <span>Endereço</span>
                        <h2>Endereço da loja</h2>
                    </div>
                </div>
            </div>

            <div class="store-settings-grid address">
                <div class="store-field wide">
                    <label asp-for="Logradouro">Logradouro</label>
                    <input asp-for="Logradouro" />
                    <span asp-validation-for="Logradouro"></span>
                </div>

                <div class="store-field">
                    <label asp-for="Numero">Número</label>
                    <input asp-for="Numero" />
                    <span asp-validation-for="Numero"></span>
                </div>

                <div class="store-field">
                    <label asp-for="Complemento">Complemento</label>
                    <input asp-for="Complemento" />
                    <span asp-validation-for="Complemento"></span>
                </div>

                <div class="store-field">
                    <label asp-for="Bairro">Bairro</label>
                    <input asp-for="Bairro" />
                    <span asp-validation-for="Bairro"></span>
                </div>

                <div class="store-field">
                    <label asp-for="Cidade">Cidade</label>
                    <input asp-for="Cidade" />
                    <span asp-validation-for="Cidade"></span>
                </div>

                <div class="store-field uf">
                    <label asp-for="Estado">UF</label>
                    <input asp-for="Estado" maxlength="2" />
                    <span asp-validation-for="Estado"></span>
                </div>

                <div class="store-field">
                    <label asp-for="Cep">CEP</label>
                    <input asp-for="Cep" placeholder="00000-000" />
                    <span asp-validation-for="Cep"></span>
                </div>
            </div>
        </section>

        <section class="store-settings-card">
            <div class="store-settings-card-head">
                <div class="store-settings-card-title">
                    <span class="store-settings-icon"><i class="fa-solid fa-map-location-dot"></i></span>
                    <div>
                        <span>Mapa</span>
                        <h2>Google Maps</h2>
                    </div>
                </div>
            </div>

            <div class="store-settings-grid map">
                <div class="store-field">
                    <label asp-for="Latitude">Latitude</label>
                    <input asp-for="Latitude" step="any" />
                    <span asp-validation-for="Latitude"></span>
                </div>

                <div class="store-field">
                    <label asp-for="Longitude">Longitude</label>
                    <input asp-for="Longitude" step="any" />
                    <span asp-validation-for="Longitude"></span>
                </div>

                <div class="store-field wide">
                    <label asp-for="MapsPlaceUrl">URL do Google Maps</label>
                    <input asp-for="MapsPlaceUrl" placeholder="Cole a URL do place se já tiver" />
                    <small>Latitude e longitude têm prioridade. Se não preencher, o sistema monta a rota pelo endereço.</small>
                    <span asp-validation-for="MapsPlaceUrl"></span>
                </div>
            </div>

            <div class="store-map-preview">
                <div>
                    <small>Endereço completo</small>
                    <strong id="enderecoPreview">@Model.EnderecoTexto</strong>
                </div>

                <div class="store-map-url">
                    <input id="mapsUrlPreview" readonly value="@Model.MapsUrl" />
                    <a id="btnAbrirMaps" href="@Model.MapsUrl" target="_blank" rel="noopener" class="store-settings-btn store-settings-btn-light">
                        <i class="fa-solid fa-route"></i>
                        Abrir
                    </a>
                    <button type="button" id="btnCopyMaps" class="store-settings-btn store-settings-btn-light" title="Copiar URL">
                        <i class="fa-regular fa-copy"></i>
                    </button>
                </div>
            </div>
        </section>

        <div class="store-settings-actions">
            <button type="submit" class="store-settings-btn store-settings-btn-primary">
                <i class="fa-solid fa-save"></i>
                Salvar configurações
            </button>

            <a asp-area="PainelLojista" asp-controller="Dashboard" asp-action="Index" class="store-settings-btn store-settings-btn-light">
                Cancelar
            </a>
        </div>
    </form>

    @if (isAdmin)
    {
        <form asp-action="LimparDuplicatas" method="post" class="store-settings-admin-action">
            @Html.AntiForgeryToken()
            <button class="store-settings-btn store-settings-btn-danger" onclick="return confirm('Tem certeza?');">
                <i class="fa-solid fa-broom"></i>
                Limpar duplicatas
            </button>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const qs = (selector) => document.querySelector(selector);

            function montaEndereco() {
                const log = qs('#Logradouro')?.value?.trim() || '';
                const num = qs('#Numero')?.value?.trim() || '';
                const comp = qs('#Complemento')?.value?.trim() || '';
                const bai = qs('#Bairro')?.value?.trim() || '';
                const cid = qs('#Cidade')?.value?.trim() || '';
                const uf = (qs('#Estado')?.value || '').trim().toUpperCase();
                const cep = qs('#Cep')?.value?.trim() || '';
                const rua = log && num ? `${log}, ${num}` : (log || num);
                const cidadeUf = cid && uf ? `${cid}/${uf}` : (cid || uf);
                const local = bai && cidadeUf ? `${bai} - ${cidadeUf}` : (bai || cidadeUf);

                return [rua, comp, local, cep].filter(Boolean).join(', ');
            }

            function montaMapsUrl() {
                const lat = parseFloat(qs('#Latitude')?.value);
                const lng = parseFloat(qs('#Longitude')?.value);
                const placeUrl = qs('#MapsPlaceUrl')?.value?.trim();

                if (!Number.isNaN(lat) && !Number.isNaN(lng)) {
                    return `https://www.google.com/maps/dir/?api=1&destination=${lat}%2C${lng}`;
                }

                if (placeUrl) return placeUrl;

                return `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(montaEndereco())}`;
            }

            function atualizarPreview() {
                const endereco = montaEndereco();
                const url = montaMapsUrl();
                const enderecoPreview = qs('#enderecoPreview');
                const mapsUrlPreview = qs('#mapsUrlPreview');
                const btnAbrirMaps = qs('#btnAbrirMaps');

                if (enderecoPreview) enderecoPreview.textContent = endereco || 'Endereço não informado';
                if (mapsUrlPreview) mapsUrlPreview.value = url;
                if (btnAbrirMaps) btnAbrirMaps.href = url;
            }

            ['#Logradouro', '#Numero', '#Complemento', '#Bairro', '#Cidade', '#Estado', '#Cep', '#Latitude', '#Longitude', '#MapsPlaceUrl']
                .forEach(selector => qs(selector)?.addEventListener('input', atualizarPreview));

            qs('#Cep')?.addEventListener('input', (event) => {
                let value = event.target.value.replace(/\D/g, '').slice(0, 8);
                if (value.length > 5) value = `${value.slice(0, 5)}-${value.slice(5)}`;
                event.target.value = value;
            });

            qs('#Estado')?.addEventListener('input', (event) => {
                event.target.value = event.target.value.replace(/[^A-Za-z]/g, '').slice(0, 2).toUpperCase();
            });

            qs('#btnCopyMaps')?.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(qs('#mapsUrlPreview')?.value || '');
                } catch {
                }
            });

            atualizarPreview();
        });
    </script>
}
