@model IEnumerable<WebApplicationPods.Models.LojaModel>
@inject WebApplicationPods.Services.Interface.IStoreUrlBuilder StoreUrlBuilder

@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Lojas";

    var painelUrl = StoreUrlBuilder.BuildPainelUrl();
    var adminUrl = StoreUrlBuilder.BuildAdminUrl();
}

<div class="admin-page-header">
    <h1>Lojas</h1>
    <p>Gerencie as lojas da plataforma</p>
</div>

<div class="mb-3 d-flex gap-2 flex-wrap">
    <a asp-area="Admin"
       asp-controller="Lojas"
       asp-action="Create"
       class="btn btn-primary">
        <i class="fa fa-plus"></i> Nova loja
    </a>

    <a href="@painelUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary">
        Abrir painel
    </a>

    <a href="@adminUrl" target="_blank" rel="noopener" class="btn btn-outline-secondary">
        Abrir admin
    </a>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success">@TempData["Sucesso"]</div>
}
@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger">@TempData["Erro"]</div>
}

<div class="card admin-card p-3">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Subdomínio</th>
                <th>Link da loja</th>
                <th>Plano</th>
                <th>Dono / Lojista</th>
                <th>Ativa</th>
                <th>Criada em</th>
                <th style="width: 130px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loja in Model)
            {
                var publicUrl = StoreUrlBuilder.BuildPublicStoreUrl(loja.Subdominio);

                <tr>
                    <td>@loja.Nome</td>
                    <td>
                        <code>@loja.Subdominio</code>
                    </td>
                    <td>
                        <div class="d-flex flex-column gap-1">
                            <a href="@publicUrl" target="_blank" rel="noopener">
                                @publicUrl
                            </a>
                            <small class="text-muted">Link que o cliente usa para comprar nessa loja.</small>
                        </div>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(loja.Plano) ? "-" : loja.Plano)</td>
                    <td>
                        @if (loja.Dono != null)
                        {
                            @loja.Dono.Nome
                        }
                        else
                        {
                            <span class="text-muted">Sem dono</span>
                        }
                    </td>
                    <td>
                        @if (loja.Ativa)
                        {
                            <span class="badge bg-success">Ativa</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inativa</span>
                        }
                    </td>
                    <td>@loja.CriadaEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <a asp-area="Admin"
                           asp-controller="Lojas"
                           asp-action="Edit"
                           asp-route-id="@loja.Id"
                           class="btn btn-sm btn-outline-primary">
                            <i class="fa fa-edit"></i>
                        </a>

                        <form asp-area="Admin"
                              asp-controller="Lojas"
                              asp-action="Delete"
                              asp-route-id="@loja.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Confirma excluir esta loja? Esta ação não pode ser desfeita.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fa fa-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>